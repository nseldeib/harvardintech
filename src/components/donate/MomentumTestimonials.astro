---
// Member quotes on the campaign page.
//
// Production starts with NO testimonials, so this renders nothing at all — not
// an empty heading — until real quotes are collected. That keeps the page
// reading as finished rather than half-built while the team gathers them.
import TestimonialCard from './TestimonialCard.astro';
import { sortByOrder } from '../../lib/order';

export interface TestimonialLike {
  slug?: string;
  quote: string;
  name: string;
  role?: string;
  affiliation?: string;
  photo?: string;
  eventPhoto?: string;
  eventCaption?: string;
  order?: number;
}

interface Props {
  kicker?: string;
  title?: string;
  testimonials?: TestimonialLike[];
}
const { kicker, title = 'From our community', testimonials = [] } = Astro.props as Props;
const quotes = sortByOrder(testimonials);
---

{
  quotes.length > 0 ? (
    <section class="quotes">
      <div class="inner">
        <div class="head">
          {kicker ? <p class="kick kick--teal">{kicker}</p> : null}
          <h2>{title}</h2>
          {/* The lede, written in the section entry's markdown body. Slotted
              rather than a prop because it is prose an editor formats. */}
          <div class="lede">
            <slot />
          </div>
        </div>
        <div class="rows">
          {/* Sides alternate by SORTED position, so the ordering rule an editor
              already controls is what drives the layout — no second field to
              keep in step with the first. */}
          {quotes.map((t, index) => (
            <TestimonialCard
              quote={t.quote}
              name={t.name}
              role={t.role}
              affiliation={t.affiliation}
              photo={t.photo}
              eventPhoto={t.eventPhoto}
              eventCaption={t.eventCaption}
              flipped={index % 2 === 1}
            />
          ))}
        </div>
      </div>
    </section>
  ) : null
}

<style>
  .quotes {
    background: var(--momentum-aqua);
    padding: 86px 24px;
  }
  .inner {
    max-width: 1120px;
    margin: 0 auto;
  }
  .head {
    margin-bottom: 56px;
    max-width: 760px;
  }
  .head .kick {
    margin: 0 0 14px;
  }
  h2 {
    font-family: var(--font-title);
    font-size: clamp(32px, 4.2vw, 56px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    font-weight: 700;
    color: var(--momentum-navy);
    margin: 0;
  }
  /* The lede arrives through the slot as rendered markdown, so it is reached by
     descendant selectors and needs `:global`. Empty when the entry has no body,
     in which case it contributes nothing but its own zero height. */
  .lede :global(p) {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.6;
    color: var(--momentum-navy);
    margin: 22px 0 0;
  }
  /* Full-width rows rather than a card grid — the design gives each quote a
     photo and the room to carry it. */
  .rows {
    display: grid;
    gap: 56px;
  }
</style>
