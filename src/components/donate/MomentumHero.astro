---
// Momentum Fund hero: a full-bleed event photo, the personalized headline, the
// supporting line, and the giving CTA.
//
// PERSONALIZATION lives here rather than in the page so the headline element
// and the script that fills it stay in one file. The site is statically built,
// so the headline ships in its GENERIC form and is upgraded in the browser when
// the visitor arrived from the email with `?name=`. Generic-first (rather than
// blank) means the majority with no name in the link see no flash, and a
// visitor with JS disabled still gets a complete headline.
//
// THE OPTIONAL VIDEO is a backdrop, not a player: muted, looping, controlless,
// `aria-hidden`, with the headline and Give button unchanged on top of it. A
// hero that became a player would push the campaign's one call to action below
// the fold and put a sound control in front of it.
//
// `image` does not step aside when `video` is set. It stays as the section's
// CSS background AND becomes the video's poster, which is what makes every
// failure path land on the current page rather than a black rectangle: a video
// that 404s, a browser that refuses to autoplay, and a visitor on
// `prefers-reduced-motion` all reveal the photo, and none of those three needs
// any JavaScript to do it.
import { withBase } from '../../lib/url';
import GiveButton from './GiveButton.astro';

interface Props {
  /** The uppercase eyebrow above the headline, naming the campaign. */
  kicker?: string;
  /** Contains a `{name}` placeholder, filled client-side. */
  headlineNamed: string;
  headlineGeneric: string;
  subhead?: string;
  image?: string;
  /** Optional moving backdrop — a path under `public/videos/`. Blank renders
   *  today's photo hero. `image` remains its poster and its fallback. */
  video?: string;
  ctaLabel?: string;
  donateUrl?: string;
  email: string;
  campaignName?: string;
  /** Scenario hook: pin the personalized headline server-side so the state is
   *  capturable in a screenshot (the live page fills it in the browser). */
  previewName?: string;
}
const {
  kicker,
  headlineNamed,
  headlineGeneric,
  subhead,
  image,
  video,
  ctaLabel,
  donateUrl,
  email,
  campaignName,
  previewName,
} = Astro.props as Props;

const initialHeadline =
  previewName && headlineNamed.includes('{name}')
    ? headlineNamed.replace(/\{name\}/g, previewName)
    : headlineGeneric;

const heroImage = image ? withBase(image) : null;
// Through the same `withBase` as the photo, so the src survives the project
// subpath the GitHub Pages deploy is served under.
const heroVideo = video ? withBase(video) : null;
---

<section class="hero" style={heroImage ? `--hero-img:url('${heroImage}')` : undefined}>
  {
    heroVideo ? (
      <video
        class="hero-video"
        src={heroVideo}
        poster={heroImage ?? undefined}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      />
    ) : null
  }
  <div class="hero-in">
    {kicker ? <p class="kick kick--light">{kicker}</p> : null}
    <h1
      class="headline"
      data-named={headlineNamed}
      data-generic={headlineGeneric}
      data-preview={previewName ? 'true' : undefined}
    >
      {initialHeadline}
    </h1>
    {subhead ? <p class="sub">{subhead}</p> : null}
    <GiveButton label={ctaLabel} donateUrl={donateUrl} email={email} campaignName={campaignName} />
  </div>
</section>

<script>
  // Upgrade the generic headline to the personalized one when the visitor
  // arrived from the email campaign with `?name=`. `sanitizeFirstName` inside
  // heroGreeting rejects anything that isn't plausibly a first name, and the
  // value is written with textContent (never innerHTML), so a hostile `?name=`
  // degrades to the generic headline instead of injecting markup.
  import { heroGreeting, nameFromSearch } from '../../lib/personalize';

  const el = document.querySelector<HTMLElement>('.headline[data-named]');
  // `data-preview` means a scenario pinned the headline server-side; leave it.
  if (el && el.dataset.preview !== 'true') {
    el.textContent = heroGreeting(
      el.dataset.named ?? '',
      el.dataset.generic ?? '',
      nameFromSearch(window.location.search),
    );
  }
</script>

<style>
  .hero {
    position: relative;
    background-color: var(--momentum-navy);
    background-image: var(--hero-img);
    background-size: cover;
    background-position: center;
    /* Tall enough for the campaign design's proportions, and the content is
       bottom-aligned within it so the headline sits on the photo rather than
       floating in the middle of it. */
    min-height: 680px;
    display: flex;
    align-items: flex-end;
    padding: 120px 24px 104px;
  }
  /* The video covers the photo rather than replacing it: the background image
     above is still painted underneath, so a src that 404s or a browser that
     declines to autoplay simply shows the photo, with no gap and no black band.
     `z-index: 0` puts it under the scrim — tree order alone would not, because
     `::before` is generated before it. */
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  /* Scrim: the headline sits over a photo of a crowded room, so it needs a
     guaranteed contrast floor regardless of which photo is used — and the same
     floor over an arbitrary FRAME of an arbitrary video, which is why the video
     goes beneath it rather than above. `z-index: 1` keeps it under the content
     and over the video, so every fallback path (a 404, blocked autoplay,
     reduced motion) is unaffected by the change of colour and direction.
     Left-to-right navy now rather than a flat two-stop wash: the copy is
     left-aligned, so the density belongs on the side the words are, and the
     bottom lift keeps the button legible where the photo is brightest. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(3, 26, 54, 0) 45%, rgba(3, 26, 54, 0.75) 100%),
      linear-gradient(90deg, rgba(3, 26, 54, 0.92) 0%, rgba(3, 26, 54, 0.72) 45%, rgba(3, 26, 54, 0.28) 100%);
    z-index: 1;
  }
  /* Left-aligned in a bounded column rather than centred in a 900px block: the
     campaign design runs the copy down the left of the photo. `68%` keeps the
     measure from stretching on a wide monitor while `760px` caps it outright. */
  .hero-in {
    position: relative;
    width: min(760px, 68%);
    margin: 0;
    z-index: 2;
  }
  .hero-in .kick {
    margin: 0 0 18px;
  }
  /* Reduced motion: hide the video entirely, revealing the background photo
     that was underneath it all along. A media query rather than a script, so it
     holds on a static page with JavaScript disabled. */
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
  }
  /* The campaign design's serif headline, at its scale. Departs from the
     homepage hero's 800-weight sans deliberately — this page's whole type
     register is the serif sentence-heading. */
  .headline {
    font-family: var(--font-title);
    font-size: clamp(40px, 6vw, 78px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: #fff;
    margin: 0 0 22px;
  }
  .sub {
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
    max-width: 52ch;
    margin: 0 0 34px;
  }

  /* On a phone the 68% column leaves the headline in a sliver, and the
     left-to-right gradient has no width to travel across — so the copy takes the
     full width and the scrim becomes a straight top-to-bottom wash. */
  @media (max-width: 820px) {
    .hero {
      min-height: 540px;
      padding: 96px 24px 72px;
    }
    .hero-in {
      width: 100%;
    }
    .hero::before {
      background: linear-gradient(180deg, rgba(3, 26, 54, 0.7), rgba(3, 26, 54, 0.88));
    }
  }
</style>
