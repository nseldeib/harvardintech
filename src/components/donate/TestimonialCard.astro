---
// One member quote, laid out as a full-width row: the event photo on one side,
// the quote and its attribution on the other.
//
// Quotation marks are added by CSS so an editor can type the quote plainly in
// the CMS without doubling them up.
//
// TWO PHOTOS, TWO JOBS. `photo` is the member's own portrait — a small round
// image in the cite block, beside their name. `eventPhoto` is a picture of the
// event the quote came out of, filling the row's other column. Either can be
// absent and the card still reads: with no `eventPhoto` the quote takes the full
// width, and with no `photo` the cite block is name-and-role alone. That second
// case is not a placeholder state to be filled in later — a real person's
// attributed quote is better with no face than with someone else's.
import { altFor } from '../../lib/media';
import { withBase } from '../../lib/url';

interface Props {
  quote: string;
  name: string;
  role?: string;
  /** The member's connection to Harvard, above the role. A different fact from
   *  what they do for the community, which is why it is its own line. */
  affiliation?: string;
  photo?: string;
  eventPhoto?: string;
  eventCaption?: string;
  /** Puts the photo column on the right instead of the left. Set by the band
   *  from the quote's sorted position, so successive rows alternate. */
  flipped?: boolean;
}
const { quote, name, role, affiliation, photo, eventPhoto, eventCaption, flipped = false } =
  Astro.props as Props;
---

<div class:list={['row', { flipped, solo: !eventPhoto }]}>
  {
    eventPhoto ? (
      <figure class="event">
        <img src={withBase(eventPhoto)} alt={altFor(eventPhoto, name)} loading="lazy" />
        {eventCaption ? <figcaption>{eventCaption}</figcaption> : null}
      </figure>
    ) : null
  }
  <figure class="q">
    <blockquote>{quote}</blockquote>
    <figcaption>
      {photo ? <img class="photo" src={withBase(photo)} alt="" loading="lazy" /> : null}
      <span class="who">
        <strong>{name}</strong>
        {affiliation ? <span class="aff">{affiliation}</span> : null}
        {role ? <span class="role">{role}</span> : null}
      </span>
    </figcaption>
  </figure>
</div>

<style>
  .row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 44px;
    align-items: center;
  }
  /* No event photo means no photo column to balance against, so the quote runs
     the full width rather than sitting in half a row beside empty space. */
  .row.solo {
    grid-template-columns: 1fr;
  }
  /* Source order is photo-then-quote, so `flipped` only has to move the figure
     to the second column on wide screens. */
  .row.flipped .event {
    order: 2;
  }

  .event {
    margin: 0;
    min-width: 0;
  }
  .event img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 380px;
    object-fit: cover;
  }
  /* A navy caption bar sitting flush under the photo, not floating text. */
  .event figcaption {
    background: var(--momentum-navy);
    color: rgba(255, 255, 255, 0.88);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 12px 16px;
  }

  /* No card chrome — the quote stands on the band with a crimson rule over it,
     which is what the campaign design uses in place of a bordered box. */
  .q {
    margin: 0;
    border-top: 2px solid var(--crimson);
    padding-top: 26px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  blockquote {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.55;
    color: var(--momentum-navy);
    margin: 0;
  }
  blockquote::before {
    content: '“';
    color: var(--crimson);
  }
  blockquote::after {
    content: '”';
    color: var(--crimson);
  }
  .q figcaption {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .photo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--momentum-gold);
    flex-shrink: 0;
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--momentum-navy);
  }
  .who strong {
    font-size: 13px;
    letter-spacing: 0.08em;
  }
  .aff,
  .role {
    color: var(--ink-2);
  }

  /* One column below 820px, photo first — the reading order the row implies on a
     phone, where "left" and "right" have no meaning. */
  @media (max-width: 820px) {
    .row,
    .row.flipped {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .row.flipped .event {
      order: 0;
    }
    .event img {
      max-height: 260px;
    }
  }
</style>
