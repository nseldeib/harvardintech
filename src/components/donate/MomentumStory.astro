---
// "And Every Number Represents a Story" — the narrative section that follows
// the stats band and turns the figures into the case for giving.
interface Props {
  title?: string;
  lede?: string;
  pullQuote?: string;
  paragraphs?: string[];
}
const { title, lede, pullQuote, paragraphs = [] } = Astro.props as Props;
const hasContent = Boolean(title || lede || pullQuote || paragraphs.length > 0);
---

{
  hasContent ? (
    <section class="story">
      <div class="narrow">
        {title ? <h2>{title}</h2> : null}
        {lede ? <p class="lede">{lede}</p> : null}
        {pullQuote ? <p class="pull">{pullQuote}</p> : null}
        {paragraphs.map((p) => (
          <p class="p">{p}</p>
        ))}
      </div>
    </section>
  ) : null
}

<style>
  .story {
    padding: 76px 24px;
  }
  .narrow {
    max-width: 68ch;
    margin: 0 auto;
  }
  h2 {
    font-size: clamp(26px, 3.4vw, 40px);
    font-weight: 800;
    letter-spacing: -0.025em;
    margin: 0 0 24px;
  }
  .lede {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0 0 32px;
  }
  .pull {
    font-family: var(--font-serif);
    font-size: clamp(21px, 2.4vw, 28px);
    line-height: 1.4;
    color: var(--ink);
    border-left: 3px solid var(--crimson);
    padding-left: 24px;
    margin: 0 0 28px;
  }
  .p {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-2);
    margin: 0 0 18px;
  }
  .p:last-child {
    margin-bottom: 0;
  }
</style>
