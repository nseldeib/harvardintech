---
// The campaign's pill-shaped giving CTA, per the Momentum Fund mockup.
//
// Its own component because the page renders it twice — in the hero and in the
// closing band — and both must resolve the same destination. `resolveGiveHref`
// centralises that: a real donation platform when `donateUrl` is set in the
// CMS, a giving-inquiry mailto until then.
import { resolveGiveHref } from '../../lib/giving';

interface Props {
  label?: string;
  donateUrl?: string;
  email: string;
  campaignName?: string;
  /** `light` inverts to a white button for use on the crimson/ink bands. */
  variant?: 'crimson' | 'light';
}
const {
  label = 'Make a Gift',
  donateUrl,
  email,
  campaignName,
  variant = 'crimson',
} = Astro.props as Props;

const href = resolveGiveHref({ donateUrl, email, campaignName });
---

<a class:list={['give', variant === 'light' && 'give--light']} href={href} rel="noopener">
  {label}
</a>

<style>
  .give {
    display: inline-block;
    background: var(--crimson);
    color: #fff;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
    padding: 18px 42px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .give:hover {
    background: var(--crimson-deep);
    text-decoration: none;
    transform: translateY(-1px);
  }
  .give--light {
    background: #fff;
    color: var(--crimson);
  }
  .give--light:hover {
    background: rgba(255, 255, 255, 0.9);
  }
</style>
