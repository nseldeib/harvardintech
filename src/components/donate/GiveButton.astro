---
// The campaign's pill-shaped giving CTA, per the Momentum Fund mockup.
//
// Its own component because the page renders it twice — in the hero and in the
// closing band — and both must resolve the same destination. `resolveGiveHref`
// centralises that: a real donation platform when `donateUrl` is set in the
// CMS, a giving-inquiry mailto until then.
import { resolveGiveHref, resolveGiveCtaHref } from '../../lib/giving';
import { withBase } from '../../lib/url';

interface Props {
  label?: string;
  donateUrl?: string;
  email: string;
  campaignName?: string;
  /** `light` inverts to a white button for use on the crimson/ink bands.
   *  `navy` is the campaign page's closing button, which sits on a PALE band
   *  where both the crimson and the white variant lose their footing. */
  variant?: 'crimson' | 'light' | 'navy';
  /** Appends the campaign design's ↗ glyph. Decorative and `aria-hidden`, so
   *  the link still reads as its label alone to a screen reader. */
  glyph?: boolean;
  /** This is the button that COMPLETES a gift, not one that leads toward it.
   *  Only the giving page sets it — see the href note below. */
  checkout?: boolean;
}
const {
  label = 'Make a Gift',
  donateUrl,
  email,
  campaignName,
  variant = 'crimson',
  glyph = false,
  checkout = false,
} = Astro.props as Props;

// Two destinations, and which one this button wants is the `checkout` prop.
//
// The default is the giving PAGE: a campaign CTA should land somewhere that
// states the goal and the amounts before asking for anything. `checkout` is the
// button on that page — the one that actually leaves for the platform, or opens
// the inquiry email until a platform exists. See `resolveGiveCtaHref`.
//
// `withBase` is applied here rather than inside the resolver because the
// resolver also returns absolute platform URLs and `mailto:` — neither of which
// may be prefixed. `withBase` ignores anything not starting with `/`, so this is
// safe for all three, but the reason it is safe is worth stating.
const href = checkout
  ? resolveGiveHref({ donateUrl, email, campaignName })
  : withBase(resolveGiveCtaHref({ donateUrl }));
---

<a
  class:list={['give', variant === 'light' && 'give--light', variant === 'navy' && 'give--navy']}
  href={href}
  rel="noopener"
>
  {label}{glyph ? <span class="glyph" aria-hidden="true">↗</span> : null}
</a>

<style>
  .give {
    display: inline-block;
    background: var(--crimson);
    color: #fff;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
    padding: 18px 42px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .give:hover {
    background: var(--crimson-deep);
    text-decoration: none;
    transform: translateY(-1px);
  }
  .give--light {
    background: #fff;
    color: var(--crimson);
  }
  .give--light:hover {
    background: rgba(255, 255, 255, 0.9);
  }
  .give--navy {
    background: var(--momentum-navy);
    color: #fff;
  }
  .give--navy:hover {
    background: var(--momentum-navy-2);
  }
  .glyph {
    margin-left: 10px;
  }
</style>
