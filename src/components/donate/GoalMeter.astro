---
// The live fundraising progress band on the Momentum Fund page.
//
// A thin frame around Givebutter's own widget: the heading is ours, the meter
// inside is theirs, rendered by the loader script `GivebutterWidgets.astro` puts
// in every page's <head>. Styled to match `MomentumStats.astro` — the same
// paper-2 band, the same section rhythm — so progress reads as part of the
// campaign page rather than a pasted-in third-party box.
//
// THE BAND SHIPS HIDDEN AND REVEALS ITSELF. The meter is third-party JavaScript
// from a CDN, so it does not render for a no-JS visitor, when the CDN is blocked,
// or inside a screenshot capture. Rather than leave a heading stranded over an
// empty progress area in those cases, the band collapses entirely and the page
// reads exactly as it would with no meter at all — the same end state as a
// section with no widget id.
//
// The reveal waits on `customElements.whenDefined`, not a timer. That is a real
// "did Givebutter's code arrive" test: it resolves only once the loader script
// has run and defined the element, so a slow CDN still shows the meter whenever
// it lands instead of a fixed window silently swallowing it. It is also
// independent of layout, which matters because a `display: none` band gives its
// children no box to measure — a height-based check could never un-hide itself.
//
// Once the element is defined the band is revealed and the widget owns what it
// draws inside, including its own empty and error states. That is the right
// boundary: past that point the question is Givebutter's to answer, not ours.
import { campaignLink } from '../../lib/momentumSections';

interface Props {
  kicker?: string;
  title?: string;
  /** The Givebutter widget id. Blank renders NOTHING — not an empty band and not
   *  a placeholder — so a half-finished edit costs one missing section rather
   *  than a broken-looking page. `/donate` logs an advisory naming the section. */
  widgetId?: string;
  /** The optional link out to the campaign itself, drawn beside the heading.
   *  Both halves are required to draw it — a label with no destination would be
   *  a link that goes nowhere, which is worse than no link. */
  linkLabel?: string;
  linkUrl?: string;
  /** Amount raised and the target, as free text — "$47,500", "$100,000".
   *
   *  Free text for the same reason `amount` is on a gift pillar: these are
   *  editorial figures, and forcing a number means forcing a currency and a
   *  formatter. `percent` is the one number, because a bar has to be drawn to a
   *  width and a string cannot be.
   *
   *  THE COST, stated plainly: a figure typed here is a figure somebody has to
   *  keep current. The Givebutter widget exists precisely so the amount updates
   *  itself, and this band's note used to say "there is no figure here for
   *  anyone to keep up to date" — that stops being true the moment these are
   *  filled in. They are here because the widget draws nothing until a campaign
   *  is configured, which left the band invisible; a stale figure on a donation
   *  page is a real harm, so `widgetId` still WINS when both are present. */
  raised?: string;
  goal?: string;
  /** How full the bar is drawn, 0–100. Clamped, so a typo cannot overflow it. */
  percent?: number;
}
const { kicker, title, widgetId, linkLabel, linkUrl, raised, goal, percent } =
  Astro.props as Props;

const id = widgetId?.trim();
const link = campaignLink({ linkLabel, linkUrl });

// The static bar is the FALLBACK, not the default. A configured Givebutter
// widget reports the real total and keeps reporting it, so wherever one exists
// it wins outright — showing both would put a hand-typed figure beside a live
// one and invite them to disagree in public.
const hasFigures = Boolean(raised?.trim() || goal?.trim());
const showStatic = !id && hasFigures;
const pct = Math.max(0, Math.min(100, percent ?? 0));
---

{
  showStatic ? (
    <section class="goal-meter">
      <div class="gm-head">
        <div class="gm-title">
          {kicker ? <p class="kick kick--gold">{kicker}</p> : null}
          {title ? <h2>{title}</h2> : null}
        </div>
        {link ? (
          <a class="gm-link" href={link.url}>
            {link.label} <span aria-hidden="true">→</span>
          </a>
        ) : null}
      </div>

      <div class="gm-static">
        <div class="gm-figures">
          {raised ? (
            <p class="gm-raised">
              <span class="gm-raised-value">{raised}</span>
              <span class="gm-raised-label">raised</span>
            </p>
          ) : null}
          {goal ? <p class="gm-goal">of {goal} goal</p> : null}
        </div>

        {/* `role="img"` with a composed label rather than a progressbar role:
            this is a static picture of a number, not a live-updating control,
            and announcing it as a progressbar would imply it changes. */}
        <div
          class="gm-bar"
          role="img"
          aria-label={`${pct}% of the ${goal ?? 'campaign'} goal raised`}
        >
          <div class="gm-bar-fill" style={`width: ${pct}%`} />
        </div>

        <p class="gm-percent">{pct}% of goal</p>
      </div>
    </section>
  ) : null
}

{
  id ? (
    <section class="goal-meter is-collapsed" data-goal-meter>
      <div class="gm-head">
        <div class="gm-title">
          {kicker ? <p class="kick kick--gold">{kicker}</p> : null}
          {title ? <h2>{title}</h2> : null}
        </div>
        {link ? (
          <a class="gm-link" href={link.url}>
            {link.label} <span aria-hidden="true">→</span>
          </a>
        ) : null}
      </div>
      <div class="meter">
        {/* Written open/close rather than self-closing: a custom element is not
            a void element, and a self-closing tag would be parsed as an open one. */}
        <givebutter-widget id={id}></givebutter-widget>
      </div>
    </section>
  ) : null
}

{
  id ? (
    <script is:inline>
      {`(function () {
  if (window.__goalMeterReveal) return;
  window.__goalMeterReveal = true;
  if (!window.customElements) return;
  customElements.whenDefined('givebutter-widget').then(function () {
    document
      .querySelectorAll('[data-goal-meter]')
      .forEach(function (band) { band.classList.remove('is-collapsed'); });
  });
})();`}
    </script>
  ) : null
}

<style>
  /* Navy with a soft gold lift behind the meter — the campaign design's chrome
     for this band. Left-aligned now rather than centred, so the heading and the
     campaign link share one row the way the design draws them. */
  .goal-meter {
    background: var(--momentum-navy-2);
    background-image: radial-gradient(
      ellipse at 50% 120%,
      rgba(246, 199, 104, 0.18),
      transparent 62%
    );
    padding: 78px 24px;
  }
  .gm-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    max-width: 900px;
    margin: 0 auto 36px;
  }
  .gm-title {
    min-width: 0;
  }
  .gm-title .kick {
    margin: 0 0 14px;
  }
  .gm-link {
    flex: none;
    font-size: 13px;
    font-weight: 700;
    color: var(--momentum-gold);
    text-decoration: underline;
    text-underline-offset: 4px;
    padding-bottom: 6px;
  }
  .gm-link:hover {
    color: #fff;
  }

  /* The static bar. Drawn only when no Givebutter widget is configured — see
     the `showStatic` note in the frontmatter for why the two never co-exist. */
  /* Same 900px column and centring as `.gm-head`, so the bar sits under the
     heading rather than running the full width of the band while the words
     above it stay in the column. */
  .gm-static {
    max-width: 900px;
    margin: 34px auto 0;
  }

  .gm-figures {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 14px;
    margin-bottom: 18px;
  }

  .gm-raised {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .gm-raised-value {
    font-family: var(--font-title);
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--momentum-gold);
  }

  .gm-raised-label,
  .gm-goal {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.66);
  }

  .gm-bar {
    height: 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    overflow: hidden;
  }

  /* Gold on navy, the same pairing the raised figure uses, so the bar reads as
     the figure drawn out rather than as separate furniture. `min-width` keeps a
     just-opened campaign from rendering a fill of literally zero pixels, which
     looks like a broken bar rather than an honest start. */
  .gm-bar-fill {
    height: 100%;
    min-width: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--momentum-teal), var(--momentum-gold));
  }

  .gm-percent {
    margin: 14px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--momentum-gold);
  }
  /* The collapse. A class rather than the `hidden` attribute: `hidden` is
     stronger than it looks — tooling that walks the DOM treats the attribute
     itself as "not rendered" and skips the subtree whatever the cascade says,
     which makes the band unreviewable in isolation even when a harness page
     deliberately shows it. `display: none` keeps it out of the a11y tree either
     way, which is the part that actually has to hold for a no-JS visitor. */
  .goal-meter.is-collapsed {
    display: none;
  }
  h2 {
    font-family: var(--font-title);
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #fff;
    /* Still bounded rather than free-running. A campaign name longer than a few
       words would otherwise stretch the full width of the band while the meter
       beneath it stops at 720px — an unreadable measure sitting over a narrow
       one. The long-title scenario is what surfaced this. */
    max-width: 720px;
    margin: 0;
  }
  .meter {
    max-width: 720px;
    margin: 0 auto;
  }

  /* The link drops beneath the heading rather than squeezing it — on a narrow
     band a right-aligned link and a wrapping serif heading fight for the row. */
  @media (max-width: 720px) {
    .goal-meter {
      padding: 56px 24px;
    }
    .gm-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>
