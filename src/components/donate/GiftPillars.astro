---
// "What Your Gift Powers" — the three-card grid showing where a gift goes.
import GiftPillarCard from './GiftPillarCard.astro';
import type { DonatePageCopy } from '../../lib/site';

type Pillar = NonNullable<DonatePageCopy['pillars']>[number];

interface Props {
  title?: string;
  pillars?: Pillar[];
}
const { title = 'What Your Gift Powers', pillars = [] } = Astro.props as Props;
---

{
  pillars.length > 0 ? (
    <section class="pillars">
      <h2>{title}</h2>
      <div class="grid">
        {pillars.map((p) => (
          <GiftPillarCard
            icon={p.icon}
            title={p.title}
            body={p.body}
            linkLabel={p.linkLabel}
            linkUrl={p.linkUrl}
          />
        ))}
      </div>
    </section>
  ) : null
}

<style>
  .pillars {
    padding: 76px 24px;
  }
  h2 {
    font-size: clamp(28px, 3.6vw, 44px);
    letter-spacing: -0.02em;
    font-weight: 800;
    margin: 0 0 24px;
    text-align: center;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    max-width: 1180px;
    margin: 40px auto 0;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
