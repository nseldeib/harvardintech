---
// The circular icon badge on a "What Your Gift Powers" card.
//
// Inline SVG rather than image files: three small line icons cost nothing in
// markup and avoid three extra requests, and they inherit `currentColor` so the
// badge tints from CSS. `people` is the fallback for an unset/unknown value so
// a card always gets a badge rather than an empty circle.
import type { PillarIcon } from '../../lib/site';

interface Props {
  icon?: PillarIcon;
}
const { icon = 'people' } = Astro.props as Props;
---

<span class="badge" aria-hidden="true">
  {
    icon === 'book' ? (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 4.5h7a3 3 0 0 1 3 3v12a2.5 2.5 0 0 0-2.5-2.5H2z" />
        <path d="M22 4.5h-7a3 3 0 0 0-3 3v12a2.5 2.5 0 0 1 2.5-2.5H22z" />
      </svg>
    ) : icon === 'globe' ? (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18" />
        <path d="M12 3c2.5 2.7 3.8 5.8 3.8 9S14.5 18.3 12 21c-2.5-2.7-3.8-5.8-3.8-9S9.5 5.7 12 3z" />
      </svg>
    ) : (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="8" r="3.2" />
        <path d="M2.5 19.5a6.5 6.5 0 0 1 13 0" />
        <path d="M16.5 5.2a3.2 3.2 0 0 1 0 5.9" />
        <path d="M18 14.4a6.5 6.5 0 0 1 3.5 5.1" />
      </svg>
    )
  }
</span>

<style>
  .badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(164, 16, 52, 0.09);
    color: var(--crimson);
    margin-bottom: 22px;
  }
  .badge svg {
    width: 22px;
    height: 22px;
  }
</style>
