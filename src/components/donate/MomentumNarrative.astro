---
// One prose section of the Momentum Fund page, laid out beside its photo.
//
// Replaces the old `MomentumStory` and `MomentumWhy`, which differed only in the
// styling of the same thing — a heading over prose. Collapsing them into one
// component with a `layout` prop is what makes "put the image on the left" an
// editing decision instead of a code change, which is exactly the control the
// campaign review asked for on both sections.
//
// The body is rendered markdown passed through as a slot (the route calls
// `render()` on the entry), so a `>` blockquote in the markdown becomes the
// crimson-ruled pull quote and `###` becomes a block subhead — the typography
// `MomentumStory` and `MomentumWhy` had, now reachable from the CMS editor.
import { altFor } from '../../lib/media';
import { resolveLayout } from '../../lib/momentumSections';

interface Props {
  kicker?: string;
  title?: string;
  /** `image-left` | `image-right` | `text-only` | `columns`; anything else
   *  degrades to text-only rather than rendering an empty column. */
  layout?: string;
  image?: string;
  /** Tints the band and rules it top and bottom, the way the old "Why Support"
   *  section broke up the page. Alternated by the page, not by the editor. */
  tinted?: boolean;
}
const { kicker, title, layout, image, tinted = false } = Astro.props as Props;

// A two-column PHOTO layout with no photo would render a blank column, so an
// absent image falls back to full-width prose regardless of what the editor
// chose. `columns` is exempt: its two columns are both prose, so it is the one
// multi-column layout that is correct precisely when there is no image.
const resolved = resolveLayout(layout);
const mode = image || resolved === 'columns' ? resolved : 'text-only';
const alt = image ? altFor(image, title ?? 'Harvard Alumni in Tech') : '';
---

<section class:list={['narrative', { tinted }]}>
  <div class:list={['inner', mode]}>
    {
      mode !== 'text-only' && mode !== 'columns' && image ? (
        <div class="figure">
          <img src={image} alt={alt} loading="lazy" />
        </div>
      ) : null
    }
    <div class="prose">
      {/* The head sits OUTSIDE the flowing body so `columns` can split the prose
          into two columns without dragging the kicker and heading in with it —
          a heading that flowed into column one would read as a caption. */}
      {kicker || title ? (
        <div class="head">
          {kicker ? <p class="kick">{kicker}</p> : null}
          {title ? <h2>{title}</h2> : null}
        </div>
      ) : null}
      <div class="body">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .narrative {
    padding: 76px 24px;
  }
  .tinted {
    background: var(--paper-2);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .inner {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    gap: 56px;
    /* Stretch, not center. These sections run long — "Why Support Harvard in
       Tech?" is two titled blocks of prose — and a content-height photo centered
       against that column leaves a large dead gap above and below it. Filling
       the row height keeps the two columns reading as one band however much an
       editor writes. */
    align-items: stretch;
  }
  .inner.text-only {
    max-width: 68ch;
    grid-template-columns: 1fr;
  }
  /* `columns` runs the FULL band width — the prose is what splits in two, not
     the grid — so it deliberately does not take text-only's reading-width cap. */
  .inner.columns {
    grid-template-columns: 1fr;
  }
  .inner.image-left,
  .inner.image-right {
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
  }
  /* Source order is figure-then-prose, so image-left needs no reordering and
     image-right swaps the two columns on wide screens only. */
  .inner.image-right .figure {
    order: 2;
  }
  /* The figure is a stretched grid item, so the image can take its height from
     the text column. `cover` crops rather than distorts, which is why an editor
     can pick any photo from the library without matching an aspect ratio. */
  .figure {
    min-height: 0;
  }
  .figure img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
  }
  .kick {
    margin: 0 0 14px;
  }
  /* The campaign design's sentence-heading: a large serif statement rather than
     the 800-weight sans label this band used to carry. Sized off the viewport so
     it holds the same weight beside a photo and across the full band. */
  h2 {
    font-family: var(--font-title);
    font-size: clamp(32px, 4.2vw, 58px);
    letter-spacing: -0.02em;
    font-weight: 700;
    color: var(--momentum-navy);
    /* Set explicitly, unlike the full-width bands that inherit the body value:
       in a half-width column these headings wrap, and body line-height at 58px
       leaves a gap wide enough to read as two separate headings. */
    line-height: 1.06;
    margin: 0 0 28px;
  }
  /* Two columns of prose, the newspaper treatment the campaign design gives the
     "why support us" band. `column-fill: balance` keeps the two ending near the
     same line however much an editor writes. */
  .inner.columns .body {
    column-count: 2;
    column-gap: 56px;
    column-fill: balance;
  }
  /* The pull quote must NOT be split across the two columns, and it reads as a
     card beneath the prose rather than as part of it. */
  .inner.columns .body :global(blockquote) {
    column-span: all;
    break-inside: avoid;
  }

  /* The markdown body arrives through the slot, so its elements are styled by
     descendant selectors rather than by class. `is:global` is required — scoped
     styles do not reach slotted content. */
  .prose :global(p) {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-2);
    margin: 0 0 18px;
  }
  /* A section that OPENS with prose sets that paragraph larger as a lede, the
     way the story section did. Deliberately `:first-child` and not
     `:first-of-type`: a section that opens with a `###` subhead is a list of
     titled blocks, where enlarging the first block's first paragraph would read
     as a mistake rather than as a lede. */
  .prose :global(p:first-child) {
    font-size: 21px;
    line-height: 1.6;
    margin-bottom: 32px;
  }
  .prose :global(p:last-child) {
    margin-bottom: 0;
  }
  .prose :global(h3) {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 36px 0 14px;
  }
  .prose :global(h3:first-child) {
    margin-top: 0;
  }
  /* The campaign design's pull quote: a white card standing off the band rather
     than an inline rule in the text flow. It sits well below the prose because
     in `columns` it spans both columns and closes the band. */
  .prose :global(blockquote) {
    font-family: var(--font-serif);
    font-size: clamp(20px, 2.2vw, 26px);
    line-height: 1.4;
    color: var(--momentum-navy);
    background: var(--paper);
    border-left: 5px solid var(--crimson);
    padding: 28px 32px;
    margin: 48px 0 0;
  }
  .prose :global(blockquote p) {
    font-size: inherit;
    line-height: inherit;
    color: inherit;
    margin: 0;
  }

  /* One column below 900px, photo first — the reading order both layouts imply
     on a phone, where "left" and "right" have no meaning. */
  @media (max-width: 900px) {
    .narrative {
      padding: 56px 24px;
    }
    .inner.image-left,
    .inner.image-right {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .inner.image-right .figure {
      order: 0;
    }
    .figure img {
      max-height: 320px;
    }
  }

  /* Two prose columns are unreadable on a phone — the measure collapses to a few
     words a line — so `columns` becomes one column at the same breakpoint the
     photo layouts stack. */
  @media (max-width: 820px) {
    .inner.columns .body {
      column-count: 1;
    }
  }
</style>
