---
// One entry in "What we've accomplished so far": a figure, what the figure
// counts, and the sentence that gives it meaning.
//
// The pairing is the point — "600+" alone means nothing, and "grew a WhatsApp
// community" without a number reads as a claim rather than a result. Split out
// of MomentumAccomplishments the same way GiftPillarCard is split out of
// GiftPillars, so the card can be captured and reviewed on its own.
interface Props {
  value: string;
  label: string;
  body?: string;
}
const { value, label, body } = Astro.props as Props;
---

<article class="acc">
  <span class="acc-v">{value}</span>
  <span class="acc-l">{label}</span>
  {body ? <p class="acc-b">{body}</p> : null}
</article>

<style>
  /* The cell draws its RIGHT and BOTTOM rules only; the grid in
     `MomentumAccomplishments` draws the top and left. That is what keeps the
     four cells sharing single-pixel rules instead of doubling them at every
     seam, and it means a cell renders correctly at any column count. */
  .acc {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 260px;
    padding: 32px 28px;
    background: #f6f3f0;
    border-top: 3px solid var(--crimson);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .acc-v {
    font-family: var(--font-title);
    font-size: clamp(2.6rem, 3.4vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--crimson);
  }
  .acc-l {
    margin-top: 10px;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .acc-b {
    margin: 18px 0 0;
    color: var(--ink-2);
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.6;
  }
</style>
