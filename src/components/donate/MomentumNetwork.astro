---
// The Momentum Network — the supporter recognition band on /donate.
//
// Replaces the tier-banded donor wall. Composition + the one thing that cannot
// be delegated: the SVG is built HERE, on the server, from `networkLayout`.
// That is deliberate. A canvas assembled in the browser is an empty frame to
// anyone without JavaScript, and this band is how the campaign thanks the
// people who paid for it — the recognition cannot be contingent on a script
// running. `momentumNetworkDom.ts` adds hover, selection, search and sound on
// top of a picture that is already there.
//
// Two states, and they are not variations of one another:
//   • No supporters → the invitation, exactly as the wall did it. The grid is
//     built and dark, which is the production default.
//   • Supporters present → the network, the search, and the roll beneath it.
import GiveButton from './GiveButton.astro';
import NetworkSupporterRoll from './NetworkSupporterRoll.astro';
import {
  headlineHtml,
  networkLayout,
  networkNodeDetail,
  matchesNetworkSearch,
  shortSchoolLabel,
  supporterRoll,
} from '../../lib/momentumNetwork';
import {
  badgeFor,
  shareMessage,
  canShareBadge,
  linkedInShareUrl,
  facebookShareUrl,
  supporterPageUrl,
} from '../../lib/supporterBadge';
import { donorPublicIdentity, type DonorLike, type DonorTierLike } from '../../lib/donors';

interface Props {
  /** The band's eyebrow. Falls back to the campaign name, which is what this
   *  band drew before the field existed. */
  kicker?: string;
  title?: string;
  /** The label in the visualization's top-left corner. */
  networkTitle?: string;
  /** The line beneath the heading. */
  tagline?: string;
  searchTitle?: string;
  /** The word beside the live supporter count in the rail. */
  countLabel?: string;
  /** The rail's giving CTA. Falls back to the page's own CTA label. */
  railCtaLabel?: string;
  emptyMessage?: string;
  donors?: DonorLike[];
  tiers?: DonorTierLike[];
  ctaLabel?: string;
  donateUrl?: string;
  email?: string;
  campaignName?: string;
  /** The template the share message pre-populates from. */
  shareTemplate?: string;
  /** Where a shared badge points. */
  pageUrl?: string;
  /** The greeting for someone arriving from the campaign email, containing a
   *  `{name}` placeholder filled client-side. The band is the page's hero now,
   *  so the greeting the old photo hero carried lives here — see the greeting
   *  note below for why it is additive rather than a headline swap. */
  greetingNamed?: string;
  /** Pins the greeting server-side so a scenario can capture it. Without this a
   *  static build has no name to render: the value arrives in the URL, in the
   *  browser, long after the HTML was built. */
  previewName?: string;
}

const {
  kicker,
  title = 'A grid, *lit from within*.',
  networkTitle = 'The Momentum Network — Powering Harvard Alumni in Tech',
  // Names the unlit field, and has to. The original line — "Every light belongs
  // to a founding supporter" — became false the moment `ambientField` started
  // padding the frame, because most of the points a reader sees are not people.
  // This line, the count (which reads `donors.length`, never the drawn total)
  // and the supporter roll are the three things keeping the picture honest
  // about who actually gave; change this one and the other two are carrying it
  // alone.
  //
  // The deck's direction 01 copy was tried here briefly and reverted: it reads
  // "each school is a junction; each supporter a light hung off it", which
  // describes hub-and-spoke — a topology this component does not draw, since
  // `nearestNeighborEdges` wires each supporter to its neighbours and draws no
  // junctions at all.
  tagline = 'Every bright light is a founding supporter — the faint ones are places still waiting. Together, they illuminate what comes next.',
  searchTitle = 'Find your place in the network',
  countLabel = 'supporters',
  railCtaLabel,
  emptyMessage,
  donors = [],
  tiers = [],
  ctaLabel,
  donateUrl,
  // Defaulted rather than optional-forwarded: the empty state's Give button
  // falls back to a mailto when no donation URL is set, so it needs an address.
  email = 'ben@harvardintech.com',
  campaignName,
  shareTemplate,
  pageUrl = 'https://www.harvardintech.com/donate',
  greetingNamed,
  previewName,
} = Astro.props;

// The greeting for someone arriving from the campaign email.
//
// It is an ADDITIVE line above the headline, not a replacement for it. The old
// photo hero personalized by swapping its whole headline; this band cannot do
// that, because its headline is the composition — "A grid, lit from within" is
// the picture's own caption, and trading it for "Ben, let's go further
// together" would delete the design the band exists to be.
//
// So: a named arrival gets a line the public visitor never sees, and everyone
// else gets exactly the page the team signed off on. That asymmetry is why this
// renders hidden and is revealed client-side rather than personalizing in
// place — there is no generic text to show first, so there is nothing to flash.
const pinnedGreeting =
  previewName && greetingNamed?.includes('{name}')
    ? greetingNamed.replace(/\{name\}/g, previewName)
    : null;

const defaultEmptyMessage =
  'The grid is built and dark. The first gift lights the first node, and every gift after it adds another light and another connection.';

const hasDonors = donors.length > 0;
const { nodes, edges, viewBox, clusters, ambient } = networkLayout(donors);

// The count the page prints. Read from the SUPPORTERS, never from the drawn
// points — `ambient` fills the frame so the field reads at the reference's
// density, and the one thing that must never absorb it is the number a visitor
// takes away as "how many people gave".
const supporterCount = donors.length;
const bySlug = new Map(donors.map((donor) => [donor.slug, donor]));
const tierName = (id?: string) => tiers.find((tier) => tier.id === id)?.name;

// The panel payload. Every field already passed through `donorPublicIdentity`,
// so anonymity is applied once — and an anonymous supporter simply has no entry
// here, which is what makes their node inert rather than merely unstyled.
const details: Record<string, unknown> = {};
for (const donor of donors) {
  if (donor.anonymous === true) continue;
  const detail = networkNodeDetail(donor, tierName(donor.tier));
  const badge = badgeFor(donor, tierName(donor.tier));
  details[donor.slug] = {
    ...detail,
    shareMessage: canShareBadge(donor)
      ? shareMessage(badge, { template: shareTemplate, donationUrl: donateUrl })
      : undefined,
    // Each supporter's badge is shared as ITS OWN url, not the campaign page's,
    // so whoever follows the link arrives with that supporter's node already
    // open rather than looking for one dot among many.
    shareUrl: canShareBadge(donor) ? supporterPageUrl(pageUrl, donor.slug) : undefined,
    linkedInUrl: canShareBadge(donor)
      ? linkedInShareUrl(supporterPageUrl(pageUrl, donor.slug))
      : undefined,
    facebookUrl: canShareBadge(donor)
      ? facebookShareUrl(supporterPageUrl(pageUrl, donor.slug))
      : undefined,
  };
}

/** What each node is searchable on, precomputed so the browser matches the same
 *  strings the server would. An anonymous supporter gets an empty haystack —
 *  the rule `matchesNetworkSearch` states, carried into the DOM. */
function searchHaystack(donor: DonorLike): string {
  if (!matchesNetworkSearch(donor, '')) return '';
  if (donor.anonymous === true) return '';
  const identity = donorPublicIdentity(donor);
  return [identity.school, shortSchoolLabel(identity.school), identity.location]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
}

const roll = supporterRoll(donors);
---

{
  !hasDonors ? (
    /* Day one, and the state /donate is in RIGHT NOW. The band stays dark and
       keeps its label and headline — the grid is built and unlit, waiting for
       the first gift to energize it — rather than dropping to a plain white
       panel that gives no hint of what this section becomes. The invitation and
       the giving CTA are the whole content, because the visitor most likely to
       be reading an empty supporter wall is deciding whether to be first on it. */
    <section class="network network--empty" id="donors" aria-labelledby="momentum-network-title">
      <div class="wrap network-empty-in">
        <p class="kick network-label">{networkTitle}</p>
        <p
          class="network-greeting"
          data-network-greeting
          data-named={greetingNamed}
          data-preview={previewName ? 'true' : undefined}
          hidden={!pinnedGreeting}
        >
          {pinnedGreeting}
        </p>
        <h2 id="momentum-network-title" class="network-headline" set:html={headlineHtml(title)} />
        <p class="network-empty-message">{emptyMessage ?? defaultEmptyMessage}</p>
        <GiveButton label={ctaLabel} donateUrl={donateUrl} email={email} campaignName={campaignName} />
      </div>
    </section>
  ) : (
    <section class="network" data-momentum-network aria-labelledby="momentum-network-title">
      <div class="network-stage" data-network-stage>
        <svg
          class="network-svg"
          viewBox={`0 0 ${viewBox.width} ${viewBox.height}`}
          preserveAspectRatio="xMidYMid slice"
          role="img"
          aria-label={`${donors.length} supporters, drawn as a connected network. Every name is listed below.`}
        >
          <defs>
            {/* TEAL-dominant, not crimson. Crimson bloomed over navy at low
                opacity mixes to a purple-magenta wash exactly where two clusters
                overlap — one of the colours the direction rules out by name, and
                arrived at by accident rather than by choice. Teal over navy stays
                in the blue-green family however the blooms stack, so the light
                can never drift off-brand. */}
            <radialGradient id="network-bloom">
              <stop offset="0%" stop-color="#04979e" stop-opacity="0.2" />
              <stop offset="60%" stop-color="#04979e" stop-opacity="0.07" />
              <stop offset="100%" stop-color="#04979e" stop-opacity="0" />
            </radialGradient>
          </defs>

          {/* The light the band is named for. Each cluster of supporters sits in
              a soft bloom, so the grid reads as lit FROM WITHIN rather than as
              dots drawn on a dark rectangle. Kept well below the brightness of
              anything above it — the direction asks for refined and restrained,
              and a bloom that competes with its own nodes is neither. */}
          <g class="network-blooms" aria-hidden="true">
            {clusters.map((cluster) => (
              <circle cx={cluster.x} cy={cluster.y} r={cluster.r} fill="url(#network-bloom)" />
            ))}
          </g>

          {/* The unlit field. Drawn FIRST so every real supporter, every
              connection and every bloom sits in front of it — a dim point can
              never occlude a person. `aria-hidden` and pointer-events off:
              there is nothing here to read, focus, hover or click, and the
              supporter roll below lists only actual people. See
              `ambientField` for why the field exists and why it recedes as
              real gifts arrive. */}
          <g class="network-ambient" aria-hidden="true">
            {ambient.edges.map((edge) => (
              <line class="network-ambient-edge" x1={edge.x1} y1={edge.y1} x2={edge.x2} y2={edge.y2} />
            ))}
            {ambient.points.map((point) => (
              <circle class="network-ambient-point" cx={point.x} cy={point.y} r={point.r} />
            ))}
          </g>

          <g class="network-edges">
            {edges.map((edge, i) => (
              <>
                <line
                  class="network-edge-base"
                  x1={nodes[edge.a].x}
                  y1={nodes[edge.a].y}
                  x2={nodes[edge.b].x}
                  y2={nodes[edge.b].y}
                  data-network-edge={`${nodes[edge.a].slug}|${nodes[edge.b].slug}`}
                />
                {/* The second layer on the identical path is the "subtle energy
                    movement" the direction asks for in teal: a short bright dash
                    travelling a dim standing conductor. One dashed line on its
                    own reads as a dotted border; two layers read as current.
                    `pathLength="100"` normalises every edge so the dash takes
                    the same time to cross a short link as a long one, and the
                    staggered delay stops the whole web pulsing in lockstep. */}
                <line
                  class="network-edge-current"
                  x1={nodes[edge.a].x}
                  y1={nodes[edge.a].y}
                  x2={nodes[edge.b].x}
                  y2={nodes[edge.b].y}
                  pathLength="100"
                  style={`--net-current-delay: ${((i % 9) * 480).toFixed(0)}ms`}
                  aria-hidden="true"
                />
              </>
            ))}
          </g>

          <g class="network-nodes">
            {nodes.map((node, i) => (
              <g class="network-node-group" style={`--net-delay: ${(i * 55).toFixed(0)}ms`}>
                {/* The halo is what turns a flat disc into a light. It is a
                    sibling rather than a filter on the node itself so that
                    selecting can brighten the node without inflating its glow
                    into the neighbours. */}
                <circle
                  class:list={['network-halo', { 'is-founding': node.founding }]}
                  cx={node.x}
                  cy={node.y}
                  r={node.r * 1.85}
                  aria-hidden="true"
                />
                <circle
                  cx={node.x}
                  cy={node.y}
                  r={node.r}
                  class:list={['network-node', { 'is-founding': node.founding }]}
                  data-network-node={node.slug}
                  data-selectable={String(node.selectable)}
                  data-network-haystack={searchHaystack(bySlug.get(node.slug)!)}
                  tabindex={node.selectable ? 0 : undefined}
                  role={node.selectable ? 'button' : undefined}
                  aria-label={node.selectable ? details[node.slug] ? (details[node.slug] as { name: string }).name : undefined : undefined}
                />
              </g>
            ))}
          </g>
        </svg>

        {/* The line the direction asks for in the grid's top-left corner. */}
        <p class="kick network-label">{networkTitle}</p>

        <button
          type="button"
          class="network-sound"
          data-network-sound
          aria-pressed="true"
        >Sound on</button>

        {/* The heading now sits ON the field rather than in a paper band above
            it. That is the reference's whole composition: the words are part of
            the picture, not a caption to it. A gradient behind them carries the
            contrast, because which cluster lands under the text is a property of
            the layout seed — and a seed is not a legibility guarantee. */}
        <div class="network-overlay">
          <p class="kick network-overlay-kicker">{kicker ?? campaignName ?? 'The Momentum Fund'}</p>
          <p
            class="network-greeting"
            data-network-greeting
            data-named={greetingNamed}
            data-preview={previewName ? 'true' : undefined}
            hidden={!pinnedGreeting}
          >
            {pinnedGreeting}
          </p>
          <h2 id="momentum-network-title" class="network-headline" set:html={headlineHtml(title)} />
          <p class="network-tagline">{tagline}</p>
        </div>

        {/* Hover preview. Name, school, class year — the card in the reference,
            and deliberately LESS than the panel a click opens. It is populated
            from the same details payload, so an anonymous supporter (who has no
            entry there and whose node is `data-selectable="false"`) cannot be
            previewed any more than they can be opened. */}
        <div class="network-hover" data-network-hover hidden aria-hidden="true">
          <p class="network-hover-name" data-network-hover-field="name"></p>
          <p class="network-hover-meta" data-network-hover-field="meta"></p>
        </div>

        <div class="network-rail">
          <div class="network-search-box">
            <label class="network-search-label" for="network-search">{searchTitle}</label>
            <input
              id="network-search"
              type="search"
              class="network-search"
              data-network-search
              placeholder="Your school or city — “Kennedy”, “London”"
              autocomplete="off"
            />
            <p class="network-summary" data-network-summary aria-live="polite"></p>
          </div>

          <div class="network-rail-end">
            {/* The real number, always. */}
            <p class="network-count">
              <span class="network-count-value">{supporterCount}</span>
              <span class="network-count-label">{countLabel}</span>
            </p>
            <GiveButton
              label={railCtaLabel ?? ctaLabel}
              donateUrl={donateUrl}
              email={email}
              campaignName={campaignName}
            />
          </div>
        </div>

        <div class="network-panel" data-network-panel hidden>
          <button type="button" class="network-dismiss" data-network-dismiss aria-label="Close supporter details">×</button>
          <p class="network-panel-name" data-network-field="name"></p>
          <p class="network-panel-standing" data-network-field="standing"></p>
          <p class="network-panel-school" data-network-field="school"></p>
          <p class="network-panel-location" data-network-field="location"></p>

          <div class="network-share" data-network-share hidden>
            <label class="network-share-label" for="network-share-message">Share your badge</label>
            <textarea id="network-share-message" class="network-share-message" data-network-share-message rows="7"></textarea>
            <p class="network-share-hint">Edit this before you post it — it is yours.</p>
            <div class="network-share-links">
              <a data-network-share-linkedin href="#" target="_blank" rel="noopener noreferrer">Share on LinkedIn</a>
              <a data-network-share-facebook href="#" target="_blank" rel="noopener noreferrer">Share on Facebook</a>
            </div>
          </div>
        </div>
      </div>

      <div class="wrap network-roll-wrap">
        <NetworkSupporterRoll donors={roll} tiers={tiers} />
      </div>

      <script is:inline type="application/json" data-network-details set:html={JSON.stringify(details)} />
    </section>
  )
}

<script>
  import { initMomentumNetwork, applyNetworkGreeting } from '../../lib/momentumNetworkDom';
  initMomentumNetwork();
  // Runs in BOTH band states: the empty grid is the page a first-time supporter
  // arrives on from the email, so it is the state that most needs the greeting.
  applyNetworkGreeting(window.location.search);
</script>

<style>
  /* The palette is the design direction's, and the four colours carry meaning:
     crimson is a supporter, teal is the connection between them, gold is the one
     node under the pointer, navy is the ground. Declared as tokens so the
     "no magenta, no purple, no cobalt" constraint is legible in one place. */
  .network {
    --net-bg: #07070a;
    --net-node: #a51034;
    --net-edge: #04979e;
    --net-active: #f6c76b;
    /* The unlit field. Crimson so it belongs to the same picture, but far below
       a real supporter's brightness — a point a reader could mistake for a
       person is the one thing this layer must never be. */
    --net-ambient: rgba(165, 16, 52, 0.62);
  }

  /* Near-black, per the reference. The whole band IS the stage now — heading,
     controls and count all sit on the artwork — so there is no paper chrome
     left to tint. The band reads as a hard cut between the two light bands
     around it, which is what the reference does. */
  .network {
    /* The containing block for `.network-label`, which is absolutely
       positioned. In the populated band the label sits inside `.network-stage`,
       which is positioned and captures it — but the EMPTY band has no stage, so
       without this the label escaped to the initial containing block and landed
       over the site header at the top of the page. Empty is the production
       state today, so that was the view most visitors got. */
    position: relative;
    background: var(--net-bg);
    padding: 0;
  }

  /* The one heading on the site set in the SANS rather than Crimson Pro, and a
     deliberate exception rather than drift: this band is a full-bleed black
     field borrowed wholesale from the design deck, and the deck's headline is a
     heavy geometric sans. The serif that carries every other heading reads as
     editorial — correct on paper bands, wrong on the artwork, where the type is
     part of the image. Scoped to this heading only. */
  .network-headline {
    font-family: var(--font-sans);
    font-size: clamp(40px, 5.6vw, 76px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.98;
    margin: 14px 0 20px;
    max-width: 12ch;
    color: #fff;
  }

  /* The emphasised phrase the heading's `*asterisks*` mark. Crimson and italic,
     per the reference — the one place on the artwork where the heading changes
     colour, so it reads as the phrase being stressed rather than as two
     headings. */
  /* `:global` is REQUIRED here, not stylistic. The `<em>` is injected through
     `set:html`, so Astro never stamps it with the component's scope attribute
     and a plain `.network-headline em` selector silently matches nothing — the
     phrase still renders italic, because that is the browser's default for
     `<em>`, which makes the miss look like a colour choice rather than a
     broken rule. */
  .network-headline :global(em) {
    /* Brighter than `--net-node`. That token is the colour of a NODE, tuned to
       sit on black as a small glowing dot; at headline size the same value
       reads as muddy dark red against the ground. Type and dots need different
       reds even when they are the same hue. */
    color: #ef3355;
    font-style: italic;
  }

  /* The design's italic accent line under the heading — the existing tagline
     prop supplies it, so this is a restyle rather than a new field. */
  .network-tagline {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 19px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.74);
    max-width: 34ch;
  }

  /* The stage. Taller than it was, because in the reference the field is the
     moment rather than an illustration under a heading — and it now has to hold
     the heading, the rail and the count as well as the artwork. */
  .network-stage {
    position: relative;
    height: clamp(34rem, 52vw, 48rem);
    overflow: hidden;
    background: var(--net-bg);
  }

  /* The copy column, over the field, left. `pointer-events: none` so the text
     never steals a hover from a node sitting beneath it — the whole field stays
     reachable. The gradient is the contrast guarantee: which cluster lands under
     the words is a property of the layout seed, and a seed is not legibility. */
  .network-overlay {
    position: absolute;
    top: clamp(4.5rem, 9vw, 7.5rem);
    left: 0;
    right: 0;
    z-index: 2;
    margin: 0 auto;
    padding: 0 48px;
    max-width: var(--content-width);
    pointer-events: none;
  }

  .network-overlay::before {
    content: '';
    position: absolute;
    inset: -3rem -4rem -3rem -6rem;
    z-index: -1;
    background: radial-gradient(
      ellipse at 22% 45%,
      rgba(7, 7, 10, 0.92) 0%,
      rgba(7, 7, 10, 0.66) 45%,
      transparent 78%
    );
  }

  .network-overlay-kicker {
    color: rgba(255, 255, 255, 0.62);
    margin: 0;
  }

  /* The greeting sits between the eyebrow and the headline in both states, in
     the gold that already marks "this one is about you" everywhere else in the
     band (the active node, the search summary). Serif rather than the mono
     eyebrow: it is a sentence addressed to a person, not a label. */
  .network-greeting {
    margin: 10px 0 0;
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(18px, 2.2vw, 26px);
    line-height: 1.25;
    color: var(--net-active);
  }

  /* `hidden` is an attribute the greeting relies on for the un-named visitor,
     and this component's own display rules would otherwise override the UA
     default and render an empty line. */
  .network-greeting[hidden] {
    display: none;
  }

  /* The unlit field. Flat — no halo, no drop shadow, no animation, no travelling
     current — because every one of those is a cue this layer must NOT carry:
     they are how a real supporter announces itself. */
  .network-ambient-point {
    fill: var(--net-ambient);
  }

  .network-ambient-edge {
    stroke: rgba(255, 255, 255, 0.055);
    stroke-width: 0.4;
  }

  /* The field settles further back while a supporter is being read, the same
     way the real web does — otherwise selecting dims the people and leaves the
     scenery at full strength. */
  .network.is-selecting .network-ambient {
    opacity: 0.4;
  }

  /* The empty band has no artwork to carry it, so it keeps a hint of the crimson
     light the populated field supplies — otherwise day one is a flat black slab.
     This is the production state today, so it is the view most visitors get. */
  .network--empty {
    padding: 86px 0 90px;
    background-image: radial-gradient(
      ellipse at 18% 0%,
      rgba(165, 16, 52, 0.3),
      transparent 60%
    );
  }

  /* The roll sits below the stage on the same black ground and needs the bottom
     margin the band's own padding used to give it. */
  .network-roll-wrap {
    padding: 56px 0 86px;
  }

  .network-empty-in {
    max-width: 46rem;
    padding-bottom: 1rem;
  }

  .network-empty-message {
    margin: 0 0 1.75rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: rgba(238, 244, 250, 0.78);
    max-width: 44ch;
  }

  .network-svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Copy over the artwork, top-left. The gradient behind it is what keeps the
     text legible wherever a bright cluster happens to land underneath — without
     it the headline would depend on the layout's seed, which is not a
     contrast guarantee. */
  /* `.kick` on the artwork. Only the colour is overridden — the token's crimson
     is unreadable on navy, and gold is the direction's own accent. */
  .network-label {
    color: var(--net-active);
  }
  /* Pinning it to the grid's top-left corner belongs to the label ON THE
     ARTWORK, and only there. The EMPTY band reuses the same element as an
     ordinary kicker above its heading, where absolute positioning had nothing
     to anchor to — so it is scoped to the stage rather than left on the class. */
  .network-stage .network-label {
    position: absolute;
    top: 22px;
