---
// One "What Your Gift Powers" card: icon badge, title, body, and an optional
// inline link that reads as part of the sentence ("… Check out our past
// events.") rather than as a separate call to action.
import PillarIcon from './PillarIcon.astro';
import { withBase } from '../../lib/url';
import type { PillarIcon as PillarIconName } from '../../lib/site';

interface Props {
  icon?: PillarIconName;
  title: string;
  body: string;
  linkLabel?: string;
  linkUrl?: string;
}
const { icon, title, body, linkLabel, linkUrl } = Astro.props as Props;
---

<article class="pil">
  <PillarIcon icon={icon} />
  <h3>{title}</h3>
  <p>
    {body}
    {/* Kept on one line: a newline before the period renders as a space,
        giving "past events ." in the card copy. */}
    {linkLabel && linkUrl ? (<Fragment> <a href={withBase(linkUrl)} rel="noopener">{linkLabel}</a>.</Fragment>) : null}
  </p>
</article>

<style>
  .pil {
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 32px 30px 36px;
  }
  h3 {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0 0 14px;
  }
  p {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-2);
    margin: 0;
  }
</style>
