---
// One "What Your Gift Powers" card: an ordinal, title, body, and an optional
// inline link that reads as part of the sentence ("… Check out our past
// events.") rather than as a separate call to action.
//
// The ordinal REPLACED an icon badge. It is passed in already zero-padded rather
// than derived here, because the number a card shows is a fact about its
// position in its band — which only the band knows, and which is why a grouped
// second gift band starts again at 01.
import { withBase } from '../../lib/url';

interface Props {
  number?: string;
  title: string;
  body: string;
  linkLabel?: string;
  linkUrl?: string;
}
const { number, title, body, linkLabel, linkUrl } = Astro.props as Props;
---

<article class="pil">
  {number ? <span class="num">{number}</span> : null}
  <h3>{title}</h3>
  <p>
    {body}
    {/* Kept on one line: a newline before the period renders as a space,
        giving "past events ." in the card copy. */}
    {linkLabel && linkUrl ? (<Fragment> <a href={withBase(linkUrl)} rel="noopener">{linkLabel}</a>.</Fragment>) : null}
  </p>
</article>

<style>
  /* The cell draws its RIGHT and BOTTOM rules only; `GiftPillars` draws the top
     and left on the grid, so adjacent cells share one hairline rather than
     doubling it. Translucent white over the cream band, so the grid reads as
     lighter panels on the band rather than as boxes floating over it. */
  .pil {
    display: flex;
    flex-direction: column;
    min-height: 320px;
    background: rgba(255, 255, 255, 0.55);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 34px 32px 38px;
  }
  .num {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.16em;
    color: var(--crimson);
    margin-bottom: 22px;
  }
  h3 {
    font-family: var(--font-title);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--momentum-navy);
    margin: 0 0 14px;
  }
  p {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-2);
    margin: 0;
  }
</style>
