---
// Google Analytics (GA4) via gtag.js. Renders nothing unless a Measurement ID
// is configured, so the default state of the site ships zero analytics markup.
// Editors only ever type a `G-XXXXXXXXXX` id in the CMS — this template owns the
// script markup, so a bad value can't break page structure or inject arbitrary
// code (that's what the separate customHeadHtml escape hatch is for).
//
// The id now comes from the `siteIntegrations` collection, which is what put it
// in /admin at all: it lived on the `settings` singleton, whose editor renders
// inputs for five scalar keys and round-trips the rest, so this was editable
// data with nowhere to edit it. `settings` remains the fallback.
//
// Included via HeadExtras so it lands in every route's <head>, blog posts
// included. Consent-gating (a GDPR banner) is intentionally out of scope here.
import { settings } from '../lib/site';
import { loadIntegrations } from '../lib/integrationsContent';

const { googleAnalyticsId: gaId } = await loadIntegrations(settings);
---

{gaId ? <div id="ga-config" data-ga-id={gaId} hidden /> : null}

{
  /*
    The measurement id rides on a data attribute rather than being interpolated
    into the script below, because a bundled `<script>` is a MODULE: Astro emits
    it once and every page shares that one file, so a value baked into it would
    be whatever the first page built happened to carry. The attribute is
    per-page, which is what an editable-in-the-CMS id has to be.

    Loading gtag from here rather than from a `<script is:inline src>` in the
    head is what makes the suppression possible at all. A static site cannot know
    at BUILD time whether a given request is a reader or the CMS editor's preview
    pane — that is a query string, and query strings only exist in the browser.
    So the tag is injected by script or not at all, and `isEmbeddedPreview`
    decides which. See src/lib/embeddedPreview.ts.

    The cost is that analytics now loads a moment later, after the module script
    parses, instead of racing the rest of the head. For a page-view counter that
    is a fair trade for numbers that aren't inflated by the team's own editing.
  */
}
<script>
  import { loadScriptUnlessEmbedded } from '../lib/embeddedPreview';

  const gaId = document.getElementById('ga-config')?.dataset.gaId;
  const src = gaId ? `https://www.googletagmanager.com/gtag/js?id=${gaId}` : undefined;

  // The bootstrap runs only when the tag actually loaded — no id configured, or
  // the editor's preview pane, and `dataLayer` is never created at all. A
  // half-initialised gtag would queue events forever against a script that is
  // not coming.
  if (loadScriptUnlessEmbedded(document, window.location.search, src)) {
    // Google's own snippet, unchanged in shape: `dataLayer` is a global array
    // and `gtag` pushes its raw `arguments` object onto it. Kept literally
    // rather than modernised — gtag.js reads those pushed entries positionally,
    // and a rest-parameter array is a different object than the `arguments` the
    // library is written against.
    const w = window as unknown as { dataLayer?: unknown[]; gtag?: unknown };
    w.dataLayer = w.dataLayer || [];
    function gtag(..._args: unknown[]) {
      // eslint-disable-next-line prefer-rest-params
      w.dataLayer!.push(arguments);
    }
    w.gtag = gtag;
    gtag('js', new Date());
    gtag('config', gaId);
  }
</script>
