---
// "You may also be interested in" — the tail of a project's detail page, below
// the sign-up CTA.
//
// A reader who has just finished one project's description is the most likely
// person on the site to take a different one, and until now the only way onward
// was the back link to the grid.
//
// Which projects arrive here is `relatedProjects`' decision, not this
// component's: it renders whatever list it is given, in the given order. That
// keeps the "related" rule pure and testable and this file purely presentational.
//
// Renders NOTHING — no heading, no empty section — when the list is empty. That
// is the common case today, not an edge case: the collection holds one project,
// so every detail page has no siblings to suggest and should simply end at the
// CTA.
import VolunteerProjectCard from './VolunteerProjectCard.astro';
import type { VolunteerProjectLike } from './VolunteerProjects.astro';

interface Props {
  projects?: VolunteerProjectLike[];
  title?: string;
}
const { projects = [], title = 'You may also be interested in' } = Astro.props as Props;
---

{
  projects.length > 0 ? (
    <section class="related" aria-labelledby="related-projects">
      <div class="wrap">
        <h2 id="related-projects">{title}</h2>
        <div class="grid">
          {projects.map((p) => (
            <VolunteerProjectCard
              title={p.title}
              blurb={p.blurb}
              image={p.image}
              applyUrl={p.applyUrl}
              commitment={p.commitment}
              startDate={p.startDate}
              endDate={p.endDate}
              slug={p.slug}
            />
          ))}
        </div>
      </div>
    </section>
  ) : null
}

<style>
  .related {
    border-top: 1px solid var(--line);
    margin-top: 64px;
    padding-top: 56px;
  }
  h2 {
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 32px;
  }
  /* The same breakpoints as the /volunteer grid — these are the same cards, so
     they should reflow at the same widths rather than inventing a second rule. */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
