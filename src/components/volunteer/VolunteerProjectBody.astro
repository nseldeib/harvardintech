---
// The prose column holding a project's rendered markdown body — the full
// description an organizer wrote in the CMS.
//
// Until this page existed nothing rendered a project's body anywhere, so this
// component is where that content finally lands. The markdown arrives through
// the slot already rendered by Astro's `render()`, which means its tags are not
// in this file's template and need `:global` to be styled at all.
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.8;
    max-width: 68ch;
    margin-top: 28px;
  }
  /* `:global` because these elements come from rendered markdown in the slot,
     so Astro's scoped-style attribute is never applied to them. */
  .prose :global(h2) {
    font-family: var(--font-sans, inherit);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 36px 0 12px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 22px;
    margin: 16px 0;
  }
  .prose :global(li) {
    margin: 8px 0;
  }
  .prose :global(p) {
    margin: 16px 0;
  }
</style>
