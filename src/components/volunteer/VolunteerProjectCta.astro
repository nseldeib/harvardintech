---
// The sign-up button at the foot of a volunteer project's detail page.
//
// Which link it offers is `projectCta`'s decision, not this component's: the
// project's own sign-up link, else the site-wide volunteer CTA, else nothing at
// all. Keeping that rule in `src/lib/projects.ts` means the fallback is unit-
// tested rather than only provable by rendering the page.
import { withBase } from '../../lib/url';
import { projectCta } from '../../lib/projects';

interface Props {
  applyUrl?: string;
  ctaLabel?: string;
  ctaUrl?: string;
}
const { applyUrl, ctaLabel, ctaUrl } = Astro.props as Props;

const cta = projectCta(applyUrl, ctaLabel, ctaUrl);
---

{
  cta ? (
    <a class="btn btn-solid cta" href={withBase(cta.href)} rel="noopener">
      {cta.label}
    </a>
  ) : null
}

<style>
  .cta {
    margin-top: 36px;
  }
</style>
