---
// Shown in place of the projects grid when nothing is currently open.
//
// This is the PRODUCTION DEFAULT, not an edge case: the `projects` collection
// starts empty, so most visitors see this. It therefore has to do real work —
// acknowledge the gap and still give the reader a way to raise their hand.
import { withBase } from '../../lib/url';

interface Props {
  message?: string;
  ctaLabel?: string;
  ctaUrl?: string;
}
const {
  message = "We're lining up the next round of volunteer projects. Check back soon.",
  ctaLabel,
  ctaUrl,
} = Astro.props as Props;
---

<div class="empty">
  <p>{message}</p>
  {
    ctaLabel && ctaUrl ? (
      <a class="btn btn-out" href={withBase(ctaUrl)} rel="noopener">
        {ctaLabel}
      </a>
    ) : null
  }
</div>

<style>
  .empty {
    border: 1px dashed var(--line);
    border-radius: 6px;
    background: var(--paper-2);
    padding: 48px 32px;
    text-align: center;
  }
  p {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 56ch;
    margin: 0 auto 22px;
  }
</style>
