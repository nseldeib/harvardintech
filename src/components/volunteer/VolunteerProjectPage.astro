---
// One volunteer project's own page: the photo at full size, the framing details
// an organizer filled in, the long description that until now lived only in the
// markdown file and was rendered nowhere, and the way to sign up.
//
// Composition only — every section is its own component, matching the split
// ChapterPage.astro uses.
//
// Props-only (the body arrives in the default slot) so it renders both from the
// /volunteer/projects/<slug> route and from isolated-component scenarios.
import VolunteerProjectPhoto from './VolunteerProjectPhoto.astro';
import VolunteerProjectHeader from './VolunteerProjectHeader.astro';
import VolunteerProjectBody from './VolunteerProjectBody.astro';
import VolunteerProjectCta from './VolunteerProjectCta.astro';
import VolunteerRelatedProjects from './VolunteerRelatedProjects.astro';
import type { VolunteerProjectLike } from './VolunteerProjects.astro';

interface Props {
  title: string;
  blurb?: string;
  image?: string;
  commitment?: string;
  startDate?: string | Date;
  endDate?: string | Date;
  applyUrl?: string;
  /** Page-level volunteer CTA, used when the project has no `applyUrl` of its
   *  own — see `projectCta` in `src/lib/projects.ts` for the rule. */
  ctaLabel?: string;
  ctaUrl?: string;
  /** Other open projects to suggest below the CTA. Already chosen by
   *  `relatedProjects` — the page renders the list, it does not pick it. Empty
   *  (or absent) means the page simply ends at the CTA. */
  related?: VolunteerProjectLike[];
  backHref?: string;
  backLabel?: string;
}
const {
  title,
  blurb,
  image,
  commitment,
  startDate,
  endDate,
  applyUrl,
  ctaLabel,
  ctaUrl,
  related = [],
  backHref,
  backLabel,
} = Astro.props as Props;
---

<article class="proj-page">
  <VolunteerProjectPhoto image={image} />

  <div class="s-narrow">
    <VolunteerProjectHeader
      title={title}
      blurb={blurb}
      commitment={commitment}
      startDate={startDate}
      endDate={endDate}
      backHref={backHref}
      backLabel={backLabel}
    />

    <VolunteerProjectBody>
      <slot />
    </VolunteerProjectBody>

    <VolunteerProjectCta applyUrl={applyUrl} ctaLabel={ctaLabel} ctaUrl={ctaUrl} />
  </div>

  {/* Outside `.s-narrow` on purpose: the CTA ends the prose, and three cards
      squeezed into a reading measure would stack into a column. */}
  <VolunteerRelatedProjects projects={related} />
</article>

<style>
  .proj-page {
    padding: 0 0 72px;
  }
</style>
