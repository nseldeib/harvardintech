---
// One open volunteer project, as it appears in the /volunteer grid.
//
// Everything but the title is optional, because an organizer should be able to
// post a project the moment it opens and fill in the thumbnail, commitment, and
// sign-up link later. A card with no thumbnail keeps the same geometry as one
// with a photo so a mixed grid stays aligned.
//
// The thumbnail and the title link to the project's detail page; the apply link
// stays its own control. Deliberately NOT one card-wide <a>: an <a> nested
// inside another is invalid markup and collapses the card into a single
// unusable target for keyboard users.
import { withBase } from '../../lib/url';
import { projectPath } from '../../lib/projects';
import VolunteerProjectThumb from './VolunteerProjectThumb.astro';
import VolunteerProjectCardLinks from './VolunteerProjectCardLinks.astro';

interface Props {
  title: string;
  blurb?: string;
  image?: string;
  applyUrl?: string;
  commitment?: string;
  /** The project's slug, which is what makes the card clickable. Absent (an
   *  isolated-component state that passes none) → the card renders exactly as it
   *  did before detail pages existed: no links, same layout. */
  slug?: string;
}
const { title, blurb, image, applyUrl, commitment, slug } = Astro.props as Props;

const href = slug ? withBase(projectPath(slug)) : undefined;
---

<article class="proj">
  <VolunteerProjectThumb image={image} href={href} />
  <div class="body">
    <h3>{href ? <a class="title-link" href={href}>{title}</a> : title}</h3>
    {commitment ? <span class="commit">{commitment}</span> : null}
    {blurb ? <p>{blurb}</p> : null}
    <VolunteerProjectCardLinks href={href} applyUrl={applyUrl} />
  </div>
</article>

<style>
  .proj {
    display: flex;
    flex-direction: column;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 22px 24px;
    flex: 1;
  }
  h3 {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0;
    /* Long titles wrap instead of overflowing the card. */
    overflow-wrap: anywhere;
  }
  .title-link {
    color: inherit;
    text-decoration: none;
  }
  .title-link:hover {
    color: var(--crimson);
  }
  .commit {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--crimson);
  }
  p {
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
    margin: 0;
    flex: 1;
  }
</style>
