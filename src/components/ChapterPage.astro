---
// A single regional chapter page, recomposed to match the live harvardintech.com
// chapter pages: a full-bleed city hero, a teal "Sign Up" band, the narrow
// content block (back link + leads + markdown body + links), an optional event
// photo gallery, and a "Connect With Us" social footer. Accepts plain props so
// it renders from the /chapters/<slug> route (with rendered <Content /> in the
// slot) and from isolated scenarios (NYC with hero/gallery, sparse Japan with no
// hero → centered-header fallback).
import ChapterHero from './ChapterHero.astro';
import ChapterEvents from './ChapterEvents.astro';
import ChapterSignUp from './ChapterSignUp.astro';
import ChapterConnect from './ChapterConnect.astro';
import ChapterLeads from './ChapterLeads.astro';
import ChapterLinks from './ChapterLinks.astro';
import EventGallery from './landing/EventGallery.astro';
import type { EventLike } from '../lib/events';
import { withBase } from '../lib/url';

interface Lead {
  name: string;
  role?: string;
}
interface ChapterLink {
  label: string;
  url: string;
}
interface Props {
  /** Who the page is about: a chapter's city, or a community's name. Named
   *  neutrally because this shell now renders both — `city={name}` at a
   *  community call site would read as a mistake. */
  name: string;
  region?: string;
  blurb?: string;
  heroImage?: string;
  tagline?: string;
  showGallery?: boolean;
  /**
   * This surface's own curated photos. Absent or EMPTY falls back to the shared
   * 40-photo gallery, which is what every chapter showed before this existed —
   * so a chapter nobody has curated looks exactly as it did.
   *
   * /communities renders this same shell and deliberately never passes it,
   * which is what keeps community pages byte-for-byte unchanged.
   */
  photos?: { image?: string; caption?: string }[];
  events?: EventLike[];
  /** Heading over the events list. Defaults to "Upcoming Events in <name>",
   *  which reads wrong for a community ("...in Founders") — /communities passes
   *  its own phrasing. */
  eventsHeading?: string;
  contactEmail?: string;
  leads?: Lead[];
  links?: ChapterLink[];
  /** Where the "back" link at the top of the content block points, and what it
   *  says. Defaults to the chapters row on the home page; a community page
   *  points at the community section instead. */
  backHref?: string;
  backLabel?: string;
}
const {
  name,
  region,
  blurb,
  heroImage,
  tagline,
  showGallery = true,
  photos,
  events = [],
  eventsHeading,
  contactEmail,
  leads = [],
  links = [],
  backHref = '/#events',
  backLabel = '← All chapters',
} = Astro.props;

// The narrow content block (leads + markdown body + links) only renders when
// there is something to show. `hasBody` is detected from the default slot.
const hasBody = Astro.slots.has('default');
const hasContent = leads.length > 0 || links.length > 0 || hasBody;
---

<ChapterHero name={name} region={region} blurb={blurb} heroImage={heroImage} tagline={tagline} />

<ChapterEvents events={events} name={name} heading={eventsHeading} />

<ChapterSignUp />

{
  hasContent ? (
    <section class="s-section">
      <div class="s-narrow">
        <a href={withBase(backHref)} style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em;">
          {backLabel}
        </a>

        <ChapterLeads leads={leads} />

        <div style="line-height: 1.8;">
          <slot />
        </div>

        <ChapterLinks links={links} />
      </div>
    </section>
  ) : null
}

{
  /* An empty `photos` list is treated as absent, not as "an empty gallery":
     the CMS leaves an empty array behind when an editor removes the last row,
     and rendering nothing there would look like a bug rather than a fallback.
     `cap` is passed ONLY here — the landing page stays uncapped. */
  showGallery ? (
    photos?.length ? (
      <EventGallery photos={photos} cap={12} heading={`Photos from ${name}`} />
    ) : (
      <EventGallery />
    )
  ) : null
}

<ChapterConnect email={contactEmail} />
