---
// Givebutter's widget loader script. Renders nothing unless an account id is
// configured, so the default state of the site ships zero third-party markup.
//
// Editors only ever type the account key in the CMS — this template owns the
// script markup, exactly the split `Analytics.astro` makes for the GA4
// measurement id. Givebutter's own instructions say "paste this <script> into
// your <head>", and `customHeadHtml` would take it verbatim today; that box is
// the inject-anything escape hatch, where a typo is a broken <head> on every
// page. A narrow field cannot break page structure. `customHeadHtml` stays
// available for whatever Givebutter asks for next.
//
// Site-wide rather than /donate-only, via HeadExtras: it is the one <head>
// partial every shell includes, so a widget dropped on the homepage or a blog
// post later works with no second wiring step, and no route can silently miss
// the script. `is:inline` for the same reason Analytics uses it — Astro must
// ship the third-party URL untouched rather than trying to bundle it.
import { settings } from '../lib/site';
import { loadIntegrations } from '../lib/integrationsContent';
import { givebutterScriptSrc } from '../lib/givebutter';

const { givebutterAccountId } = await loadIntegrations(settings);
const src = givebutterScriptSrc(givebutterAccountId);
---

{src ? <div id="givebutter-config" data-src={src} hidden /> : null}

{
  /*
    Injected by script rather than emitted as `<script is:inline src>` for the
    same reason Analytics.astro is — see the note there and
    src/lib/embeddedPreview.ts. Short version: from @codeyam/cms 0.14.0 the entry
    editor embeds this page in a pane beside the editing form, so a head tag
    fires once per entry an editor opens. For Givebutter that means a live
    donation form loading inside an editing tool, on entries that have nothing to
    do with donating. Whether a load is a reader or that pane is a query string,
    which a statically built page can only read in the browser.

    The account id rides on a data attribute because a bundled `<script>` is one
    shared module across every page, so a build-time interpolation would freeze
    whatever the first page carried — and this id is editable in the CMS.
  */
}
<script>
  import { loadScriptUnlessEmbedded } from '../lib/embeddedPreview';

  // No account id configured → zero third-party markup, exactly as before;
  // `givebutterScriptSrc` already returns undefined in that case, and the helper
  // treats a missing source and the editor pane the same way.
  const src = document.getElementById('givebutter-config')?.dataset.src;
  loadScriptUnlessEmbedded(document, window.location.search, src);
</script>
