---
// "Board of directors" (Atlas): a five-across grid of square avatars with a
// crimson underline and mono role labels. Members come from the editable `team`
// content collection. When the list is empty the section shows a quiet
// "announced soon" note (production starts empty).
//
// Composition only — the tile itself is `./BoardMemberTile.astro`, so this file
// owns the section heading, the director count, and the empty state, and nothing
// about how one director is drawn.
import type { BoardMemberLike } from '../../lib/team';
import { readMediaManifest } from '../../lib/media';
import BoardMemberTile from './BoardMemberTile.astro';

interface Props {
  members?: BoardMemberLike[];
}
const { members = [] } = Astro.props;

const count = String(members.length).padStart(2, '0');
// Read the library once for the whole grid rather than per headshot.
const media = readMediaManifest();
---

<section class="sec" id="board">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="kick">Leadership</span>
        <h2>Board of directors</h2>
      </div>
      {members.length > 0 && <span class="kick">{count} directors</span>}
    </div>

    {
      members.length === 0 ? (
        <p class="soon">Our board will be announced soon.</p>
      ) : (
        <div class="board">
          {members.map((member) => (
            <BoardMemberTile member={member} media={media} />
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .board {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
  }
  /* The state production actually ships in: no directors entered yet. Was an
     inline `style` attribute while every sibling was styled from this block. */
  .soon {
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-size: 18px;
  }
  @media (max-width: 820px) {
    .board {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 520px) {
    .board {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
