---
// Full /donate page body: the Momentum Fund campaign landing page, built to the
// campaign mockup (Canva export, 2026-07).
//
// Composition only — every section is its own component under
// `components/donate/`. The hero and the closing CTA are a FIXED frame; the
// middle is whatever the `momentumSections` collection says it is, in whatever
// order an editor arranged it. That is what makes "move this section up" an
// Order field rather than a code change, and "remove this section" the Draft
// toggle the editor already knows. The hero and CTA stay out of it on purpose: a
// page whose hero could be dragged to the bottom is a page an editor can break.
//
// `kind` picks the renderer. `narrative` sections carry their own heading, photo,
// and rendered markdown body; the rest are slots whose card data still comes from
// `donatePage.json`, so the bespoke bands keep their tailored design and are
// merely POSITIONED by data.
//
// Takes plain props (copy + already-ordered sections + a flat testimonials
// array) rather than reading the collections, so it renders from the /donate
// route and from isolated-component scenarios — the same split EventsPage.astro
// uses.
import MomentumHero from './donate/MomentumHero.astro';
import MomentumStats from './donate/MomentumStats.astro';
import GoalMeter from './donate/GoalMeter.astro';
import MomentumAccomplishments from './donate/MomentumAccomplishments.astro';
import MomentumNarrative from './donate/MomentumNarrative.astro';
import MomentumMission from './donate/MomentumMission.astro';
import GiftPillars from './donate/GiftPillars.astro';
import MomentumTestimonials from './donate/MomentumTestimonials.astro';
import MomentumNetwork from './donate/MomentumNetwork.astro';
import MomentumClose from './donate/MomentumClose.astro';
import type { TestimonialLike } from './donate/MomentumTestimonials.astro';
import ComingSoon from './ComingSoon.astro';
import { SECTION_LABELS, sectionHeading, sectionKicker, tintedFlags, type SectionKind, type SectionLike } from '../lib/momentumSections';
import { cardsInGroup } from '../lib/sectionGroups';
import { resolveVisibility } from '../lib/homeSections';
import type { DonorLike } from '../lib/donors';
import type { DonatePageCopy } from '../lib/site';

export type { TestimonialLike };

/**
 * One section to render. `Content` is the component `render()` returns for a
 * narrative entry's markdown body; the slot bands have no body to render, so it
 * is optional.
 */
export interface RenderableSection extends SectionLike {
  slug: string;
  Content?: unknown;
}

interface Props {
  copy: DonatePageCopy;
  /** Already draft-filtered and ordered by `orderedSections` — this component
   *  renders the list as given rather than re-sorting it, so a scenario can pin
   *  an arbitrary order to demonstrate reordering. */
  sections?: RenderableSection[];
  testimonials?: TestimonialLike[];
  /** Published donors for the recognition wall, already draft-filtered. Empty in
   *  production today — the wall renders its invitation state, which is the
   *  view most visitors currently get. */
  donors?: DonorLike[];
  email?: string;
  /** Scenario/testing hook: pre-fill the headline as if `?name=` were present.
   *  The real page fills it client-side. */
  previewName?: string;
}
const {
  copy,
  sections = [],
  testimonials = [],
  donors = [],
  email = 'ben@harvardintech.com',
  previewName,
} = Astro.props as Props;

// Which sections sit on the tinted band — computed up front from the whole
// list rather than counted during the render below, so the rule is pure,
// unit-tested, and independent of how the map happens to run.
const tinted = tintedFlags(sections);
---

<MomentumHero
  kicker={copy.heroKicker}
  headlineNamed={copy.heroHeadlineNamed}
  headlineGeneric={copy.heroHeadlineGeneric}
  subhead={copy.heroSubhead}
  image={copy.heroImage}
  video={copy.heroVideo}
  ctaLabel={copy.ctaLabel}
  donateUrl={copy.donateUrl}
  email={email}
  campaignName={copy.campaignName}
  previewName={previewName}
/>

{
  sections.map((section, index) => {
    const Body = section.Content as any;
    // Visibility is decided ahead of the kind switch, and the three states are
    // total here rather than relying on the caller: `hidden` renders nothing and
    // `coming-soon` is replaced wholesale, whatever the band would otherwise
    // have drawn. In practice `publishedEntries` drops a drafted section before
    // it arrives — but a component that rendered a section its own rule calls
    // hidden would be a trap for the next caller.
    if (resolveVisibility(section) === 'hidden') return null;
    if (resolveVisibility(section) === 'coming-soon') {
      return (
        <ComingSoon
          title={section.title ?? SECTION_LABELS[section.kind as SectionKind] ?? 'More to come'}
        />
      );
    }
    switch (section.kind) {
      case 'narrative':
        return (
          <MomentumNarrative
            kicker={sectionKicker(section)}
            title={section.title}
            layout={section.layout}
            image={section.image}
            tinted={tinted[index]}
          >
            {Body ? <Body /> : null}
          </MomentumNarrative>
        );
      // Like `narrative`, this band draws entirely from its own entry — kicker,
      // heading, and body — so it takes no `donatePage.json` fallback.
      case 'mission':
        return (
          <MomentumMission kicker={sectionKicker(section)} title={sectionHeading(section)}>
            {Body ? <Body /> : null}
          </MomentumMission>
        );
      // The section's own `title` is the heading here, not a `donatePage.json`
      // key: the meter has no card data of its own, which puts it closer to
      // `narrative` than to the slot bands in that one respect.
      case 'goal-meter':
        return (
          <GoalMeter
            kicker={sectionKicker(section)}
            title={section.title}
            widgetId={section.widgetId}
            linkLabel={section.linkLabel}
            linkUrl={section.linkUrl}
          />
        );
      // The slot bands select their own cards and name themselves. Both are what
      // make a DUPLICATED section a distinct band rather than a second copy: the
      // heading is the section's own `title` when it has one, and `cardsInGroup`
      // narrows the shared card set to the group this band claims. A section with
      // neither renders exactly what it always did — the full card set under the
      // shared heading — which is why groups ship with no content migration.
      case 'accomplishments':
        return (
          <MomentumAccomplishments
            kicker={sectionKicker(section)}
            title={sectionHeading(section, copy.accomplishmentsTitle)}
            items={cardsInGroup(copy.accomplishments ?? [], section.group)}
          />
        );
      case 'pillars':
        return (
          <GiftPillars
            kicker={sectionKicker(section)}
            title={sectionHeading(section, copy.pillarsTitle)}
            pillars={cardsInGroup(copy.pillars ?? [], section.group)}
          />
        );
      case 'testimonials':
        return (
          <MomentumTestimonials
            kicker={sectionKicker(section)}
            title={sectionHeading(section, copy.testimonialsTitle)}
            testimonials={testimonials}
          >
            {Body ? <Body /> : null}
          </MomentumTestimonials>
        );
      case 'donors':
        return (
          <MomentumNetwork
            kicker={sectionKicker(section)}
            title={sectionHeading(section, copy.donorsTitle)}
            networkTitle={copy.networkTitle}
            tagline={copy.networkTagline}
            searchTitle={copy.networkSearchTitle}
            emptyMessage={copy.donorsEmptyMessage}
            donors={donors}
            tiers={copy.donorTiers ?? []}
            ctaLabel={copy.ctaLabel}
            donateUrl={copy.donateUrl}
            email={email}
            campaignName={copy.campaignName}
            shareTemplate={copy.shareMessage}
          />
        );
      case 'stats':
        return <MomentumStats stats={copy.stats} />;
      // Unreachable in practice — `orderedSections` drops unknown kinds before
      // they reach here. Rendering nothing rather than throwing keeps a typo in
      // one section from taking the whole page down.
      default:
        return null;
    }
  })
}

<MomentumClose
  kicker={copy.ctaKicker}
  title={copy.ctaTitle}
  body={copy.ctaBody}
  image={copy.ctaImage}
  tagline={copy.ctaTagline}
  ctaLabel={copy.ctaLabel}
  donateUrl={copy.donateUrl}
  email={email}
  campaignName={copy.campaignName}
/>
