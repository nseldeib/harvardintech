---
// /volunteer — "Join the Harvard Alumni in Tech Volunteer Team".
//
// Replaces the old nav link to the homepage's `/#get-involved` band with a real
// page. The pitch and benefit blocks are editable copy (`volunteerPage.json`);
// the open-projects grid comes from the `projects` collection, which starts
// EMPTY in production — the page's default view is its empty state.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VolunteerPage from '../components/VolunteerPage.astro';
import { volunteerPage } from '../lib/site';

const projects = (await getCollection('projects')).map((p) => ({
  slug: p.id,
  ...p.data,
}));
---

<BaseLayout
  title="Volunteer"
  description="Harvard in Tech is 100% volunteer-run. Join the volunteer team: gain experience, expand your network, and help the community grow."
>
  <VolunteerPage copy={volunteerPage} projects={projects} />
</BaseLayout>
