---
// /chapters/<slug> — one page per regional chapter. Static output enumerates a
// route per `chapters` collection entry via getStaticPaths; ChapterPage renders
// the frontmatter (city, leads, links) and the markdown body in its slot.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChapterPage from '../../components/ChapterPage.astro';
import { splitEvents, unmatchedChapterTags, type EventLike } from '../../lib/events';
import { publishedEntries } from '../../lib/drafts';

// Drafts get no page of their own in the built site — a chapter dropped from
// the nav but still live at /chapters/<slug> would be public anyway. In dev the
// page is still generated so an author can preview an unannounced chapter.
export async function getStaticPaths() {
  const chapters = publishedEntries(await getCollection('chapters'), !import.meta.env.PROD);
  const chapterIds = chapters.map((chapter) => chapter.id);

  // The one place holding both full lists, so the one place that can notice an
  // event tagged to a chapter that does not exist. The CMS renders `chapter` as
  // a free-text box, so a city name or a stray space typed there passes schema
  // validation and still drops the event off every chapter page. Advisory only:
  // `npm run build` gates the deploy, and refusing to publish over a cosmetic
  // typo would turn one missing event into a dead site update.
  const taggedEvents = publishedEntries(await getCollection('events'), !import.meta.env.PROD);
  const orphanTags = unmatchedChapterTags(
    taggedEvents.map((event) => event.data),
    chapterIds,
  );
  if (orphanTags.length > 0) {
    console.warn(
      `[chapters] ${orphanTags.length} event chapter tag(s) match no chapter and will ` +
        `not appear on any chapter page: ${orphanTags.map((tag) => JSON.stringify(tag)).join(', ')}. ` +
        `Use the chapter's slug (its filename without .md) — one of: ${chapterIds.join(', ')}.`,
    );
  }

  return chapters.map((chapter) => ({
    params: { slug: chapter.id },
    props: { chapter },
  }));
}

type Props = { chapter: CollectionEntry<'chapters'> };
const { chapter } = Astro.props as Props;
const { Content } = await render(chapter);
const { city, region, blurb, heroImage, tagline, showGallery, contactEmail, leads, links } = chapter.data;

// Upcoming events explicitly tagged to this chapter (soonest first). Events with
// no `chapter` (e.g. the Cambridge panel) belong to no chapter and are excluded.
const events = publishedEntries(await getCollection('events'), !import.meta.env.PROD);
const chapterEvents: EventLike[] = events
  .filter((event) => event.data.chapter === chapter.id)
  .map((event) => ({
    slug: event.id,
    title: event.data.title,
    date: event.data.date,
    location: event.data.location,
    description: event.data.description,
    link: event.data.link,
  }));
const { upcoming } = splitEvents(chapterEvents);
---

<BaseLayout title={city} description={blurb ?? `Harvard in Tech ${city} chapter.`}>
  <ChapterPage
    city={city}
    region={region}
    blurb={blurb}
    heroImage={heroImage}
    tagline={tagline}
    showGallery={showGallery}
    events={upcoming}
    contactEmail={contactEmail}
    leads={leads}
    links={links}
  >
    <Content />
  </ChapterPage>
</BaseLayout>
