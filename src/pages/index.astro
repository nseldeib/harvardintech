---
// Harvard Alumni in Tech homepage — Atlas direction.
//
// The page is a band STACK whose order and visibility live in the `homeSections`
// content collection, not in this file. An editor moves a band with its Order
// field, replaces one with a "coming soon" placeholder, or takes it off the
// public site with Draft — and the menu link goes with it (see `BaseLayout`).
// That is the whole reason the thirteen components are no longer hardcoded here.
//
// Content comes from the editable settings singleton and the `events` / `team` /
// `chapters` / `blog` / `heroSlides` / `stats` collections; composition lives in
// `HomeSections`, so this route is data loading plus one element.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { settings } from '../lib/site';
import { publishedEntries } from '../lib/drafts';
import { splitEvents } from '../lib/events';
import { INCLUDE_DRAFTS } from '../lib/draftVisibility';
import { sortBoardMembers, filterActiveBoardMembers } from '../lib/team';
import { loadHomeSections, loadHeroSlides, loadHomeStats } from '../lib/homeSectionsContent';
import HomeSections from '../components/landing/HomeSections.astro';

// Drafts are dropped from every section below. `INCLUDE_DRAFTS` is true under
// `astro dev` and on the review track, false on the public build — so an author
// or reviewer still sees drafts while the published site never does.
const showDrafts = INCLUDE_DRAFTS;

// Only FUTURE events reach the "Upcoming events" band. This route used to hand
// the section every event in the collection, so the heading and its "N
// scheduled" badge described a list that was mostly — and by August 2026,
// entirely — in the past: eight cards under "Upcoming events", the newest a
// month gone and the oldest from October 2024. A visitor reading that learns
// the community has stopped meeting, which is both false and the opposite of
// what the band is for.
//
// `splitEvents` is the same helper `/events` has always used to divide its
// Upcoming and Past sections (EventsPage.astro), so the two routes now agree on
// what "upcoming" means instead of only one of them applying the rule.
//
// When nothing is upcoming the band renders its designed empty state — which
// offers the Luma calendar and the mailing list — rather than a stale list. An
// honest "no upcoming events just yet, subscribe to hear first" is a better
// page than a confident list of things that already happened.
const allEvents = publishedEntries(await getCollection('events'), showDrafts).map((e) => ({
  slug: e.id,
  ...e.data,
}));
const { upcoming: events } = splitEvents(allEvents);

// Regional chapters for the "Our chapters" section, sorted in-component by `order`.
const chapters = publishedEntries(await getCollection('chapters'), showDrafts).map((c) => ({
  slug: c.id,
  ...c.data,
}));

// Latest blog posts for the Content Hub, newest first.
const posts = publishedEntries(await getCollection('blog'), showDrafts)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((p) => ({ slug: p.id, ...p.data }));

// Board of Directors — editable via the CMS `team` collection. Members toggled
// off (`active: false`) are filtered out, then sorted by the `order` field so
// the public board matches the curated sequence; when the resulting list is
// empty the section falls back to the faithful board graphic.
const board = sortBoardMembers(
  filterActiveBoardMembers(
    publishedEntries(await getCollection('team'), showDrafts).map((m) => ({
      slug: m.id,
      ...m.data,
    })),
  ),
);

const { sections, unknownKinds } = await loadHomeSections();
const slides = await loadHeroSlides();
const stats = await loadHomeStats();

// Advisory, never build-failing — `kind` is free text because the CMS has no
// select control, so a typo is an ordinary editing mistake. It costs that editor
// one missing band and this log line, not the deploy. Same treatment /donate
// gives an unrecognized Momentum Fund section type.
if (unknownKinds.length > 0) {
  console.warn(
    `[homeSections] ${unknownKinds.length} homepage section(s) have an unrecognized type and ` +
      `will not appear: ${unknownKinds.map((k) => JSON.stringify(k)).join(', ')}.`,
  );
}
---

<BaseLayout title={undefined} description={settings.description}>
  <HomeSections
    sections={sections}
    slides={slides}
    stats={stats}
    events={events}
    chapters={chapters}
    posts={posts}
    board={board}
    socials={settings.socials}
    email={settings.contactEmail}
  />
</BaseLayout>
