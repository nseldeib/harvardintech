---
// /sponsor — partnership levels, the partner wall, and the inquiry path.
//
// Replaces the nav's old `/#support` anchor into the homepage band, and absorbs
// the two sponsor-shaped cards from that band ("Sponsor an event", "Host us in
// your space"), which are now the Event and Community partnership levels.
//
// Sponsors come from the `sponsors` collection, which starts EMPTY in production
// — the wall's default view is its empty state. Entries flagged `placeholder`
// render behind an explicit "examples, not actual sponsors" notice.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SponsorPage from '../components/SponsorPage.astro';
import { sponsorPage, settings } from '../lib/site';
import { loadSponsorCopy } from '../lib/sponsorPageContent';
import { publishedEntries } from '../lib/drafts';
import { INCLUDE_DRAFTS } from '../lib/draftVisibility';

const sponsors = publishedEntries(
  await getCollection('sponsors'),
  INCLUDE_DRAFTS,
).map((s) => ({
  slug: s.id,
  ...s.data,
}));

// The pitch and the partnership levels now come from content rather than from
// `sponsorPage.json` — the file the CMS does not model. Resolved here so
// `SponsorPage` stays props-only and the isolated-component scenarios keep
// handing it their own copy.
const copy = await loadSponsorCopy(sponsorPage);
---

<BaseLayout
  title="Sponsorship"
  description="Partner with Harvard Alumni in Tech. Sponsor an event, back a city chapter, or host us in your space — and reach the Harvard alumni building in tech."
>
  <SponsorPage copy={copy} sponsors={sponsors} email={settings.contactEmail} />
</BaseLayout>
