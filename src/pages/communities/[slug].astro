---
// /communities/<slug> — one page per interest-based community (Founders, AI),
// the non-geographic counterpart to /chapters/<slug>. Same shape, same
// components, same draft rule; the differences are all naming: a community has
// a `name` where a chapter has a `city`, so the events heading and the back link
// are passed explicitly rather than derived from a place.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChapterPage from '../../components/ChapterPage.astro';
import { splitEvents, eventsTaggedTo } from '../../lib/events';
import { publishedEntries } from '../../lib/drafts';
import { INCLUDE_DRAFTS } from '../../lib/draftVisibility';

// Drafts get no page on the public site — a community dropped from the nav but
// still live at /communities/<slug> would be public anyway. In dev and on the
// review track the page is generated so it can be read before it is announced.
export async function getStaticPaths() {
  const communities = publishedEntries(
    await getCollection('communities'),
    INCLUDE_DRAFTS,
  );

  return communities.map((community) => ({
    params: { slug: community.id },
    props: { community },
  }));
}

type Props = { community: CollectionEntry<'communities'> };
const { community } = Astro.props as Props;
const { Content } = await render(community);
// `photos` is DELIBERATELY absent from this destructure and from the ChapterPage
// call below. A chapter curates its own gallery in /admin and passes it through;
// a community is scoped out of that feature on purpose, so it keeps the shared
// 40-photo event wall every page showed before per-chapter galleries existed.
// The boundary is enforced twice over: the `communities` schema declares no
// `photos` field (src/content/config.ts), so there is nothing on
// `community.data` to forward even if this call site grew the prop.
// `showGallery: false` still hides the section outright, as it does for a chapter.
const { name, blurb, heroImage, tagline, showGallery, contactEmail, leads, links } =
  community.data;

// Events join a community through the same `chapter` tag they use for chapters —
// one "belongs to" field, not two an editor has to choose between. The chapters
// route warns about tags matching neither list, so a typo here is still caught.
const events = publishedEntries(await getCollection('events'), INCLUDE_DRAFTS);
const { upcoming } = splitEvents(eventsTaggedTo(events, community.id));
---

<BaseLayout
  title={name}
  description={blurb ?? `The Harvard Alumni in Tech ${name} community.`}
>
  <ChapterPage
    name={name}
    blurb={blurb}
    heroImage={heroImage}
    tagline={tagline}
    showGallery={showGallery}
    events={upcoming}
    eventsHeading={`Upcoming ${name} Events`}
    contactEmail={contactEmail}
    leads={leads}
    links={links}
    backHref="/#community"
    backLabel="← All communities"
  >
    <Content />
  </ChapterPage>
</BaseLayout>
