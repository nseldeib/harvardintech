---
// /donate — the Momentum Fund campaign landing page.
//
// Replaces the old nav link to the homepage's `/#giving` band. The email
// campaign links here with `?name=<first name>` for a personalized greeting;
// the same URL without a name serves the public/non-subscriber audience, so
// there is no duplicate landing page to keep in sync.
//
// The middle of the page comes from the `momentumSections` collection rather
// than from hardcoded composition, so an editor reorders the page with the Order
// field and hides a section with the Draft toggle. Narrative sections carry
// their own copy as markdown; the rest are slots positioned here but still
// edited as `donatePage.json` copy.
//
// Testimonials come from the `testimonials` collection, which starts EMPTY in
// production — the band renders nothing until real quotes are collected. The
// `donors` collection starts empty the same way, but the donor wall does the
// opposite with it: it renders its invitation state, because an empty donor wall
// is exactly the page a prospective first donor should be looking at.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MomentumFundPage from '../components/MomentumFundPage.astro';
import { donatePage, settings } from '../lib/site';
import { publishedEntries } from '../lib/drafts';
import { INCLUDE_DRAFTS } from '../lib/draftVisibility';
import { loadMomentumSections } from '../lib/momentumSectionsContent';
import { loadDonors } from '../lib/donorsContent';
import {
  loadAccomplishments,
  loadPillars,
  loadDonateUrl,
  loadDonateFrame,
} from '../lib/donatePageContent';

const testimonials = publishedEntries(
  await getCollection('testimonials'),
  INCLUDE_DRAFTS,
).map((t) => ({
  slug: t.id,
  ...t.data,
}));

const donors = await loadDonors();

// Loaded here rather than inside the page component so the component stays
// props-only and the isolated-component scenarios can hand it their own list.
const { sections, unknownKinds } = await loadMomentumSections();

// Advisory, never build-failing — `kind` is free text because the CMS has no
// select control, so a typo is an ordinary editing mistake. It costs that editor
// one missing section and this log line, not the deploy. Same treatment
// `chapters/[slug].astro` gives an orphan event tag.
if (unknownKinds.length > 0) {
  console.warn(
    `[donate] ${unknownKinds.length} Momentum Fund section(s) have an unrecognized type and ` +
      `will not appear on the page: ${unknownKinds.map((k) => JSON.stringify(k)).join(', ')}. ` +
      `Use one of: narrative, accomplishments, pillars, testimonials, stats.`,
  );
}

// The two bespoke card bands, and the giving destination, now come from content
// rather than from `donatePage.json` — the file the CMS does not model, which is
// what made all three developer-only edits. They are grafted back onto the copy
// singleton so `MomentumFundPage` and its children keep the exact props they
// always took, leaving the migration invisible below this line.
const copy = {
  ...donatePage,
  ...(await loadDonateFrame(donatePage)),
  accomplishments: await loadAccomplishments(),
  pillars: await loadPillars(),
  donateUrl: await loadDonateUrl(donatePage.donateUrl),
};
---

<BaseLayout
  title={donatePage.campaignName}
  description="Support Harvard Alumni in Tech. Your monthly gift powers the events, mentorship, and city chapters that help alumni find one another and move further together."
>
  <MomentumFundPage
    copy={copy}
    sections={sections}
    testimonials={testimonials}
    donors={donors}
    email={settings.contactEmail}
  />
</BaseLayout>
