---
// /donate — the Momentum Fund campaign landing page.
//
// Replaces the old nav link to the homepage's `/#giving` band. The email
// campaign links here with `?name=<first name>` for a personalized greeting;
// the same URL without a name serves the public/non-subscriber audience, so
// there is no duplicate landing page to keep in sync.
//
// The middle of the page comes from the `momentumSections` collection rather
// than from hardcoded composition, so an editor reorders the page with the Order
// field and hides a section with the Draft toggle. Narrative sections carry
// their own copy as markdown; the rest are slots positioned here but still
// edited as `donatePage.json` copy.
//
// Testimonials come from the `testimonials` collection, which starts EMPTY in
// production — the band renders nothing until real quotes are collected. The
// `donors` collection starts empty the same way, but the donor wall does the
// opposite with it: it renders its invitation state, because an empty donor wall
// is exactly the page a prospective first donor should be looking at.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MomentumFundPage from '../components/MomentumFundPage.astro';
import { donatePage, settings } from '../lib/site';
import { publishedEntries } from '../lib/drafts';
import { INCLUDE_DRAFTS } from '../lib/draftVisibility';
import { loadMomentumSections } from '../lib/momentumSectionsContent';
import { SECTION_KINDS, goalMetersMissingWidgetId } from '../lib/momentumSections';
import { emptyGroups } from '../lib/sectionGroups';
import { loadDonors } from '../lib/donorsContent';
import {
  loadAccomplishments,
  loadPillars,
  loadDonateUrl,
  loadDonateFrame,
} from '../lib/donatePageContent';

const testimonials = publishedEntries(
  await getCollection('testimonials'),
  INCLUDE_DRAFTS,
).map((t) => ({
  slug: t.id,
  ...t.data,
}));

const donors = await loadDonors();

// Loaded here rather than inside the page component so the component stays
// props-only and the isolated-component scenarios can hand it their own list.
const { sections, unknownKinds } = await loadMomentumSections();

// Advisory, never build-failing. The CMS renders `kind` as a select now, but the
// schema stays free text on purpose, so a value from a hand-edited file or a
// scenario seed costs that editor one missing section and this log line rather
// than the deploy. Same treatment `chapters/[slug].astro` gives an orphan event
// tag.
if (unknownKinds.length > 0) {
  console.warn(
    `[donate] ${unknownKinds.length} Momentum Fund section(s) have an unrecognized type and ` +
      `will not appear on the page: ${unknownKinds.map((k) => JSON.stringify(k)).join(', ')}. ` +
      `Use one of: ${SECTION_KINDS.join(', ')}.`,
  );
}

// The same advisory shape for the goal meter's own half-finished state: a
// published `goal-meter` section with no widget id renders nothing at all, which
// is deliberate but indistinguishable from a section an editor forgot. Naming
// the slug is what makes it diagnosable.
const metersMissingId = goalMetersMissingWidgetId(sections);
if (metersMissingId.length > 0) {
  console.warn(
    `[donate] ${metersMissingId.length} goal meter section(s) have no widget ID and ` +
      `will not appear on the page: ` +
      `${metersMissingId.map((slug) => JSON.stringify(slug)).join(', ')}. ` +
      `Add the widget ID from Givebutter, or switch the section to Draft to hide it deliberately.`,
  );
}

// The two bespoke card bands, and the giving destination, now come from content
// rather than from `donatePage.json` — the file the CMS does not model, which is
// what made all three developer-only edits. They are grafted back onto the copy
// singleton so `MomentumFundPage` and its children keep the exact props they
// always took, leaving the migration invisible below this line.
// Each card set is loaded ONCE, whole, and the page component selects the cards
// for each band from it — rather than re-reading the collection per section.
// Two `pillars` bands are now ordinary, so a per-band read would multiply
// collection queries by however many bands an editor happens to create.
const accomplishments = await loadAccomplishments();
const pillars = await loadPillars();

const copy = {
  ...donatePage,
  ...(await loadDonateFrame(donatePage)),
  accomplishments,
  pillars,
  donateUrl: await loadDonateUrl(donatePage.donateUrl),
};

// The third advisory on this page, same shape as the two above: a published
// section whose `group` matches no card renders an EMPTY band, which is
// deliberate — falling back to every card would make a typo'd group look like it
// worked — but silent, and therefore indistinguishable from a band an editor has
// not filled in yet. The slug is what makes it diagnosable.
const sectionsWithEmptyGroups = emptyGroups(sections, { accomplishments, pillars });
if (sectionsWithEmptyGroups.length > 0) {
  console.warn(
    `[donate] ${sectionsWithEmptyGroups.length} Momentum Fund section(s) name a card group ` +
      `that matches no card and will render an empty band: ` +
      `${sectionsWithEmptyGroups.map((slug) => JSON.stringify(slug)).join(', ')}. ` +
      `Check the Group field on the section against the Group on its cards, or clear it ` +
      `to show the ungrouped cards.`,
  );
}
---

<BaseLayout
  title={donatePage.campaignName}
  description="Support Harvard Alumni in Tech. Your monthly gift powers the events, mentorship, and city chapters that help alumni find one another and move further together."
>
  <MomentumFundPage
    copy={copy}
    sections={sections}
    testimonials={testimonials}
    donors={donors}
    email={settings.contactEmail}
  />
</BaseLayout>
