---
import Component from "../../components/cutover/DecisionTick.tsx";
import type { AuthSession } from "@codeyam/cms/lib/authSession";
import "../../styles/tokens.css";
import "../../styles/cutover-runbook.css";

// Isolation page for DecisionTick — an open decision, seen by a signed-in editor.
// The affordance that matters: somewhere to write down what was decided. D1 has
// been open since 2026-07-02 precisely because its answer was never recorded
// anywhere durable, so this is the control that exists to stop that recurring.
//
// `initialSession` is the scenario seam `useAuthSession` exposes: it pins a
// fixed session instead of consulting the live store, so this page captures the
// same state on every run without a GitHub token and without depending on
// whatever session the preview happens to hold.
//
// A separate page per state rather than one `?s=`-switched page: this is a
// prerendered static build, so query params are empty at build time and a single
// page would capture its default frame for every state.
const TARGET = { owner: 'nseldeib', repo: 'harvardintech', branch: 'staging' };
const SIGNED_IN: AuthSession = { status: 'signed-in', user: { login: 'nseldeib', name: 'Nadia Eldeib', avatarUrl: '' } };
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: DecisionTick</title>
  </head>
  <body style="margin: 0; background: var(--paper-2, #f6f3f1);">
    <div id="codeyam-capture" style="padding: 24px; max-width: 720px;">
      <div class="decision">
        <div class="top">
          <span class="id">D3</span>
          <h3>The board design gallery becomes public. Keep, gate, or remove?</h3>
          <span class="badge b-missing">Blocks S6</span>
        </div>
        <Component
          client:load
          id="D3"
          initialAnswered={false}
          target={TARGET}
          initialSession={SIGNED_IN}
        />
      </div>
    </div>
  </body>
</html>
