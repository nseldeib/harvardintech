---
import Component from "../../../src/components/volunteer/VolunteerProjectCta.astro";
import "../../../src/styles/tokens.css";

// Isolation page for VolunteerProjectCta — codeyam screenshots the #codeyam-capture
// wrapper by navigating to /isolated-components/VolunteerProjectCta.
//
// Shows BOTH branches of `projectCta` side by side, because the difference
// between them is the whole point of the component and a single-branch capture
// would hide the one that matters. Top: a project with its own sign-up link.
// Bottom: Nicole's case — no applyUrl, so it falls back to the page-level
// volunteer CTA rather than leaving the page with no ask at all.
//
// The third branch (neither link → renders nothing) is deliberately absent: it
// has no pixels to capture.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: VolunteerProjectCta</title>
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <div id="codeyam-capture" style="padding: var(--space-lg); display: flex; flex-direction: column; gap: 40px;">
      <Component
        applyUrl="https://hi.switchy.io/wEYK"
        ctaLabel="Volunteer with us"
        ctaUrl="https://hi.switchy.io/wEYK"
      />
      <Component ctaLabel="Volunteer with us" ctaUrl="https://hi.switchy.io/wEYK" />
    </div>
  </body>
</html>
