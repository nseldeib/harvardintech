---
import Component from "../../../src/components/volunteer/VolunteerProjects.astro";
import "../../../src/styles/tokens.css";

// Isolation page for VolunteerProjects — codeyam screenshots the #codeyam-capture wrapper
// by navigating to /isolated-components/VolunteerProjects.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: VolunteerProjects</title>
  </head>
  <body>
    <div id="codeyam-capture">
      <Component
        title="Projects open for volunteers"
        intro="Each project below is looking for help right now. Pick the one that fits your skills and the time you have."
        projects={[
  { slug: 'chapter-launch-team-toronto', title: 'Chapter launch team — Toronto', blurb: 'Help stand up our next city chapter: find a venue, rally the first 30 alumni, and run the launch mixer.', image: '/images/chapters/nyc.jpg', commitment: '~3 hrs / week', applyUrl: 'https://hi.switchy.io/wEYK', order: 1 },
  { slug: 'newsletter-editor', title: 'Newsletter editor', blurb: 'Curate the monthly roundup of member news, events, and opportunities that goes out to the full network.', image: '/images/sections/board.png', commitment: '~2 hrs / month', order: 2 },
  { slug: 'speaker-outreach', title: 'Speaker outreach', blurb: 'Line up founders, operators, and investors for panels and roundtables across all five chapters.', commitment: '~2 hrs / week', applyUrl: 'https://hi.switchy.io/wEYK', order: 3 },
]}
      />
    </div>
  </body>
</html>
