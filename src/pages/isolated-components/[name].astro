    image: '/images/sections/board.png',
    commitment: '~2 hrs / month',
    applyUrl: 'https://hi.switchy.io/wEYK',
    order: 2,
  },
  {
    title: 'Speaker outreach',
    blurb: 'Line up founders, operators, and investors for panels and roundtables across all five chapters.',
    image: '/images/hero/hero.jpg',
    commitment: '~2 hrs / week',
    applyUrl: 'https://hi.switchy.io/wEYK',
    order: 3,
  },
  {
    title: 'Mentorship matching',
    blurb: 'Pair students and early-career alumni with senior members who have been where they are going.',
    image: '/images/sections/whatsapp-banner.jpg',
    commitment: '~4 hrs / month',
    applyUrl: 'https://hi.switchy.io/wEYK',
    order: 4,
  },
  {
    title: 'Website & CRM',
    blurb: 'Keep this site and the organizer tooling healthy: content, accessibility, and the occasional feature.',
    image: '/images/sections/board-logo.png',
    commitment: 'Flexible',
    applyUrl: 'https://hi.switchy.io/wEYK',
    order: 5,
  },
];
const SPARSE_PROJECTS = [
  // No `image` — proves the card keeps its geometry without a thumbnail.
  {
    title: 'Alumni Founders Co-working Day, London monthly host and community organizer',
    blurb: 'Host the monthly London co-working day: book the space, greet arrivals, and keep the day running.',
    commitment: 'One day / month',
    applyUrl: 'https://hi.switchy.io/wEYK',
    order: 1,
  },
  {
    title: 'Photographer',
    image: '/images/gallery/event-01.jpg',
    order: 2,
  },
];
const volunteerPageStates = {
  Default: { copy: VOLUNTEER_COPY, projects: SAMPLE_PROJECTS },
  Sparse: { copy: VOLUNTEER_COPY, projects: SPARSE_PROJECTS },
  Empty: { copy: VOLUNTEER_COPY, projects: [] as typeof SAMPLE_PROJECTS },
};

// MomentumFundPage states. `Default` is the production view: generic greeting,
// no testimonials collected yet. `Personalized` pins the greeting server-side
// (the live page fills it from `?name=` in the browser, which a static capture
// can't exercise). `Quotes` is the complete campaign page.
const MOMENTUM_COPY = donatePage;
const SAMPLE_TESTIMONIALS = [
  {
    quote:
      'I came to a founder dinner knowing nobody. I left with two intros that turned into my first enterprise customer.',
    name: 'Priya Raman',
    role: 'Founder · AB ’14',
    order: 1,
  },
  {
    quote:
      'The London co-working days are the only reason I still feel connected to Harvard on this side of the Atlantic.',
    name: 'Tom Whitfield',
    role: 'Engineering lead · AB ’09',
    order: 2,
  },
  {
    quote:
      'Someone in this network took an hour to talk me out of a bad acquisition. That hour was worth more than any conference.',
    name: 'Dana Osei',
    role: 'Operator · MBA ’18',
    order: 3,
  },
];
const momentumFundStates = {
  Default: { copy: MOMENTUM_COPY, testimonials: [] as typeof SAMPLE_TESTIMONIALS },
  Personalized: {
    copy: MOMENTUM_COPY,
    testimonials: [] as typeof SAMPLE_TESTIMONIALS,
    previewName: 'Nicole',
  },
  Quotes: { copy: MOMENTUM_COPY, testimonials: SAMPLE_TESTIMONIALS },
};

export async function getStaticPaths() {
  // getStaticPaths runs in an isolated scope and cannot reference the
  // module-level consts — enumerate route names inline.
  return [
    { params: { name: 'Greeting' } },
    { params: { name: 'EmbedForm' } },
    { params: { name: 'EmbedForm-Embedded' } },
    { params: { name: 'EmbedForm-Unconfigured' } },
    { params: { name: 'EventsPage' } },
    { params: { name: 'EventsPage-Empty' } },
    { params: { name: 'ChapterPage' } },
    { params: { name: 'ChapterPage-Sparse' } },
    { params: { name: 'ChapterHero' } },
    { params: { name: 'ChapterHero-Fallback' } },
    { params: { name: 'ChapterEvents' } },
    { params: { name: 'ChapterEvents-Empty' } },
    { params: { name: 'ChapterSignUp' } },
    { params: { name: 'ChapterConnect' } },
    { params: { name: 'ChapterConnect-Email' } },
    { params: { name: 'BoardMemberCard' } },
    { params: { name: 'BoardMemberCard-Initials' } },
    { params: { name: 'ContactUs' } },
    { params: { name: 'Hero' } },
    { params: { name: 'WhatsappCommunity' } },
    { params: { name: 'GetInvolved' } },
    { params: { name: 'SupportUs' } },
    { params: { name: 'EventGallery' } },
    { params: { name: 'UpcomingEvents' } },
    { params: { name: 'UpcomingEvents-Empty' } },
    { params: { name: 'BoardOfDirectors' } },
    { params: { name: 'BoardOfDirectors-Empty' } },
    { params: { name: 'HeroCarousel' } },
    { params: { name: 'Stats' } },
    { params: { name: 'OurChapters' } },
    { params: { name: 'OurChapters-Empty' } },
    { params: { name: 'PrimaryNav' } },
    { params: { name: 'PrimaryNav-SixChapters' } },
    { params: { name: 'PrimaryNav-NoChapters' } },
    { params: { name: 'UtilityBar' } },
    { params: { name: 'UtilityBar-Empty' } },
    { params: { name: 'FocusAreas' } },
    { params: { name: 'ContentHub' } },
    { params: { name: 'ContentHub-Empty' } },
    { params: { name: 'GivingCampaign' } },
    { params: { name: 'LumaCalendar' } },
    { params: { name: 'VolunteerPage' } },
    { params: { name: 'VolunteerPage-Sparse' } },
    { params: { name: 'VolunteerPage-Empty' } },
    { params: { name: 'MomentumFundPage' } },
    { params: { name: 'MomentumFundPage-Personalized' } },
    { params: { name: 'MomentumFundPage-Quotes' } },
  ];
}

const { name } = Astro.params;
// The `islands` registry above holds each hydrated island's preview props. The
// island component itself is rendered DIRECTLY in the template below (not
// through a variable). Astro generates a `client:*` hydration script by
// statically tracing the rendered component back to its import; a component
// referenced through a runtime variable (`<Island />`) can't be traced and
// fails the static build with `[NoMatchingImport]`. Adding a hydrated island
// therefore means BOTH a registry entry here AND a direct render branch.

// Resolve the EmbedForm visual state from the route name suffix.
let embedFormProps: (typeof embedFormStates)[keyof typeof embedFormStates] | null = null;
if (name && name.startsWith('EmbedForm')) {
  const stateKey = (name === 'EmbedForm' ? 'Configured' : name.slice('EmbedForm-'.length)) as keyof typeof embedFormStates;
  embedFormProps = embedFormStates[stateKey] ?? embedFormStates.Configured;
}

let eventsPageProps: (typeof eventsPageStates)[keyof typeof eventsPageStates] | null = null;
if (name && name.startsWith('EventsPage')) {
  const stateKey = (name === 'EventsPage' ? 'Default' : name.slice('EventsPage-'.length)) as keyof typeof eventsPageStates;
  eventsPageProps = eventsPageStates[stateKey] ?? eventsPageStates.Default;
}

let chapterPageProps: (typeof chapterPageStates)[keyof typeof chapterPageStates] | null = null;
if (name && name.startsWith('ChapterPage')) {
  const stateKey = (name === 'ChapterPage' ? 'Default' : name.slice('ChapterPage-'.length)) as keyof typeof chapterPageStates;
  chapterPageProps = chapterPageStates[stateKey] ?? chapterPageStates.Default;
}

// ChapterHero resolves its state from the route suffix; ChapterSignUp /
// ChapterConnect are single-state (the latter reads the settings singleton).
let chapterHeroProps: (typeof chapterHeroStates)[keyof typeof chapterHeroStates] | null = null;
if (name && name.startsWith('ChapterHero')) {
  const stateKey = (name === 'ChapterHero' ? 'Default' : name.slice('ChapterHero-'.length)) as keyof typeof chapterHeroStates;
  chapterHeroProps = chapterHeroStates[stateKey] ?? chapterHeroStates.Default;
}

// ChapterEvents resolves its state from the route suffix (Default rich list vs
// Empty no-events guard).
let chapterEventsProps: (typeof chapterEventsStates)[keyof typeof chapterEventsStates] | null = null;
if (name && name.startsWith('ChapterEvents')) {
  const stateKey = (name === 'ChapterEvents' ? 'Default' : name.slice('ChapterEvents-'.length)) as keyof typeof chapterEventsStates;
  chapterEventsProps = chapterEventsStates[stateKey] ?? chapterEventsStates.Default;
}

const isChapterSignUp = name === 'ChapterSignUp';

// ChapterConnect resolves Default (settings email) vs Email (per-chapter override).
let chapterConnectProps: (typeof chapterConnectStates)[keyof typeof chapterConnectStates] | null = null;
if (name && name.startsWith('ChapterConnect')) {
  const stateKey = (name === 'ChapterConnect' ? 'Default' : name.slice('ChapterConnect-'.length)) as keyof typeof chapterConnectStates;
  chapterConnectProps = chapterConnectStates[stateKey] ?? chapterConnectStates.Default;
}

let boardMemberCardProps: (typeof boardMemberCardStates)[keyof typeof boardMemberCardStates] | null = null;
if (name && name.startsWith('BoardMemberCard')) {
  const stateKey = (name === 'BoardMemberCard' ? 'Default' : name.slice('BoardMemberCard-'.length)) as keyof typeof boardMemberCardStates;
  boardMemberCardProps = boardMemberCardStates[stateKey] ?? boardMemberCardStates.Default;
}

let contactUsProps: (typeof contactUsStates)[keyof typeof contactUsStates] | null = null;
if (name && name.startsWith('ContactUs')) {
  const stateKey = (name === 'ContactUs' ? 'Default' : name.slice('ContactUs-'.length)) as keyof typeof contactUsStates;
  contactUsProps = contactUsStates[stateKey] ?? contactUsStates.Default;
}

let primaryNavProps: (typeof primaryNavStates)[keyof typeof primaryNavStates] | null = null;
if (name && name.startsWith('PrimaryNav')) {
  const stateKey = (name === 'PrimaryNav' ? 'Default' : name.slice('PrimaryNav-'.length)) as keyof typeof primaryNavStates;
  primaryNavProps = primaryNavStates[stateKey] ?? primaryNavStates.Default;
}

let utilityBarProps: (typeof utilityBarStates)[keyof typeof utilityBarStates] | null = null;
if (name && name.startsWith('UtilityBar')) {
  const stateKey = (name === 'UtilityBar' ? 'Default' : name.slice('UtilityBar-'.length)) as keyof typeof utilityBarStates;
  utilityBarProps = utilityBarStates[stateKey] ?? utilityBarStates.Default;
}

let upcomingEventsProps: (typeof upcomingEventsStates)[keyof typeof upcomingEventsStates] | null = null;
if (name && name.startsWith('UpcomingEvents')) {
  const stateKey = (name === 'UpcomingEvents' ? 'Default' : name.slice('UpcomingEvents-'.length)) as keyof typeof upcomingEventsStates;
  upcomingEventsProps = upcomingEventsStates[stateKey] ?? upcomingEventsStates.Default;
}

let boardOfDirectorsProps: (typeof boardOfDirectorsStates)[keyof typeof boardOfDirectorsStates] | null = null;
if (name && name.startsWith('BoardOfDirectors')) {
  const stateKey = (name === 'BoardOfDirectors' ? 'Default' : name.slice('BoardOfDirectors-'.length)) as keyof typeof boardOfDirectorsStates;
  boardOfDirectorsProps = boardOfDirectorsStates[stateKey] ?? boardOfDirectorsStates.Default;
}

let ourChaptersProps: (typeof ourChaptersStates)[keyof typeof ourChaptersStates] | null = null;
if (name && name.startsWith('OurChapters')) {
  const stateKey = (name === 'OurChapters' ? 'Default' : name.slice('OurChapters-'.length)) as keyof typeof ourChaptersStates;
  ourChaptersProps = ourChaptersStates[stateKey] ?? ourChaptersStates.Default;
}

let contentHubProps: (typeof contentHubStates)[keyof typeof contentHubStates] | null = null;
if (name && name.startsWith('ContentHub')) {
  const stateKey = (name === 'ContentHub' ? 'Default' : name.slice('ContentHub-'.length)) as keyof typeof contentHubStates;
  contentHubProps = contentHubStates[stateKey] ?? contentHubStates.Default;
}

let volunteerPageProps: (typeof volunteerPageStates)[keyof typeof volunteerPageStates] | null = null;
if (name && name.startsWith('VolunteerPage')) {
  const stateKey = (name === 'VolunteerPage' ? 'Default' : name.slice('VolunteerPage-'.length)) as keyof typeof volunteerPageStates;
  volunteerPageProps = volunteerPageStates[stateKey] ?? volunteerPageStates.Default;
}

let momentumFundProps: (typeof momentumFundStates)[keyof typeof momentumFundStates] | null = null;
if (name && name.startsWith('MomentumFundPage')) {
  const stateKey = (name === 'MomentumFundPage' ? 'Default' : name.slice('MomentumFundPage-'.length)) as keyof typeof momentumFundStates;
  momentumFundProps = momentumFundStates[stateKey] ?? momentumFundStates.Default;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: {name}</title>
  </head>
  <body>
    <div id="codeyam-capture" style="padding: var(--space-lg);">
      {
        name === 'Greeting' ? (
          <Greeting {...islands.Greeting.props} client:load />
        ) : embedFormProps ? (
          <EmbedForm {...embedFormProps} />
        ) : volunteerPageProps ? (
          <VolunteerPage {...volunteerPageProps} />
        ) : momentumFundProps ? (
          <MomentumFundPage {...momentumFundProps} />
        ) : eventsPageProps ? (
          <EventsPage {...eventsPageProps} />
        ) : chapterPageProps ? (
          <ChapterPage {...chapterPageProps}>
            <p>
              A representative "about this chapter" paragraph rendered in the
              markdown body slot, so the isolated capture matches the real route.
            </p>
          </ChapterPage>
        ) : chapterHeroProps ? (
          <ChapterHero {...chapterHeroProps} />
        ) : chapterEventsProps ? (
          <ChapterEvents {...chapterEventsProps} />
        ) : isChapterSignUp ? (
          <ChapterSignUp />
        ) : chapterConnectProps ? (
          <ChapterConnect {...chapterConnectProps} />
        ) : boardMemberCardProps ? (
          <div style="width: 200px;">
            <BoardMemberCard {...boardMemberCardProps} />
          </div>
        ) : contactUsProps ? (
          <div style="width: 960px; max-width: 100%;">
            <ContactUs {...contactUsProps} />
          </div>
        ) : name === 'Hero' ? (
          <Hero />
        ) : name === 'HeroCarousel' ? (
          <HeroCarousel />
        ) : name === 'Stats' ? (
          <Stats />
        ) : primaryNavProps ? (
          <div class="nav-stage">
            <PrimaryNav {...primaryNavProps} />
          </div>
        ) : utilityBarProps ? (
          <UtilityBar {...utilityBarProps} />
        ) : ourChaptersProps ? (
          <OurChapters {...ourChaptersProps} />
        ) : name === 'FocusAreas' ? (
          <FocusAreas />
        ) : contentHubProps ? (
          <ContentHub {...contentHubProps} />
        ) : name === 'GivingCampaign' ? (
          <GivingCampaign />
        ) : name === 'LumaCalendar' ? (
          <LumaCalendar />
        ) : name === 'WhatsappCommunity' ? (
          <WhatsappCommunity />
        ) : name === 'GetInvolved' ? (
          <GetInvolved />
        ) : name === 'SupportUs' ? (
          <SupportUs />
        ) : name === 'EventGallery' ? (
          <EventGallery />
        ) : upcomingEventsProps ? (
          <UpcomingEvents {...upcomingEventsProps} />
        ) : boardOfDirectorsProps ? (
          <BoardOfDirectors {...boardOfDirectorsProps} />
        ) : (
          <p>Unknown component: {name}</p>
        )
      }
    </div>

    <!-- Capture staging for PrimaryNav: room for the absolutely positioned mega
         panel, which would otherwise overflow a content-height page. Sizing
         only — the panel itself is opened by the scenario's real hover
         interaction, not by a CSS override, so the capture exercises the same
         :hover path a visitor takes. `.nav-stage` exists solely on the
         PrimaryNav routes, so these rules are inert everywhere else. -->
    <style is:global>
      .nav-stage {
        background: #fff;
        min-height: 340px;
        padding-left: 120px;
      }
    </style>
  </body>
</html>
