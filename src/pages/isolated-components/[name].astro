import PrimaryNav from '../../components/nav/PrimaryNav.astro';
import UtilityBar from '../../components/nav/UtilityBar.astro';
import { loadMomentumSections } from '../../lib/momentumSectionsContent';
import {
  chapterNavItems,
  withChapterGroup,
  communityNavItems,
  withCommunityItems,
} from '../../lib/nav';
import { volunteerPage, donatePage, sponsorPage } from '../../lib/site';
import '../../styles/tokens.css';

// Component-isolation harness. codeyam captures a single component in isolation
// by navigating to `/isolated-components/<Name>` and screenshotting the
// `#codeyam-capture` wrapper. Add new entries to make a component isolable.
//
// Two flavors: React islands (hydrated via `client:load`) and static Astro
// components (server-rendered, no hydration). Static output enumerates routes
// at build time, so every name is a pre-rendered page via `getStaticPaths`.
const islands = {
  Greeting: { Component: Greeting, props: { name: 'Preview', subtitle: 'Isolated island' } },
} as const;

// Static Astro components. A prerendered page can't read `?s=` query params at
// render time, so each visual state is its own route name (`EmbedForm`,
// `EmbedForm-Embedded`, `EmbedForm-Unconfigured`) enumerated in getStaticPaths.
const embedFormStates = {
  Configured: {
    action: 'https://harvardintech.us1.list-manage.com/subscribe/post?u=abc123&id=def456',
    title: 'Join the Harvard Alumni in Tech newsletter',
    buttonLabel: 'Subscribe',
  },
  Embedded: {
    embedUrl: 'https://docs.google.com/forms/d/e/EXAMPLE_FORM_ID/viewform?embedded=true',
    title: 'RSVP: Harvard Alumni in Tech Summit 2026',
  },
  Unconfigured: {
    title: 'Subscribe',
  },
} as const;

// EventsPage states. `now` is fixed so the Upcoming/Past split is deterministic
// regardless of the build date. The Empty state proves the no-events fallback.
const SAMPLE_EVENTS = [
  {
    title: 'Harvard Alumni in Tech Summit 2026',
    date: '2026-09-24',
    location: 'New York, NY',
    description: 'Our flagship annual gathering of Harvard founders, operators, and investors.',
    link: 'https://www.harvardintech.com/events/summit-2026',
  },
  {
    title: 'Founders & Investors Mixer, San Francisco',
    date: '2026-07-15',
    location: 'San Francisco, CA',
    description: 'An evening connecting Harvard alumni founders with active investors across the Bay Area.',
    link: 'https://www.harvardintech.com/events/sf-mixer',
  },
  {
    title: 'Spring Founder Dinner, NYC',
    date: '2026-03-12',
    location: 'New York, NY',
    description: 'An intimate dinner with Harvard alumni founders and operators.',
    link: 'https://www.harvardintech.com/events/spring-founder-dinner',
  },
];
// NOTE: no `as const` — these fixtures feed components whose props are mutable
// arrays (`EventLike[]`), so a deeply-readonly literal would fail the type check.
const eventsPageStates = {
  Default: { events: SAMPLE_EVENTS, now: '2026-06-13' },
  Empty: { events: [] as typeof SAMPLE_EVENTS, now: '2026-06-13' },
};

// ChapterPage states: a full NYC-style chapter — full-bleed city hero, Sign Up
// band, leads/body/links, gallery, and Connect With Us — vs a sparse one
// (city + region only, NO heroImage) proving the centered-header fallback and
// the missing-optional layout.
const chapterPageStates = {
  Default: {
    name: 'New York City',
    region: 'New York, NY',
    blurb: 'Our founding chapter and largest community, hosting monthly mixers, founder dinners, and the annual Harvard Alumni in Tech Summit.',
    heroImage: '/images/chapters/nyc.jpg',
    tagline: 'We are the New York Chapter of Harvard Alumni in Tech.',
    showGallery: true,
    leads: [
      { name: 'Jessica Li', role: 'Chapter Lead' },
      { name: 'Ben Wei', role: 'Events' },
    ],
    links: [
      { label: 'Join the NYC WhatsApp', url: 'https://chat.whatsapp.com/harvardintech-nyc' },
      { label: 'NYC events on Eventbrite', url: 'https://www.eventbrite.com/o/harvard-in-tech-17275560304' },
    ],
  },
  Sparse: {
    name: 'Japan',
    region: 'Tokyo',
  },
};

// ChapterHero states: the full-bleed city header WITH a hero image + tagline
// vs the no-image Fallback that degrades to the centered ChapterHeader.
const chapterHeroStates = {
  Default: {
    name: 'New York City',
    region: 'New York, NY',
    heroImage: '/images/chapters/nyc.jpg',
    tagline: 'We are the New York Chapter of Harvard Alumni in Tech.',
  },
  Fallback: {
    name: 'Japan',
    region: 'Tokyo',
    blurb: 'Our first international chapter.',
  },
};

// ChapterEvents states: the per-chapter "Upcoming Events in {name}" section.
// Default shows a rich, multi-card list (mirrors the SF chapter page); Empty
// passes no events to prove the guard renders NOTHING (no empty heading/block);
// Community overrides the heading, because a community is not a place and the
// default phrasing would read "Upcoming Events in Founders".
const SAMPLE_CHAPTER_EVENTS = [
  {
    title: 'Founders & Investors Mixer, San Francisco',
    date: '2026-07-15',
    location: 'San Francisco, CA',
    description: 'An evening connecting Harvard alumni founders with active investors across the Bay Area.',
    link: 'https://www.harvardintech.com/events/sf-mixer',
  },
  {
    title: 'SF Chapter Summer Social',
    date: '2026-08-20',
    location: 'San Francisco, CA',
    description: 'Casual drinks and conversation for Bay Area alumni building in tech.',
    link: 'https://www.harvardintech.com/events/sf-summer-social',
  },
];
const SAMPLE_COMMUNITY_EVENTS = [
  {
    title: 'Founder Dinner: Going From Zero To One',
    date: '2026-07-22',
    location: 'New York, NY',
    description: 'A small-table dinner for alumni founders in the first year of building.',
    link: 'https://www.harvardintech.com/events/founder-dinner',
  },
  {
    title: 'Fundraising AMA With Alumni Investors',
    date: '2026-09-09',
    location: 'Online',
    description: 'Candid answers on pre-seed and seed rounds from investors across the alumni network.',
    link: 'https://www.harvardintech.com/events/fundraising-ama',
  },
];
const chapterEventsStates = {
  Default: { events: SAMPLE_CHAPTER_EVENTS, name: 'San Francisco' },
  Empty: { events: [] as typeof SAMPLE_CHAPTER_EVENTS, name: 'Los Angeles' },
  Community: {
    events: SAMPLE_COMMUNITY_EVENTS,
    name: 'Founders',
    heading: 'Upcoming Founders Events',
  },
};

// ChapterConnect states: Default reads the global settings contact email;
// Email passes a per-chapter `email` override (the SF chapter's address),
// proving the override branch wins over the settings fallback.
const chapterConnectStates = {
  Default: {},
  Email: { email: 'risdhillon@harvardintech.com' },
} as const;

// BoardMemberCard states: a member WITH a photo (the real board headshot) vs a
// member with NO photo, proving the initials-avatar fallback branch.
const boardMemberCardStates = {
  Default: {
    member: { name: 'Krysia Lenzo', role: "Executive Director · Harvard C'12", photo: '/images/team/krysia-lenzo.png', order: 3 },
  },
  Initials: {
    member: { name: 'Ada Lovelace', role: "Advisor · Harvard C'15", order: 6 },
  },
} as const;

// ContactUs states: the live "CONTACT US" section with its real downloaded
// social icons (Twitter / E-mail / Facebook) rendered icon-over-label. The
// e-mail entry is always synthesized from `email`, so the Default state shows
// all three icons exactly as on harvardintech.com.
const contactUsStates = {
  Default: {
    socials: [
      { label: 'Twitter', url: 'https://twitter.com/harvardintech', icon: 'twitter' },
      { label: 'Facebook', url: 'https://facebook.com/harvardintech', icon: 'facebook' },
      { label: 'Email', url: 'mailto:ben@harvardintech.com', icon: 'email' },
    ],
    email: 'ben@harvardintech.com',
  },
} as const;

// Landing-page section components composed by the Home route (index.astro).
// Hero / WhatsappCommunity / GetInvolved / SupportUs / EventGallery have all-
// optional props, so each renders one Default state from its component defaults.
// The two data-driven sections also get an Empty variant proving their fallback:
// UpcomingEvents (no-events guard) and BoardOfDirectors (board graphic when the
// member list is empty).
const SAMPLE_BOARD = [
  { name: 'Ben Wei', role: "Founder · Harvard C'08", photo: '/images/team/ben-wei.png', order: 1, active: true },
  { name: 'Peter Boyce', role: "Founder · Harvard C'13", photo: '/images/team/peter-boyce.png', order: 2, active: true },
  { name: 'Krysia Lenzo', role: "Executive Director · Harvard C'12", photo: '/images/team/krysia-lenzo.png', order: 3, active: true },
  { name: 'Jessica Li', role: "Board Member · Harvard C'16", photo: '/images/team/jessica-li.png', order: 4, active: true },
  { name: 'Nadia Eldeib', role: "Board Member · Harvard C'14", photo: '/images/team/nadia-eldeib.png', order: 5, active: true },
];
// Bios, at the two lengths that actually stress the row. `Default` above carries
// none, which mirrors production: every director ships with an empty bio, so the
// no-bio grid is the state that renders today, not a hypothetical.
//
// The bios themselves are illustrative, not the real ones — nobody has written
// those yet, and inventing biography for a named real person and shipping it as
// content would be worse than leaving the field blank. They exist to size the
// layout.
const BOARD_BIOS = [
  'Founded Harvard Alumni in Tech in 2013 and has guided it from a single Boston meetup to a global network of six chapters.',
  'Backs early-stage founders and helped start the community that became the New York chapter.',
  'Runs the organization day to day — the programming calendar, the chapter leads, and the volunteer team that makes both work. Before Harvard Alumni in Tech she spent a decade building community programs in the nonprofit sector, which is where the six-chapter structure the group uses today came from.',
  'Works on the content side, from the newsletter to the Content Hub.',
  'Leads growth, building the programs and partnerships that bring alumni into the community and keep them there.',
];
const upcomingEventsStates = {
  Default: { events: SAMPLE_EVENTS },
  Empty: { events: [] as typeof SAMPLE_EVENTS },
};
const boardOfDirectorsStates = {
  Default: { members: SAMPLE_BOARD },
  Empty: { members: [] as typeof SAMPLE_BOARD },
  // Every director written up, including one deliberately much longer than the
  // rest — the cards do not stretch to match, so this is what proves the row
  // survives an uneven set rather than only a tidy one.
  Bios: { members: SAMPLE_BOARD.map((m, i) => ({ ...m, bio: BOARD_BIOS[i] })) },
  // The realistic in-between: two of five written. This is the state the board
  // will actually be in for as long as it takes to collect the other three, and
  // the one where a layout that reserves space for a missing bio looks broken.
  SomeBios: {
    members: SAMPLE_BOARD.map((m, i) => (i === 0 || i === 4 ? { ...m, bio: BOARD_BIOS[i] } : m)),
  },
};

// OurChapters (Atlas "Our chapters" band): Default renders the six-city row;
// Empty proves the "coming soon" fallback (production starts with no chapters).
//
// Mirrors the committed chapters, INCLUDING the absence of an `order` on every
// entry — that is what makes the roster sort alphabetically by city, so a
// fixture that re-pinned them would show an order the real site never renders.
const SAMPLE_CHAPTERS = [
  { slug: 'boston-cambridge', city: 'Boston & Cambridge', blurb: 'Home of Harvard, our Cambridge and Boston community.', heroImage: '/images/bg/hero-bg.jpg' },
  { slug: 'dc-dmv', city: 'DC and DMV Area', blurb: 'The DC, Maryland & Virginia community.', heroImage: '/images/gallery/event-18.jpg' },
  { slug: 'london', city: 'London', blurb: 'Our European hub across the London tech scene.', heroImage: '/images/gallery/event-05.jpg' },
  { slug: 'nyc', city: 'New York City', blurb: 'Our founding chapter and largest community.', heroImage: '/images/chapters/nyc.jpg' },
  { slug: 'seattle', city: 'Seattle / Pacific Northwest', blurb: 'The Pacific Northwest chapter.', heroImage: '/images/gallery/event-27.jpg' },
  { slug: 'sf-bay-area', city: 'SF & Bay Area', blurb: 'Our West Coast chapter across San Francisco and Silicon Valley.', heroImage: '/images/chapters/san-francisco.jpg' },
];
const ourChaptersStates = {
  Default: { chapters: SAMPLE_CHAPTERS },
  Empty: { chapters: [] as typeof SAMPLE_CHAPTERS },
};

// PrimaryNav / UtilityBar. These states are built by running the REAL derivation
// (`chapterNavItems` + `withChapterGroup`) over the chapter fixtures above, so
// the isolated preview shows what the header actually does — not a hand-written
// menu that could quietly disagree with the code.
//
// The hand-authored half is `nav.json` minus its old Chapters group, pinned as a
// literal here so the states stay deterministic when someone edits the real nav.
const AUTHORED_NAV_ITEMS = [
  { label: 'Programs', children: [{ label: 'All Events', url: '/events' }] },
  { label: 'Communities', children: [{ label: 'WhatsApp', url: '/#community' }] },
  {
    label: 'Content Hub',
    children: [
      { label: 'Blog', url: '/blog/welcome' },
      { label: 'Medium', url: 'https://medium.com/harvard-in-tech' },
    ],
  },
  {
    label: 'Membership',
    children: [
      { label: 'About', children: [{ label: 'Mission', url: '/#about' }, { label: 'Board', url: '/#board' }] },
      { label: 'Support', children: [{ label: 'Donate', url: '/donate' }] },
    ],
  },
];
// A chapter that `nav.json` has never heard of — the drift the derivation
// removes. It appears purely because it exists in the collection.
const SIXTH_CHAPTER = { slug: 'miami', city: 'Miami', order: 6 };

// The committed communities. Like the chapters they carry no `order`, so the
// menu sorts them alphabetically: AI before Founders.
const SAMPLE_COMMUNITIES = [
  { slug: 'founders', name: 'Founders' },
  { slug: 'ai', name: 'AI' },
];

// Every state runs BOTH real derivations in the order the layout runs them, so
// the isolated menu is the menu the site builds — Chapters injected as its own
// group, communities merged into the authored Communities group behind WhatsApp.
const derivedNav = (
  chapters: { slug: string; city: string; order?: number }[],
  communities: { slug: string; name: string; order?: number }[],
) =>
  withCommunityItems(
    withChapterGroup(AUTHORED_NAV_ITEMS, chapterNavItems(chapters)),
    communityNavItems(communities),
  );

const primaryNavStates = {
  Default: { items: derivedNav(SAMPLE_CHAPTERS, SAMPLE_COMMUNITIES) },
  SixChapters: {
    items: derivedNav([...SAMPLE_CHAPTERS, SIXTH_CHAPTER], SAMPLE_COMMUNITIES),
  },
  // The day-one menu: no chapters and no communities published, so both derived
  // sets are empty and only the hand-authored items remain.
  NoChapters: { items: derivedNav([], []) },
};
const utilityBarStates = {
  Default: { cities: chapterNavItems(SAMPLE_CHAPTERS).map((i) => i.label) },
  Empty: { cities: [] as string[] },
};

// ContentHub (Atlas "Content hub" band): Default shows the four channels plus a
// "latest from the blog" list; Empty omits posts (channels only).
const SAMPLE_POSTS = [
  { slug: 'welcome', title: 'Welcome to the new Harvard Alumni in Tech', date: '2026-06-01', summary: 'A fresh home for our community, events, and chapters.' },
  { slug: 'summit-recap', title: 'Recap: Harvard Alumni in Tech Summit 2026', date: '2026-05-12', summary: 'Highlights from a day of talks, panels, and networking.' },
  { slug: 'new-chapters', title: 'Announcing our London and Seattle chapters', date: '2026-04-20', summary: 'The network keeps growing across the map.' },
];
const contentHubStates = {
  Default: { posts: SAMPLE_POSTS },
  Empty: { posts: [] as typeof SAMPLE_POSTS },
};

// VolunteerPage states. Production starts with NO open projects, so `Empty` is
// the state most visitors actually see — not an edge case. `Sparse` is the
// real-world-messy one: a project with no thumbnail next to one with a very
// long title, proving the grid stays aligned and the title wraps.
const VOLUNTEER_COPY = volunteerPage;
const SAMPLE_PROJECTS = [
  {
    title: 'Chapter launch team, Toronto',
    blurb: 'Help stand up our next city chapter: find a venue, rally the first 30 alumni, and run the launch mixer.',
    image: '/images/chapters/nyc.jpg',
    commitment: '~3 hrs / week',
    applyUrl: 'https://hi.switchy.io/wEYK',
    order: 1,
  },
  {
    title: 'Newsletter editor',
    blurb: 'Curate the monthly roundup of member news, events, and opportunities that goes out to the full network.',
    image: '/images/sections/board.png',
    commitment: '~2 hrs / month',
    applyUrl: 'https://hi.switchy.io/wEYK',
    order: 2,
  },
  {
    title: 'Speaker outreach',
    blurb: 'Line up founders, operators, and investors for panels and roundtables across all five chapters.',
    image: '/images/hero/hero.jpg',
    commitment: '~2 hrs / week',
    applyUrl: 'https://hi.switchy.io/wEYK',
    order: 3,
  },
  {
    title: 'Mentorship matching',
    blurb: 'Pair students and early-career alumni with senior members who have been where they are going.',
    image: '/images/sections/whatsapp-banner.jpg',
    commitment: '~4 hrs / month',
    applyUrl: 'https://hi.switchy.io/wEYK',
    order: 4,
  },
  {
    title: 'Website & CRM',
    blurb: 'Keep this site and the organizer tooling healthy: content, accessibility, and the occasional feature.',
    image: '/images/sections/board-logo.png',
    commitment: 'Flexible',
    applyUrl: 'https://hi.switchy.io/wEYK',
    order: 5,
  },
];
const SPARSE_PROJECTS = [
  // No `image` — proves the card keeps its geometry without a thumbnail.
  {
    title: 'Alumni Founders Co-working Day, London monthly host and community organizer',
    blurb: 'Host the monthly London co-working day: book the space, greet arrivals, and keep the day running.',
    commitment: 'One day / month',
    applyUrl: 'https://hi.switchy.io/wEYK',
    order: 1,
  },
  {
    title: 'Photographer',
    image: '/images/gallery/event-01.jpg',
    order: 2,
  },
];
const volunteerPageStates = {
  Default: { copy: VOLUNTEER_COPY, projects: SAMPLE_PROJECTS },
  Sparse: { copy: VOLUNTEER_COPY, projects: SPARSE_PROJECTS },
  Empty: { copy: VOLUNTEER_COPY, projects: [] as typeof SAMPLE_PROJECTS },
};

// MomentumFundPage states. `Default` is the production view: generic greeting,
// no testimonials collected yet. `Personalized` pins the greeting server-side
// (the live page fills it from `?name=` in the browser, which a static capture
// can't exercise). `Quotes` is the complete campaign page.
const MOMENTUM_COPY = donatePage;
const SAMPLE_TESTIMONIALS = [
  {
    quote:
      'I came to a founder dinner knowing nobody. I left with two intros that turned into my first enterprise customer.',
    name: 'Priya Raman',
    role: 'Founder · AB ’14',
    order: 1,
  },
  {
    quote:
      'The London co-working days are the only reason I still feel connected to Harvard on this side of the Atlantic.',
    name: 'Tom Whitfield',
    role: 'Engineering lead · AB ’09',
    order: 2,
  },
  {
    quote:
      'Someone in this network took an hour to talk me out of a bad acquisition. That hour was worth more than any conference.',
    name: 'Dana Osei',
    role: 'Operator · MBA ’18',
    order: 3,
  },
];
// The real published sections, loaded through the same pipeline the /donate
// route uses — so these captures show the page an editor would actually get,
// not a fixture that could quietly disagree with the collection.
const { sections: MOMENTUM_SECTIONS } = await loadMomentumSections();

// "An editor moved a section": the same sections with the story pulled above the
// accomplishments band, which is what changing one Order field in the CMS does.
// It is the whole point of making the page a collection, so it gets its own
// capture rather than being described in prose nobody can see.
const REORDERED_SECTIONS = [
  ...MOMENTUM_SECTIONS.filter((s) => s.kind === 'narrative'),
  ...MOMENTUM_SECTIONS.filter((s) => s.kind !== 'narrative'),
];

const momentumFundStates = {
  Default: {
    copy: MOMENTUM_COPY,
    sections: MOMENTUM_SECTIONS,
    testimonials: [] as typeof SAMPLE_TESTIMONIALS,
  },
  Personalized: {
    copy: MOMENTUM_COPY,
    sections: MOMENTUM_SECTIONS,
    testimonials: [] as typeof SAMPLE_TESTIMONIALS,
    previewName: 'Nicole',
  },
  Quotes: {
    copy: MOMENTUM_COPY,
    sections: MOMENTUM_SECTIONS,
    testimonials: SAMPLE_TESTIMONIALS,
  },
  Reordered: {
    copy: MOMENTUM_COPY,
    sections: REORDERED_SECTIONS,
    testimonials: [] as typeof SAMPLE_TESTIMONIALS,
  },
};

// MomentumNarrative states — the four layouts, so each is verifiable on its own
// rather than only as part of the whole page. `NoImage` is the guard that
// matters: an image layout with no photo must fall back to full-width prose
// instead of rendering a blank column, which is the state a section is in the
// moment an editor picks a layout before choosing a picture.
const NARRATIVE_TITLE = 'And Every Number Represents a Story';
const narrativeStates = {
  Default: {
    title: NARRATIVE_TITLE,
    layout: 'image-left',
    image: '/images/gallery/event-15.jpg',
    tinted: true,
  },
  ImageRight: {
    title: 'Why Support Harvard Alumni in Tech?',
    layout: 'image-right',
    image: '/images/gallery/event-04.jpg',
  },
  TextOnly: { title: NARRATIVE_TITLE, layout: 'text-only' },
  NoImage: { title: NARRATIVE_TITLE, layout: 'image-left' },
};

// MomentumAccomplishments: the campaign's track record. Reads the real copy, so
// the capture shows the figures the page actually publishes rather than invented
// ones — the whole point of the section is that the numbers are true.
const accomplishmentsStates = {
  Default: {
    title: donatePage.accomplishmentsTitle,
    items: donatePage.accomplishments ?? [],
  },
};

// SponsorPage / SponsorWall states.
//
// The three wall states are NOT variations of one another — each says something
// different about whether the organization has partners:
//   • Examples  — the committed content today: sample entries behind the
//     "not actual sponsors" notice.
//   • Empty     — the production default the moment the examples are deleted,
//     and the state a visitor sees before any partnership is signed.
//   • Real      — the state the page is FOR: named partners, no notice, and the
//     entries become real links.
const SPONSOR_COPY = sponsorPage;
const EXAMPLE_SPONSORS = [
  { slug: 'example-presenting', name: 'Example Presenting Partner', tier: 'presenting', placeholder: true, order: 1 },
  { slug: 'example-chapter', name: 'Example Chapter Partner', tier: 'chapter', placeholder: true, order: 2 },
  { slug: 'example-event', name: 'Example Event Partner', tier: 'event', placeholder: true, order: 3 },
];
