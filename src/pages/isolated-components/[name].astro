  const stateKey = (name === 'MomentumFundPage' ? 'Default' : name.slice('MomentumFundPage-'.length)) as keyof typeof momentumFundStates;
  momentumFundProps = momentumFundStates[stateKey] ?? momentumFundStates.Default;
}

let narrativeProps: (typeof narrativeStates)[keyof typeof narrativeStates] | null = null;
if (name && name.startsWith('MomentumNarrative')) {
  const stateKey = (name === 'MomentumNarrative' ? 'Default' : name.slice('MomentumNarrative-'.length)) as keyof typeof narrativeStates;
  narrativeProps = narrativeStates[stateKey] ?? narrativeStates.Default;
}

// SponsorPage must be tested BEFORE the narrower Sponsor* prefixes below would
// swallow it — `startsWith('Sponsor')` alone would match every one of them.
let sponsorPageProps: (typeof sponsorPageStates)[keyof typeof sponsorPageStates] | null = null;
if (name && name.startsWith('SponsorPage')) {
  const stateKey = (name === 'SponsorPage' ? 'Default' : name.slice('SponsorPage-'.length)) as keyof typeof sponsorPageStates;
  sponsorPageProps = sponsorPageStates[stateKey] ?? sponsorPageStates.Default;
}

let sponsorLevelsProps: (typeof sponsorLevelsStates)[keyof typeof sponsorLevelsStates] | null = null;
if (name && name.startsWith('SponsorLevels')) {
  sponsorLevelsProps = sponsorLevelsStates.Default;
}

let sponsorWallProps: (typeof sponsorWallStates)[keyof typeof sponsorWallStates] | null = null;
if (name && name.startsWith('SponsorWall')) {
  const stateKey = (name === 'SponsorWall' ? 'Default' : name.slice('SponsorWall-'.length)) as keyof typeof sponsorWallStates;
  sponsorWallProps = sponsorWallStates[stateKey] ?? sponsorWallStates.Default;
}

let sponsorInquiryProps: (typeof sponsorInquiryStates)[keyof typeof sponsorInquiryStates] | null = null;
if (name && name.startsWith('SponsorInquiry')) {
  const stateKey = (name === 'SponsorInquiry' ? 'Default' : name.slice('SponsorInquiry-'.length)) as keyof typeof sponsorInquiryStates;
  sponsorInquiryProps = sponsorInquiryStates[stateKey] ?? sponsorInquiryStates.Default;
}

let accomplishmentsProps: (typeof accomplishmentsStates)[keyof typeof accomplishmentsStates] | null = null;
if (name && name.startsWith('MomentumAccomplishments')) {
  accomplishmentsProps = accomplishmentsStates.Default;
}

// `DonorWallEmpty` and `DonorWallIntro` must both be tested BEFORE `DonorWall`,
// which would otherwise swallow them by prefix — the same ordering trap
// `SponsorPage` has above.
let donorWallEmptyProps: (typeof donorWallEmptyStates)[keyof typeof donorWallEmptyStates] | null = null;
if (name && name.startsWith('DonorWallEmpty')) {
  donorWallEmptyProps = donorWallEmptyStates.Default;
}

let donorWallProps: (typeof donorWallStates)[keyof typeof donorWallStates] | null = null;
if (name && !donorWallEmptyProps && !name.startsWith('DonorWallIntro') && name.startsWith('DonorWall')) {
  const stateKey = (name === 'DonorWall' ? 'Default' : name.slice('DonorWall-'.length)) as keyof typeof donorWallStates;
  donorWallProps = donorWallStates[stateKey] ?? donorWallStates.Default;
}

let momentumNetworkProps: (typeof momentumNetworkStates)[keyof typeof momentumNetworkStates] | null = null;
if (name && name.startsWith('MomentumNetwork')) {
  const stateKey = (
    name === 'MomentumNetwork' ? 'Default' : name.slice('MomentumNetwork-'.length)
  ) as keyof typeof momentumNetworkStates;
  momentumNetworkProps = momentumNetworkStates[stateKey] ?? momentumNetworkStates.Default;
}

let donorCardProps: (typeof donorCardStates)[keyof typeof donorCardStates] | null = null;
if (name && name.startsWith('DonorCard')) {
  const stateKey = (name === 'DonorCard' ? 'Default' : name.slice('DonorCard-'.length)) as keyof typeof donorCardStates;
  donorCardProps = donorCardStates[stateKey] ?? donorCardStates.Default;
}

let donorAvatarProps: (typeof donorAvatarStates)[keyof typeof donorAvatarStates] | null = null;
if (name && name.startsWith('DonorAvatar')) {
  const stateKey = (name === 'DonorAvatar' ? 'Default' : name.slice('DonorAvatar-'.length)) as keyof typeof donorAvatarStates;
  donorAvatarProps = donorAvatarStates[stateKey] ?? donorAvatarStates.Default;
}

let donorWallIntroProps: (typeof donorWallIntroStates)[keyof typeof donorWallIntroStates] | null = null;
if (name && name.startsWith('DonorWallIntro')) {
  const stateKey = (name === 'DonorWallIntro' ? 'Default' : name.slice('DonorWallIntro-'.length)) as keyof typeof donorWallIntroStates;
  donorWallIntroProps = donorWallIntroStates[stateKey] ?? donorWallIntroStates.Default;
}

let donorTierChipsProps: (typeof donorTierChipsStates)[keyof typeof donorTierChipsStates] | null = null;
if (name && name.startsWith('DonorTierChips')) {
  donorTierChipsProps = donorTierChipsStates.Default;
}

let donorTierBandProps: (typeof donorTierBandStates)[keyof typeof donorTierBandStates] | null = null;
if (name && name.startsWith('DonorTierBand')) {
  const stateKey = (name === 'DonorTierBand' ? 'Default' : name.slice('DonorTierBand-'.length)) as keyof typeof donorTierBandStates;
  donorTierBandProps = donorTierBandStates[stateKey] ?? donorTierBandStates.Default;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: {name}</title>
  </head>
  <body>
    <div id="codeyam-capture" style="padding: var(--space-lg);">
      {
        name === 'Greeting' ? (
          <Greeting {...islands.Greeting.props} client:load />
        ) : embedFormProps ? (
          <EmbedForm {...embedFormProps} />
        ) : sponsorPageProps ? (
          <SponsorPage {...sponsorPageProps} />
        ) : sponsorLevelsProps ? (
          <SponsorLevels {...sponsorLevelsProps} />
        ) : sponsorWallProps ? (
          <SponsorWall {...sponsorWallProps} />
        ) : sponsorInquiryProps ? (
          <SponsorInquiry {...sponsorInquiryProps} />
        ) : accomplishmentsProps ? (
          <MomentumAccomplishments {...accomplishmentsProps} />
        ) : donorWallEmptyProps ? (
          <DonorWallEmpty {...donorWallEmptyProps} />
        ) : donorWallIntroProps ? (
          <div style="width: 1180px; max-width: 100%;">
            <DonorWallIntro {...donorWallIntroProps} />
          </div>
        ) : momentumNetworkProps ? (
          /* The network is a FULL-BLEED band on /donate — it runs edge to edge
             and constrains its own contents with `.wrap`, like every other
             section here. The harness wraps captures in `--space-lg` of padding,
             which framed the band in whitespace and showed a floating card that
             does not exist on the real page; the negative margin cancels exactly
             that padding so the isolated capture matches the shipped band. */
          <div style="margin: calc(var(--space-lg) * -1);">
            <MomentumNetwork {...momentumNetworkProps} />
          </div>
        ) : donorWallProps ? (
          <DonorWall {...donorWallProps} />
        ) : donorCardProps ? (
          <div style="width: 340px;">
            <DonorCard {...donorCardProps} />
          </div>
        ) : donorAvatarProps ? (
          <DonorAvatar {...donorAvatarProps} />
        ) : donorTierChipsProps ? (
          <div style="width: 1180px; max-width: 100%;">
            <DonorTierChips {...donorTierChipsProps} />
          </div>
        ) : donorTierBandProps ? (
          <div style="width: 1180px; max-width: 100%;">
            <DonorTierBand {...donorTierBandProps} />
          </div>
        ) : name === 'FoundingBadge' ? (
          <FoundingBadge />
        ) : narrativeProps ? (
          <MomentumNarrative {...narrativeProps}>
            <p>
              Behind every event, chapter, and member of our network is an
              opportunity for a conversation, introduction, or shared experience
              that has helped Harvard alumni in tech move forward.
            </p>
            <blockquote>
              <p>
                Sometimes, the most meaningful opportunities begin with a single
                conversation.
              </p>
            </blockquote>
            <p>
              An introduction to someone who has been where you are going. A
              roundtable where a new idea becomes sharper. A community gathering
              that turns a shared interest into a lasting collaboration.
            </p>
            <p>
              Harvard Alumni in Tech exists to create more of these moments, the
              kind that help alumni find one another, support one another, and
              move further together.
            </p>
          </MomentumNarrative>
        ) : volunteerPageProps ? (
          <VolunteerPage {...volunteerPageProps} />
        ) : momentumFundProps ? (
          <MomentumFundPage {...momentumFundProps} />
        ) : eventsPageProps ? (
          <EventsPage {...eventsPageProps} />
        ) : chapterPageProps ? (
          <ChapterPage {...chapterPageProps}>
            <p>
              A representative "about this chapter" paragraph rendered in the
              markdown body slot, so the isolated capture matches the real route.
            </p>
          </ChapterPage>
        ) : chapterHeroProps ? (
          <ChapterHero {...chapterHeroProps} />
        ) : chapterEventsProps ? (
          <ChapterEvents {...chapterEventsProps} />
        ) : isChapterSignUp ? (
          <ChapterSignUp />
        ) : chapterConnectProps ? (
          <ChapterConnect {...chapterConnectProps} />
        ) : boardMemberCardProps ? (
          <div style="width: 200px;">
            <BoardMemberCard {...boardMemberCardProps} />
          </div>
        ) : contactUsProps ? (
          <div style="width: 960px; max-width: 100%;">
            <ContactUs {...contactUsProps} />
          </div>
        ) : name === 'Hero' ? (
          <Hero />
        ) : name === 'HeroCarousel' ? (
          <HeroCarousel />
        ) : name === 'Stats' ? (
          <Stats />
        ) : primaryNavProps ? (
          <div class:list={['nav-stage', name === 'PrimaryNav-CommunitiesOpen' && 'nav-stage--communities-open']}>
            <PrimaryNav {...primaryNavProps} />
          </div>
        ) : utilityBarProps ? (
          <UtilityBar {...utilityBarProps} />
        ) : ourChaptersProps ? (
          <OurChapters {...ourChaptersProps} />
        ) : name === 'FocusAreas' ? (
          <FocusAreas />
        ) : contentHubProps ? (
          <ContentHub {...contentHubProps} />
        ) : name === 'GivingCampaign' ? (
          <GivingCampaign />
        ) : name === 'LumaCalendar' ? (
          <LumaCalendar />
        ) : name === 'WhatsappCommunity' ? (
          <WhatsappCommunity />
        ) : name === 'GetInvolved' ? (
          <GetInvolved />
        ) : name === 'SupportUs' ? (
          <SupportUs />
        ) : name === 'EventGallery' ? (
          <EventGallery />
        ) : upcomingEventsProps ? (
          <UpcomingEvents {...upcomingEventsProps} />
        ) : boardOfDirectorsProps ? (
          <BoardOfDirectors {...boardOfDirectorsProps} />
        ) : (
          <p>Unknown component: {name}</p>
        )
      }
    </div>

    <!-- Capture staging for PrimaryNav: room for the absolutely positioned mega
         panel, which would otherwise overflow a content-height page. `.nav-stage`
         exists solely on the PrimaryNav routes, so these rules are inert
         everywhere else.

         The `--communities-open` variant pins ONE panel open for capture. The
         panel is normally revealed by `:hover` / `:focus-within`, and a scenario
         `interactions` hover or click does not survive the screenshot on this
         route (it reports `interactionEffect: none` and captures the resting
         menu) — so a scenario relying on the interaction shows a CLOSED menu and
         demonstrates nothing. Pinning the state is what makes the derived
         Communities items visible in the captured frame. It overrides only the
         two properties the reveal animates, so what renders is what a visitor
         sees mid-hover, not a bespoke layout. -->
    <style is:global>
      .nav-stage {
        background: #fff;
        min-height: 340px;
        padding-left: 120px;
      }
      .nav-stage--communities-open .links > .nav-item:nth-child(3) .mega {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
      }
    </style>
  </body>
</html>
