---
import Component from "../../../src/components/volunteer/VolunteerHero.astro";
import "../../../src/styles/tokens.css";

// Isolation page for VolunteerHero — codeyam screenshots the #codeyam-capture wrapper
// by navigating to /isolated-components/VolunteerHero.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: VolunteerHero</title>
  </head>
  <body>
    <div id="codeyam-capture">
      <Component
        kicker="Get involved"
        image="/images/bg/get-involved-bg.jpg"
        headline="Join the Harvard Alumni in Tech Volunteer Team"
        intro="Harvard in Tech is 100% volunteer-run. Our volunteers are the heart of HIT's mission, connecting and empowering the Harvard tech community and beyond."
        ctaLabel="Volunteer with us"
        ctaUrl="https://hi.switchy.io/wEYK"
      />
    </div>
  </body>
</html>
