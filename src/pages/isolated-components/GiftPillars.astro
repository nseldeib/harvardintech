---
import Component from "../../../src/components/donate/GiftPillars.astro";
import "../../../src/styles/tokens.css";

// Isolation page for GiftPillars — codeyam screenshots the #codeyam-capture wrapper
// by navigating to /isolated-components/GiftPillars.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: GiftPillars</title>
  </head>
  <body>
    <div id="codeyam-capture">
      <Component kicker="What your gift powers" title="Three ways support moves the Harvard Alumni in Tech community forward." pillars={[
  {
    title: 'Create Meaningful Connections',
    body: 'Support events, roundtables, and gatherings that help alumni build valuable relationships and discover new opportunities.',
    linkLabel: 'Check out our past events',
    linkUrl: '/events',
  },
  {
    title: 'Expand Access to Knowledge',
    body: 'Power practical content, mentorship, and conversations that help founders, innovators, and technology professionals grow.',
  },
  {
    title: 'Strengthen the Network',
    body: 'Build the infrastructure, volunteer resources, and city chapters needed to serve more alumni and sustain the community.',
  },
]} />
    </div>
  </body>
</html>
