---
import Component from "../../../src/components/donate/MomentumStory.astro";
import "../../../src/styles/tokens.css";

// Isolation page for MomentumStory — codeyam screenshots the #codeyam-capture wrapper
// by navigating to /isolated-components/MomentumStory.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: MomentumStory</title>
  </head>
  <body>
    <div id="codeyam-capture">
      <Component
        title="And Every Number Represents a Story"
        lede="Behind every event, chapter, and member of our network is an opportunity for a conversation, introduction, or shared experience that has helped Harvard alumni in tech move forward."
        pullQuote="Sometimes, the most meaningful opportunities begin with a single conversation."
        paragraphs={[
          'An introduction to someone who has been where you are going. A roundtable where a new idea becomes sharper. A community gathering that turns a shared interest into a lasting collaboration.',
          'A moment of encouragement that reminds someone they are not building alone.',
          'Harvard Alumni in Tech exists to create more of these moments, the kind that help alumni find one another, support one another, and move further together.',
        ]}
      />
    </div>
  </body>
</html>
