---
import Component from "../../../src/components/donate/PillarIcon.astro";
import "../../../src/styles/tokens.css";

// Isolation page for PillarIcon — codeyam screenshots the #codeyam-capture wrapper
// by navigating to /isolated-components/PillarIcon.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: PillarIcon</title>
  </head>
  <body>
    <div id="codeyam-capture">
      {/* All three variants side by side — the component takes one icon, so the
          capture shows the full set the CMS dropdown can choose from. */}
      <div style="display: flex; gap: 20px; padding: 24px;">
        <Component icon="people" />
        <Component icon="book" />
        <Component icon="globe" />
      </div>
    </div>
  </body>
</html>
