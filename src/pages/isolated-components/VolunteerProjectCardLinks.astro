---
import Component from "../../../src/components/volunteer/VolunteerProjectCardLinks.astro";
import "../../../src/styles/tokens.css";

// Isolation page for VolunteerProjectCardLinks — codeyam screenshots the
// #codeyam-capture wrapper by navigating to /isolated-components/VolunteerProjectCardLinks.
//
// The three combinations a real grid produces, at card width:
//   both links — a project with a detail page and its own sign-up form
//   detail only — Nicole's case, no applyUrl yet
//   apply only — a card rendered without a slug (an isolated state), which is
//                exactly how every card looked before detail pages existed
//
// Stacked rather than inline is the layout decision under test: two uppercase
// mono links on one row wrap raggedly at the narrow end of the grid.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: VolunteerProjectCardLinks</title>
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <div id="codeyam-capture" style="padding: var(--space-lg); display: flex; gap: 24px; align-items: flex-start;">
      <div style="width: 320px; background: var(--paper-2); border: 1px solid var(--line); border-radius: 6px; padding: 22px;">
        <Component href="/volunteer/projects/chapter-launch-team-toronto" applyUrl="https://hi.switchy.io/wEYK" />
      </div>
      <div style="width: 320px; background: var(--paper-2); border: 1px solid var(--line); border-radius: 6px; padding: 22px;">
        <Component href="/volunteer/projects/social-media-marketing-specialist-events" />
      </div>
      <div style="width: 320px; background: var(--paper-2); border: 1px solid var(--line); border-radius: 6px; padding: 22px;">
        <Component applyUrl="https://hi.switchy.io/wEYK" />
      </div>
    </div>
  </body>
</html>
