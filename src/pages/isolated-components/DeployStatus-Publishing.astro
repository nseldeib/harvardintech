---
import Component from "@codeyam/cms/components/admin/DeployStatus.tsx";
import "../../styles/tokens.css";

// Isolation page for DeployStatus mid-deploy — the state Nicole is in for the
// 1-3 minutes a GitHub Actions build takes.
//
// The thing to look at is the button on the right: it reads "Keep editing" and
// it is ENABLED. Before this change it read "Working…" and was disabled until
// the deploy reached a terminal stage, inside a fixed full-screen scrim — so on
// this site, where the watch could never reach one, the admin was unusable from
// the moment she published until she reloaded the page.
//
// `state` is a plain prop (the component never polls), which is what lets this
// page pin one stage with no GitHub token and no live repo.
//
// A separate page per state rather than one `?s=`-switched page: this is a
// prerendered static build, so query params are empty at build time and a single
// page would capture its default frame for every state.
const TARGET = { owner: 'nseldeib', repo: 'harvardintech', branch: 'staging' };
const COMMIT_URL = 'https://github.com/nseldeib/harvardintech/commit/a0dec62273d5ec475ae0825ed31184a84447c6f1';
const SITE_URL = 'https://nseldeib.github.io/harvardintech-staging';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: DeployStatus - Publishing</title>
  </head>
  <body style="margin: 0; background: var(--color-bg, #fff);">
    <!-- Full-viewport wrapper: the panel is `position: fixed`, so a
         content-sized capture box would frame an empty page. -->
    <div id="codeyam-capture" style="min-height: 100vh;">
      <Component
        client:load
        repo={TARGET}
        siteUrl={SITE_URL}
        commitUrl={COMMIT_URL}
        state={{ stage: 'building' }}
      />
    </div>
  </body>
</html>
