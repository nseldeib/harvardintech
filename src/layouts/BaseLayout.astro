---
// The site-wide shell: <head> meta (via SEO), a data-driven header/nav, and a
// footer built from the editable `settings` singleton.
//
// ATLAS DIRECTION (board-selected redesign): a crimson utility bar over an
// editorial nav row — wordmark left, a taxonomy mega-menu (Programs / Chapters
// / Communities / Content Hub / Membership) center, a Subscribe CTA right.
// Menu items, socials, the contact email, and the footer text are all data
// edits to `src/data/*.json` (via the CMS), never markup changes.
import { getCollection } from 'astro:content';
import '../styles/tokens.css';
import SEO from '../components/SEO.astro';
import HeadExtras from '../components/HeadExtras.astro';
import UtilityBar from '../components/nav/UtilityBar.astro';
import PrimaryNav from '../components/nav/PrimaryNav.astro';
import { settings, nav } from '../lib/site';
import {
  chapterNavItems,
  withChapterGroup,
  communityNavItems,
  withCommunityItems,
  withoutHiddenSections,
} from '../lib/nav';
import { hiddenSectionAnchors } from '../lib/homeSections';
import { loadHomeSections } from '../lib/homeSectionsContent';
import { loadIntegrations } from '../lib/integrationsContent';
import { publishedEntries } from '../lib/drafts';
import { INCLUDE_DRAFTS } from '../lib/draftVisibility';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Forwarded to `<SEO />` — set by the routes that can render a preview page.
   * See the prop's own documentation there for why the PreviewGate's noindex is
   * not enough on its own. */
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;

// The Chapters dropdown is derived from the collection, not hand-listed in
// `nav.json` — publishing a chapter is the only step needed to put it in the
// menu. Drafts stay visible while authoring and on the review track, and are
// absent from the public site — the same rule every other route applies.
const chapters = publishedEntries(
  await getCollection('chapters'),
  INCLUDE_DRAFTS,
).map((c) => ({ slug: c.id, ...c.data }));
const chapterItems = chapterNavItems(chapters);

// Communities are derived the same way, but merged INTO the Communities group
// an editor already keeps in `nav.json` rather than injected as a new group —
// the hand-authored WhatsApp link stays first, the published communities follow.
const communities = publishedEntries(
  await getCollection('communities'),
  INCLUDE_DRAFTS,
).map((c) => ({ slug: c.id, ...c.data }));
const communityItems = communityNavItems(communities);

// Homepage bands an editor hid take their menu links with them. Done in the
// LAYOUT rather than on the homepage because the header renders on every page:
// a link to a hidden band is just as broken in the /events header as in the
// homepage's own. Read through the same loader the homepage uses, so the menu
// and the page can never disagree about which bands exist.
const { sections: homeSections } = await loadHomeSections();

// Custom body HTML can't live in <head>, so each shell injects it itself right
// before </body>. Same source as the head half in `HeadExtras`.
const { customBodyHtml } = await loadIntegrations(settings);

const navItems = withoutHiddenSections(
  withCommunityItems(withChapterGroup(nav.items, chapterItems), communityItems),
  hiddenSectionAnchors(homeSections),
);

// The crimson utility strip reads as a one-line "where we are". It reads the
// derived chapter labels directly, so it can no longer go stale behind the
// collection the way a hunt for a nav group by label could.
const utilCities = chapterItems.map((c) => c.label);

const subscribeUrl = 'https://mailchi.mp/0222623e1169/fbrj32e9wb';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* One stylesheet request for all three families — a second <link> would be
        a second round trip on a render-blocking resource. `display=swap` keeps
        text visible in the fallback face while the webfonts load, which matters
        more here than usual: the fallbacks are metric-DIFFERENT from what
        replaces them (Times for Crimson Pro, Helvetica for Inter), so a blocking
        load would leave the hero blank rather than merely reflowing it.
        Weights are pinned to what the tokens actually use — 400/600/700/800 for
        display and body — rather than a full variable range nobody renders. */}
    <link
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <SEO title={title} description={description} image={image} noindex={noindex} />
    <HeadExtras />
  </head>
  <body>
    <UtilityBar cities={utilCities} />

    <header class="site-nav">
      <a class="brand" href={withBase('/')}>
        <img
          class="brand-shield"
          src={withBase('/images/harvard-shield.png')}
          alt=""
          width="26"
          height="26"
        />
        <span class="brand-word">Harvard Alumni in Tech</span>
      </a>

      <PrimaryNav items={navItems} />

      <a class="btn btn-solid nav-cta" href={subscribeUrl} rel="noopener">Subscribe</a>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot-in">
        <div class="foot-brand">
          <span class="kick" style="color:#fff">Harvard Alumni in Tech</span>
          <p class="foot-copy">{settings.footerText}</p>
        </div>
        <div class="foot-links">
          <a href={`mailto:${settings.contactEmail}`}>{settings.contactEmail}</a>
          {
            settings.socials.map((s) => (
              <a href={s.url} rel="noopener">
                {s.label}
              </a>
            ))
          }
        </div>
      </div>
    </footer>

    <style>
      .site-nav {
        position: relative;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 11px 48px;
        background: #fff;
        border-bottom: 1px solid var(--line);
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        flex: none;
      }
      .brand:hover {
        text-decoration: none;
      }
      .brand-shield {
        display: block;
        height: 26px;
        width: auto;
      }
      .brand-word {
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--ink);
        font-size: 16px;
        white-space: nowrap;
      }

      .nav-cta {
        flex: none;
        padding: 10px 18px;
        font-size: 12px;
      }

      /* Footer */
      .site-foot {
        background: var(--ink);
        color: #cfcacb;
      }
      .foot-in {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        padding: 34px 48px;
      }
      .foot-copy {
        margin: 8px 0 0;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .foot-links {
        display: flex;
        align-items: center;
        gap: 18px;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .foot-links a {
        color: #fff;
        text-decoration: none;
      }
      .foot-links a:hover {
        color: var(--crimson);
      }

      /* The menu half of this breakpoint (.links / .mega) lives in PrimaryNav,
         since Astro scopes styles to the component that declares the markup. */
      @media (max-width: 1040px) {
        .site-nav {
          flex-wrap: wrap;
          padding: 16px 24px;
        }
      }
      @media (max-width: 720px) {
        .foot-in {
          flex-direction: column;
          align-items: flex-start;
          padding: 28px 24px;
        }
        .foot-links {
          flex-wrap: wrap;
        }
      }
    </style>

    {customBodyHtml ? <Fragment set:html={customBodyHtml} /> : null}
  </body>
</html>
