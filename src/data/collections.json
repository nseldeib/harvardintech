            { "name": "role", "label": "Role", "type": "text", "optional": true }
          ]
        },
        {
          "name": "links",
          "label": "Links",
          "type": "list",
          "optional": true,
          "fields": [
            { "name": "label", "label": "Label", "type": "text" },
            { "name": "url", "label": "URL", "type": "text" }
          ]
