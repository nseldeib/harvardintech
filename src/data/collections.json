{
  "collections": [
    {
      "id": "chapters",
      "label": "Chapters",
      "singular": "Chapter",
      "fields": [
        {
          "name": "city",
          "label": "City",
          "type": "text"
        },
        {
          "name": "region",
          "label": "Region",
          "type": "text",
          "optional": true
        },
        {
          "name": "blurb",
          "label": "Blurb",
          "type": "textarea",
          "optional": true,
          "hint": "Short summary shown on the Our Chapters cards."
        },
        {
          "name": "heroImage",
          "label": "Hero image",
          "type": "image",
          "optional": true,
          "hint": "Full-bleed city header background. Blank falls back to the centered header."
        },
        {
          "name": "tagline",
          "label": "Tagline",
          "type": "text",
          "optional": true,
          "hint": "Subtitle beneath the \"HARVARD IN TECH <CITY>\" title."
        },
        {
          "name": "showGallery",
          "label": "Show event gallery",
          "type": "boolean",
          "optional": true,
          "hint": "Blank shows the gallery; switch off to hide it on this chapter."
        },
        {
          "name": "contactEmail",
          "label": "Contact email",
          "type": "text",
          "optional": true,
          "hint": "Blank falls back to the global contact email in Settings."
        },
        {
          "name": "order",
          "label": "Order",
          "type": "number",
          "optional": true,
          "hint": "Optional pin. Blank sorts the chapter alphabetically by city."
        },
        {
          "name": "leads",
          "label": "Chapter leads",
          "type": "list",
          "optional": true,
          "fields": [
            {
              "name": "name",
              "label": "Name",
              "type": "text"
            },
            {
              "name": "role",
              "label": "Role",
              "type": "text",
              "optional": true
            }
          ]
        },
        {
          "name": "links",
          "label": "Links",
          "type": "list",
          "optional": true,
          "fields": [
            {
              "name": "label",
              "label": "Label",
              "type": "text"
            },
            {
              "name": "url",
              "label": "URL",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "id": "communities",
      "label": "Communities",
      "singular": "Community",
      "fields": [
        {
          "name": "name",
          "label": "Name",
          "type": "text"
        },
        {
          "name": "blurb",
          "label": "Blurb",
          "type": "textarea",
          "optional": true,
          "hint": "Short summary of who this community is for."
        },
        {
          "name": "heroImage",
          "label": "Hero image",
          "type": "image",
          "optional": true,
          "hint": "Full-bleed header background. Blank falls back to the centered header."
        },
        {
          "name": "tagline",
          "label": "Tagline",
          "type": "text",
          "optional": true,
          "hint": "Subtitle beneath the \"HARVARD IN TECH <NAME>\" title."
        },
        {
          "name": "showGallery",
          "label": "Show event gallery",
          "type": "boolean",
          "optional": true,
          "hint": "Blank shows the gallery; switch off to hide it on this community."
        },
        {
          "name": "contactEmail",
          "label": "Contact email",
          "type": "text",
          "optional": true,
          "hint": "Blank falls back to the global contact email in Settings."
        },
        {
          "name": "order",
          "label": "Order",
          "type": "number",
          "optional": true,
          "hint": "Optional pin. Blank sorts the community alphabetically by name."
        },
        {
          "name": "leads",
          "label": "Community leads",
          "type": "list",
          "optional": true,
          "fields": [
            {
              "name": "name",
              "label": "Name",
              "type": "text"
            },
            {
              "name": "role",
              "label": "Role",
              "type": "text",
              "optional": true
            }
          ]
        },
        {
          "name": "links",
          "label": "Links",
          "type": "list",
          "optional": true,
          "fields": [
            {
              "name": "label",
              "label": "Label",
              "type": "text"
            },
            {
              "name": "url",
              "label": "URL",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "id": "sponsors",
      "label": "Sponsors",
      "singular": "Sponsor",
      "fields": [
        {
          "name": "name",
          "label": "Name",
          "type": "text"
        },
        {
          "name": "tier",
          "label": "Partnership level",
          "type": "text",
          "optional": true,
          "hint": "The level id from the Sponsorship page settings (presenting, chapter, event, community). Blank groups the sponsor under Other partners."
        },
        {
          "name": "logo",
          "label": "Logo",
          "type": "image",
          "optional": true,
          "hint": "Blank shows the sponsor's name as text instead."
        },
        {
          "name": "url",
          "label": "Website",
          "type": "text",
          "optional": true
        },
        {
          "name": "placeholder",
          "label": "Example entry",
          "type": "boolean",
          "optional": true,
          "hint": "Switch ON for an illustrative entry. The wall then shows an 'examples, not actual sponsors' notice. Leave OFF for a real sponsor."
        },
        {
          "name": "order",
          "label": "Order",
          "type": "number",
          "optional": true,
          "hint": "Optional pin. Blank sorts the sponsor alphabetically within its level."
        }
      ]
    },
    {
      "id": "projects",
      "label": "Projects",
      "singular": "Project",
      "fields": [
        {
          "name": "title",
          "label": "Title",
          "type": "text"
        },
        {
          "name": "blurb",
          "label": "Blurb",
          "type": "textarea",
          "optional": true
        },
        {
          "name": "image",
          "label": "Image",
          "type": "image",
          "optional": true
        },
        {
          "name": "applyUrl",
          "label": "Apply link",
          "type": "text",
          "optional": true
        },
        {
          "name": "commitment",
          "label": "Time commitment",
          "type": "text",
          "optional": true
        },
        {
          "name": "order",
          "label": "Order",
          "type": "number",
          "optional": true
        },
        {
          "name": "active",
          "label": "Open for applications",
          "type": "boolean",
          "optional": true
        }
      ]
    },
    {
      "id": "testimonials",
      "label": "Testimonials",
      "singular": "Testimonial",
      "fields": [
        {
          "name": "quote",
          "label": "Quote",
          "type": "textarea"
        },
        {
          "name": "name",
          "label": "Name",
          "type": "text"
        },
        {
          "name": "role",
          "label": "Role",
          "type": "text",
          "optional": true
        },
        {
          "name": "photo",
          "label": "Photo",
          "type": "image",
          "optional": true
        },
        {
          "name": "order",
          "label": "Order",
          "type": "number",
          "optional": true
        }
      ]
    }
  ],
  "builtins": {
    "pages": [
      {
        "name": "embedUrl",
        "label": "Embed URL",
        "type": "text",
        "optional": true
      },
      {
        "name": "embedHtml",
        "label": "Embed HTML",
        "type": "textarea",
        "optional": true
      }
    ],
    "blog": [
      {
        "name": "embedUrl",
        "label": "Embed URL",
        "type": "text",
        "optional": true
      },
      {
        "name": "embedHtml",
        "label": "Embed HTML",
        "type": "textarea",
        "optional": true
      }
    ],
    "events": [
      {
        "name": "chapter",
        "label": "Chapter or community",
        "type": "text",
        "optional": true,
        "hint": "The slug of the chapter or community this event belongs to (the filename without .md). Blank means it belongs to neither and shows only on the events page."
      }
    ],
    "team": [
      {
        "name": "active",
        "label": "Active",
        "type": "boolean",
        "optional": true
      }
    ]
  },
  "seo": [
    {
      "name": "metaTitle",
      "label": "SEO title",
      "type": "text",
      "optional": true,
      "group": "seo",
      "hint": "The <title> and share-card title. Falls back to the entry title."
    },
    {
      "name": "metaDescription",
      "label": "Meta description",
      "type": "textarea",
      "optional": true,
      "group": "seo",
      "hint": "The search + social description. Falls back to the summary, then the site default."
    },
    {
      "name": "ogImage",
      "label": "Share image",
      "type": "image",
      "optional": true,
      "group": "seo",
      "hint": "The social share card image. Falls back to the site default."
    }
  ]
}
