+// ─── Grouping the dashboard by where content appears ─────────────────────────
+//
+// A flat A-to-Z grid of collection cards answers "what collections exist", which
+// is a question an editor never has. Theirs is the reverse: "I am looking at
+// this page — which of these do I open to change it?" Nothing on the dashboard
+// connected a page to the collections that build it, so the only way through was
+// to already know that the homepage headline lives in "Homepage hero slides".
+//
+// The registry's `paths` map is exactly that missing link, so the grid groups by
+// it. Collections that share a page are shown together under that page's
+// address — the thing the editor can read off their own browser's URL bar.
+
+/** A dashboard section: the site page these collections build, and their cards. */
+export interface DashboardGroup {
+  /**
+   * The group's identity:
+   * - a site path (`/donate`) — every card here appears on that one page
+   * - `'own-page'` — each entry in these collections gets a page of its own
+   * - `'no-page'` — these configure the site without appearing as a page
+   */
+  key: string;
+  /** Heading shown above the group. */
+  label: string;
+  /** Sub-heading explaining what the grouping means, or `null` for none. */
+  hint: string | null;
+  cards: CollectionCard[];
+}
+
+/** Token marking a per-entry route in a `paths` template. */
+const SLUG_TOKEN = ':slug';
+
+const OWN_PAGE_KEY = 'own-page';
+const NO_PAGE_KEY = 'no-page';
+
+/**
+ * Which group a collection belongs in, from its declared placement.
+ * An `undefined` template (collection not declared) is treated as a page per
+ * entry, matching the legacy `/<collection>/<slug>` fallback in `publicUrl`.
+ */
+function groupKeyFor(template: string | null | undefined): string {
+  if (template === null) return NO_PAGE_KEY;
+  if (template === undefined) return OWN_PAGE_KEY;
+  const trimmed = template.trim();
+  if (trimmed === '') return NO_PAGE_KEY;
+  if (trimmed.includes(SLUG_TOKEN)) return OWN_PAGE_KEY;
+  // An anchor names a band WITHIN a page, not a page — `/#board` is the board
+  // section of the homepage. Grouping on the anchor would file the board apart
+  // from the rest of the homepage, which is exactly backwards for an editor
+  // looking at the homepage and wondering what builds it. The full path with the
+  // anchor is still what the card shows and what "View on site" links to.
+  const [path] = trimmed.split('#');
+  return path === '' ? '/' : path;
+}
+
+/** Sort key: shared pages first (homepage leading), then per-entry, then none. */
+function groupRank(key: string): [number, string] {
+  if (key === NO_PAGE_KEY) return [3, ''];
+  if (key === OWN_PAGE_KEY) return [2, ''];
+  // The homepage sorts ahead of the other shared pages — it is the page an
+  // editor is most often looking at, and '/' would otherwise sort arbitrarily.
+  return [key === '/' ? 0 : 1, key];
+}
+
+function labelFor(key: string): { label: string; hint: string | null } {
+  if (key === OWN_PAGE_KEY) {
+    return {
+      label: 'Each entry has its own page',
+      hint: 'Adding an entry here adds a page to the site.',
+    };
+  }
+  if (key === NO_PAGE_KEY) {
+    return {
+      label: 'Site-wide settings',
+      hint: 'These change every page at once rather than appearing on one.',
+    };
+  }
+  if (key === '/') return { label: 'Homepage', hint: 'Everything on the front page.' };
+  return { label: key, hint: `Everything on the ${key} page.` };
+}
+
+/**
+ * Group the dashboard's cards by the page they appear on.
+ *
+ * Cards keep the order they arrive in within a group, so the caller's ordering
+ * still decides what comes first inside a page. Groups are ordered homepage →
+ * other shared pages (by path) → per-entry collections → site-wide settings,
+ * which walks an editor from the most-looked-at page outward.
+ *
+ * Pure and framework-free so the dashboard page stays data wiring and this rule
+ * unit-tests with no DOM — the same split the rest of this module keeps.
+ */
+export function groupCardsByPage(
+  cards: readonly CollectionCard[],
+  paths: Readonly<Record<string, string | null>> = {},
+): DashboardGroup[] {
+  const byKey = new Map<string, CollectionCard[]>();
+  for (const card of cards) {
+    const key = groupKeyFor(paths[card.collection]);
+    const bucket = byKey.get(key);
+    if (bucket) bucket.push(card);
+    else byKey.set(key, [card]);
+  }
+
+  return [...byKey.entries()]
+    .sort(([a], [b]) => {
+      const [ra, sa] = groupRank(a);
+      const [rb, sb] = groupRank(b);
+      return ra - rb || sa.localeCompare(sb);
+    })
+    .map(([key, groupCards]) => ({ key, ...labelFor(key), cards: groupCards }));
+}
