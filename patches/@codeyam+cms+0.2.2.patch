+/**
+ * The manifest records a commit would ADD without carrying their image bytes.
+ *
+ * An upload stages two independent changes — the blob (`public/images/<name>`)
+ * and the manifest edit (`src/data/media.json`) — and nothing has ever bound
+ * them together. If the blob change is lost between staging and publishing, the
+ * manifest edit sails through on its own and the commit lands a record naming a
+ * file that does not exist, which the site then renders as a broken `<img>`.
+ * That is exactly what happened in `dd73c8c`: three records, one blob.
+ *
+ * The staged manifest change carries its own baseline — `original` is the
+ * committed `media.json` — so the set of ADDED records is derivable from the
+ * staging set alone, with no network call and no disk access. A record that was
+ * already committed is somebody else's problem (it has a file, or it is a
+ * pre-existing ghost); only records this commit introduces must prove they
+ * brought bytes.
+ *
+ * Pure and transport-free so it unit-tests directly, and returns the offending
+ * filenames rather than a boolean so the error can name them.
+ */
+export function unbackedManifestRecords(changes: readonly PendingChange[]): string[] {
+  const manifestChange = changes.find((c) => c.path === MEDIA_MANIFEST_PATH);
+  if (!manifestChange) return [];
+
+  const parseAssets = (raw: string): MediaAsset[] => {
+    try {
+      const parsed = JSON.parse(raw);
+      return Array.isArray(parsed?.assets) ? (parsed.assets as MediaAsset[]) : [];
+    } catch {
+      // An unparseable side can't be compared. Staging writes both sides via
+      // `serializeManifest`, so this is a corrupt-storage case, not a normal one.
+      return [];
+    }
+  };
+
+  const before = new Set(parseAssets(manifestChange.original).map((a) => a.filename));
+  const stagedBytes = new Set(
+    changes.filter((c) => c.encoding === 'base64').map((c) => c.path),
+  );
+
+  return parseAssets(manifestChange.updated)
+    .map((a) => a.filename)
+    .filter((filename) => !before.has(filename))
+    .filter((filename) => !stagedBytes.has(assetRepoPath(filename)));
+}
