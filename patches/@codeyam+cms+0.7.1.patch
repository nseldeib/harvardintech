+// Pure, framework-free logic for duplicating an entry.
+//
+// A sibling to `newEntry.ts`, and deliberately thin: Duplicate does NOT clone a
+// file. It navigates to the ordinary create form with the source entry's values
+// already filled in, so the editor renames the copy BEFORE anything exists. That
+// choice is what makes this module small — the collision check, the required-field
+// gate, and the staging path are all the create flow's, unchanged. All this
+// decides is what the form starts out holding.
+//
+// Node-free and DOM-free like its neighbours, so it unit-tests directly and runs
+// unchanged inside the browser island.
+
+import type { FrontmatterValue } from './frontmatter';
+
+/** The frontmatter key marking an entry as a preview clone. Never copied — see
+ *  {@link duplicateValues}. */
+const PREVIEW_MARKER = 'previewOf';
+
+/** The keys a duplicate must not inherit: they identify the SOURCE file's role as
+ *  a preview, not its content. Copying them would mint a second unlisted clone
+ *  pointing at the same target. */
+const NON_COPYABLE_KEYS = new Set([PREVIEW_MARKER, 'previewCreatedAt', 'previewLock']);
+
+/**
+ * A free slug derived from `slug`, never colliding with `existingSlugs`.
+ *
+ * Counts from 2 (`pillars` → `pillars-2` → `pillars-3`), because the source IS
+ * the first one — a `-1` suffix would imply the original was numbered too. It
+ * keeps counting past any taken slug rather than stopping at the first gap, so
+ * duplicating twice in a row cannot suggest the same name twice.
+ *
+ * Callers pass every slug the collection knows about INCLUDING those only staged,
+ * so a suggestion cannot collide with a duplicate the editor has created but not
+ * yet published. The create form re-checks the collision itself, so a stale list
+ * costs a corrected suggestion rather than a clobbered file.
+ *
+ * An already-numbered slug counts on from its own base (`pillars-2` → `pillars-3`)
+ * instead of growing a second suffix, so repeated duplication does not produce
+ * `pillars-2-2`.
+ */
+export function nextFreeSlug(slug: string, existingSlugs: readonly string[]): string {
+  const taken = new Set(existingSlugs);
+  const base = slug.replace(/-\d+$/, '') || slug;
+  for (let n = 2; ; n += 1) {
+    const candidate = `${base}-${n}`;
+    if (!taken.has(candidate)) return candidate;
+  }
+}
+
+/**
+ * The label a duplicate starts with: the source's, marked as a copy.
+ *
+ * The suffix is a PROMPT, not a final name — the whole point of opening the
+ * create form is that the editor renames it before the file exists. It exists so
+ * that an editor who duplicates and immediately saves still gets two rows they
+ * can tell apart, rather than two identically-named ones.
+ *
+ * A blank label stays blank: the create form's own missing-title gate is the
+ * right thing to meet there, not a row named "(copy)" with nothing in front.
+ */
+export function duplicateLabel(label: string): string {
+  const trimmed = label.trim();
+  return trimmed === '' ? '' : `${trimmed} (copy)`;
+}
+
+/**
+ * The frontmatter a duplicate starts from: every field of the source verbatim,
