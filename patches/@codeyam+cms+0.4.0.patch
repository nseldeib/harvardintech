--- /dev/null
+++ b/node_modules/@codeyam/cms/src/components/admin/DeployChip.tsx
@@ -0,0 +1,37 @@
+// The deploy status, shrunk to something that can live alongside editing.
+//
+// `DeployStatus` is the full account of a deploy and it takes over the screen to
+// give it. That is right for the moment you press Publish and wrong for every
+// moment after, because publishing is not supposed to interrupt the work — so
+// once the panel is dismissed, or once a navigation drops the page that was
+// showing it, the watch continues here instead: one line, no scrim, out of the
+// way, still tracking.
+//
+// Presentational + intent-forwarding, exactly like `DeployStatus`: the parent
+// owns the poll and passes the current stage down, so an isolated-component
+// scenario can capture any stage without a live repo.
+import { deployChipLabel, deployDotColor, type DeployState } from '../../lib/githubPages';
+import { deployChipStyle, deployDotStyle, chipBtnStyle } from './stagingStyles';
+
+interface Props {
+  state: DeployState;
+  /** Reopen the full deploy panel. */
+  onOpen?: () => void;
+  /** Stop showing the chip. Does not stop the deploy — nothing can. */
+  onDismiss?: () => void;
+}
+
+export default function DeployChip({ state, onOpen, onDismiss }: Props) {
+  return (
+    <div style={deployChipStyle}>
+      <span style={deployDotStyle(deployDotColor(state.stage))} aria-hidden="true" />
+      <span>{deployChipLabel(state.stage)}</span>
+      <button type="button" onClick={() => onOpen?.()} style={chipBtnStyle}>
+        Details
+      </button>
+      <button type="button" onClick={() => onDismiss?.()} style={chipBtnStyle} aria-label="Dismiss deploy status">
+        ✕
+      </button>
+    </div>
+  );
+}
