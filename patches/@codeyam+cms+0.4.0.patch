diff --git a/node_modules/@codeyam/cms/src/lib/deployWatch.ts b/node_modules/@codeyam/cms/src/lib/deployWatch.ts
new file mode 100644
index 0000000..1ec5b5f
--- /dev/null
+++ b/node_modules/@codeyam/cms/src/lib/deployWatch.ts
@@ -0,0 +1,92 @@
+// What an in-flight deploy IS, and the pure rules about it.
+//
+// The DOM-free half of the deploy watch, split from `deployWatchStore.ts` the
+// same way `publishedBaseline.ts` is split from `publishedBaselineStore.ts`:
+// everything here is a total function over plain values, so the expiry rule, the
+// identity rule and the record's construction all unit-test with no browser and
+// no clock. The `sessionStorage` half lives next door.
+
+import type { DeployBaseline, DeployStage } from './githubPages';
+
+/** How long a recorded watch stays re-attachable, matching `pollDeploy`'s default budget. */
+export const DEPLOY_WATCH_TTL_MS = 600000;
+
+/** A deploy this tab kicked off and has not yet seen resolve. */
+export interface InFlightDeploy {
+  /** Human URL of the commit being watched, for the "View commit" link. */
+  commitUrl: string;
+  /** Where the deployed site serves its marker. Empty when unverifiable. */
+  markerUrl: string;
+  /**
+   * The marker as it read before the commit. `null` disables verification —
+   * a meaningful value, not a missing one, so it is stored explicitly.
+   */
+  markerBaseline: DeployBaseline['markerBaseline'];
+  /** Epoch ms the publish happened, so the budget spans the whole deploy. */
+  startedAt: number;
+  /** The last stage observed, so a re-attached view has something to show
+   * before its first poll returns. */
+  stage: DeployStage;
+}
+
+/**
+ * Build the record for a deploy that just started.
+ *
+ * Both publish surfaces call this rather than assembling the object literal
+ * themselves. They previously each built their own copy, which is the shape of
+ * bug worth designing out: the record decides how the watch behaves, so two
+ * drifting copies would mean publishing from the Publish page and publishing
+ * from the staging bar producing subtly different watches.
+ */
+export function buildDeployRecord(commitUrl: string, baseline: DeployBaseline, now: number): InFlightDeploy {
+  return {
+    commitUrl,
+    markerUrl: baseline.markerUrl,
+    markerBaseline: baseline.markerBaseline,
+    startedAt: now,
+    stage: 'committed',
+  };
+}
+
+/**
+ * Identity of a deploy watch: which commit, and which attempt at watching it.
+ *
+ * The start time matters as much as the commit. "Check again" re-watches the
+ * SAME commit with a fresh budget, and that has to read as a new watch or the
+ * poll would never restart.
+ */
+export function deployWatchKey(record: InFlightDeploy): string {
+  return `${record.commitUrl}@${record.startedAt}`;
+}
+
+/**
+ * How much of the watch budget is left, given the current time. Never negative,
+ * so a caller can hand the result straight to a poll timeout.
+ */
+export function remainingWatchMs(record: InFlightDeploy, now: number, ttlMs = DEPLOY_WATCH_TTL_MS): number {
+  return Math.max(0, record.startedAt + ttlMs - now);
+}
+
+/**
+ * Is this record too old to keep watching?
+ *
+ * An expired record is not re-attached, because resuming a watch with no budget
+ * left would report `unconfirmed` instantly and read as a fresh failure of a
+ * deploy that finished long ago. A stale record is simply forgotten.
+ */
+export function isWatchExpired(record: InFlightDeploy, now: number, ttlMs = DEPLOY_WATCH_TTL_MS): boolean {
+  return remainingWatchMs(record, now, ttlMs) <= 0;
+}
+
+/**
+ * Is this a record we can actually resume, or corrupt/foreign JSON?
+ *
+ * Storage is a string keyed by a name anything on the origin can write, so a
+ * half-written or hand-edited value must not resurrect as a broken watch that
+ * polls a garbage URL forever.
+ */
+export function isDeployRecord(value: unknown): value is InFlightDeploy {
+  if (!value || typeof value !== 'object') return false;
+  const record = value as Partial<InFlightDeploy>;
+  return typeof record.commitUrl === 'string' && typeof record.startedAt === 'number';
+}
diff --git a/node_modules/@codeyam/cms/src/lib/deployWatchStore.ts b/node_modules/@codeyam/cms/src/lib/deployWatchStore.ts
new file mode 100644
index 0000000..fdbf09a
--- /dev/null
+++ b/node_modules/@codeyam/cms/src/lib/deployWatchStore.ts
@@ -0,0 +1,129 @@
+// Per-TAB persistence for a deploy that is still in flight.
+//
+// The problem this exists for: publishing is meant to be non-blocking — the
+// editor commits and goes straight back to editing — but "back to editing"
+// means opening another entry, and every admin page is a full document load
+// (these are static Astro pages, not an SPA). The React island watching the
+// deploy dies with the old document, so without this the status simply vanishes
+// mid-deploy and the editor never learns whether her change went live. The
+// alternative — pinning her to the page until the deploy resolves — is the
+// lockout this whole feature removes.
+//
+// So the watch is recorded here at publish time and re-attached by whichever
+// StagingBar mounts next. What is stored is only what a poll cannot re-derive
+// after a reload: the commit being watched, where to look for the site's marker,
+// what that marker read BEFORE the commit (unsamplable after the fact — see
+// `readDeployBaseline`), and when the watch started, so the budget continues
+// rather than restarting on every navigation.
+//
+// Deliberately `sessionStorage`, matching `publishedBaselineStore.ts` and for
+// the same reason: the record describes what THIS tab published. A second tab
+// re-attaching to a deploy it did not start would narrate someone else's publish
+// as its own. `localStorage` is reserved for things that SHOULD cross tabs —
+// the staging set and the GitHub token.
+//
+// Shape and guards mirror `publishedBaselineStore.ts`: quiet on SSR, quiet on
+// corrupt JSON, and never throwing into a publish path.
+//
+// The record's SHAPE and the pure rules about it (expiry, identity,
+// construction) live in `deployWatch.ts` — the same pure/storage split this
+// package draws between `publishedBaseline.ts` and `publishedBaselineStore.ts`.
+
+import type { DeployStage } from './githubPages';
+import { isDeployRecord, isWatchExpired, type InFlightDeploy } from './deployWatch';
+
+const STORAGE_KEY = 'codeyam-cms:deploy-watch';
+
+function hasStorage(): boolean {
+  return typeof window !== 'undefined' && typeof window.sessionStorage !== 'undefined';
+}
+
+// Both publish surfaces write here — the floating StagingBar and the /admin/publish
+// island — but only ONE of them should render the resulting status, because on
+// /admin/publish both are mounted at once and two deploy panels for one deploy is
+// nonsense. So this store is the single source of truth for "a deploy is in
+// flight" and the bar (mounted in AdminLayout, present on every admin page) is
+// the single renderer. Publishing from the Publish page therefore does not draw
+// its own status: it records the watch, and the bar picks it up.
+//
+// Same shape as `pendingChangesStore.subscribe` deliberately — one store-plus-
+// subscribe idiom to learn, not two.
+type Listener = () => void;
+const listeners = new Set<Listener>();
+
+function emit(): void {
+  for (const listener of listeners) listener();
+}
+
+/** Observe changes to the in-flight deploy. Returns an unsubscribe function. */
+export function subscribe(listener: Listener): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+/** This tab's in-flight deploy, or `null` when there is none, it expired, or storage is unavailable. */
+export function loadDeployWatch(now: number = Date.now()): InFlightDeploy | null {
+  if (!hasStorage()) return null;
+  try {
+    const raw = window.sessionStorage.getItem(STORAGE_KEY);
+    if (!raw) return null;
+    const parsed: unknown = JSON.parse(raw);
+    // A hand-edited or half-written record must not resurrect as a broken watch.
+    if (!isDeployRecord(parsed)) return null;
+    if (isWatchExpired(parsed, now)) {
+      clearDeployWatch();
+      return null;
+    }
+    return parsed;
+  } catch {
+    return null;
+  }
+}
+
+/** Record a deploy to watch. Replaces any prior record — the newest publish is
+ * the one worth following, and its commit supersedes the older one anyway. */
+export function saveDeployWatch(record: InFlightDeploy): void {
+  if (!hasStorage()) return;
+  try {
+    window.sessionStorage.setItem(STORAGE_KEY, JSON.stringify(record));
+  } catch {
+    // A full or blocked sessionStorage costs the re-attach, nothing more: the
+    // commit already landed and the deploy proceeds regardless. Taking the
+    // publish down over a storage quota would be the far worse trade.
+  }
+  // Emitted even when the write failed: an in-memory subscriber can still follow
+  // the deploy for as long as this page lives, which is strictly better than
+  // showing nothing because storage was full.
+  emit();
+}
+
+/**
+ * Update the recorded stage in place, so a navigation mid-deploy re-attaches
+ * showing where the deploy actually got to rather than restarting at `committed`.
+ *
+ * Writes WITHOUT notifying: the renderer already has this stage — it is what
+ * just called here — and re-entering it would loop.
+ */
+export function recordWatchStage(stage: DeployStage): void {
+  if (!hasStorage()) return;
+  const current = loadDeployWatch();
+  if (!current || current.stage === stage) return;
+  try {
+    window.sessionStorage.setItem(STORAGE_KEY, JSON.stringify({ ...current, stage }));
+  } catch {
+    // Same rationale as `saveDeployWatch`.
+  }
+}
+
+/** Forget the in-flight deploy — it resolved, or the editor dismissed it. */
+export function clearDeployWatch(): void {
+  if (!hasStorage()) return;
+  try {
+    window.sessionStorage.removeItem(STORAGE_KEY);
+  } catch {
+    // Same rationale as `saveDeployWatch`: never throw out of a publish path.
+  }
+  emit();
+}
