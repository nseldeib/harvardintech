+
+/** A collection is ordered when its resolved fields declare a numeric `order`.
+ *
+ * Capability, not identity: any collection that models a sequence gets the
+ * arrows, and one that does not is untouched. Naming collections here instead
+ * would make every future ordered collection ask for this again. */
+export function hasOrderField(fields: ReadonlyArray<{ name: string; type: string }>): boolean {
+  return fields.some((f) => f.name === 'order' && f.type === 'number');
+}
+
+/** An entry's `order` as a number, or `undefined` when absent or unparseable.
+ *
+ * Frontmatter is hand-editable, so `order` can arrive as a number, as a string
+ * that looks like one, or as junk. Junk reads as "unnumbered" rather than `NaN`,
+ * which would poison every comparison it touched. */
+export function entryOrder(raw: string): number | undefined {
+  const { data } = parseEntry(raw);
+  const value = data.order;
+  if (typeof value === 'number') return Number.isFinite(value) ? value : undefined;
+  if (typeof value === 'string' && value.trim() !== '') {
+    const parsed = Number(value);
+    return Number.isFinite(parsed) ? parsed : undefined;
+  }
+  return undefined;
+}
+
+/** Sort entries the way the SITE renders them: `order` ascending, unnumbered
+ * last, label as the tiebreak.
+ *
+ * The first two rules are the consumer's own rule (`byOrder` in a site's
+ * `lib/order.ts`) restated here so the admin list and the page agree about what
+ * "first" means — an admin that disagreed with the page about its own order
+ * would be worse than no arrows at all. The label tiebreak is what makes a
+ * collection nobody has numbered yet sort exactly as the list does today, so
+ * turning this on never scrambles an existing list. */
+export function sortByEntryOrder<T extends EntryListItem>(items: readonly T[]): T[] {
+  return [...items].sort((a, b) => {
+    const av = entryOrder(a.raw) ?? Number.MAX_SAFE_INTEGER;
+    const bv = entryOrder(b.raw) ?? Number.MAX_SAFE_INTEGER;
