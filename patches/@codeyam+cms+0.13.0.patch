@@ -0,0 +1,72 @@
+// The ↑ / ↓ pair that moves one row of an ordered collection.
+//
+// Deliberately NOT `RowControls`, which is the ↑ / ↓ / ✕ cluster the nav and
+// social-link editors use: that component always renders its remove button, and
+// an entry row already has its own Archive / Delete actions with an inline
+// confirm step. Bending `RowControls` to an optional remove would have made a
+// shared component conditional to serve one caller; this reuses the styling it
+// reuses (`iconBtnStyle`) and stays two buttons that do one thing.
+//
+// Purely presentational — it reports intent and renders the disabled state it is
+// told about. The sequence, and what a move implies for the underlying files,
+// belong to `entryList`'s pure helpers, which keeps every ordering rule in one
+// unit-testable place rather than half of it living in a click handler.
+import type { CSSProperties } from 'react';
+import { iconBtnStyle } from './configEditorStyles';
+
+const groupStyle: CSSProperties = {
+  display: 'inline-flex',
+  gap: '0.25rem',
+};
+
+/** A disabled arrow stays VISIBLE rather than being dropped from the row.
+ * Removing it would shift the remaining button under the reader's cursor
+ * exactly when they are clicking down a list, and the top and bottom rows would
+ * lay out differently from every other row for no reason they could see. */
+function arrowStyle(disabled: boolean): CSSProperties {
+  return {
+    ...iconBtnStyle,
+    cursor: disabled ? 'default' : 'pointer',
+    opacity: disabled ? 0.35 : 1,
+  };
+}
+
+interface Props {
+  /** False on the first row — nothing to move up into. */
+  canUp: boolean;
+  /** False on the last row. */
+  canDown: boolean;
+  onUp: () => void;
+  onDown: () => void;
+  /** Names the row in the button's accessible label, so a screen reader hears
+   * "Move Why Support Harvard in Tech? up" rather than six identical "Move up"
+   * buttons with no way to tell which row each belongs to. */
+  label: string;
+}
+
+export default function OrderArrows({ canUp, canDown, onUp, onDown, label }: Props) {
+  return (
+    <div style={groupStyle}>
+      <button
+        type="button"
+        onClick={onUp}
+        disabled={!canUp}
+        aria-label={`Move ${label} up`}
+        title="Move up"
+        style={arrowStyle(!canUp)}
+      >
+        ↑
+      </button>
+      <button
+        type="button"
+        onClick={onDown}
+        disabled={!canDown}
+        aria-label={`Move ${label} down`}
+        title="Move down"
+        style={arrowStyle(!canDown)}
+      >
+        ↓
+      </button>
+    </div>
+  );
+}
